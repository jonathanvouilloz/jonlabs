---
// Coquille v2 des pages hors home : police titres, Nav, Dock, Footer et comportements (v2-ui).
import Layout from './Layout.astro';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import Footer from '../components/v2/Footer.astro';
import '../styles/v2.css';

type Props = Parameters<typeof Layout>[0] & { current?: string };
const { current, ...layout } = Astro.props;
---

<Layout {...layout}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current={current} />
    <Dock current={current} />
    <main><slot /></main>
    <Footer />
  </div>
</Layout>

<script>
  import '../scripts/v2-ui';
</script>

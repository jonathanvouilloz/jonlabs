---
// Page À propos — Jon Labs (v2, direction « minimal » : une colonne de lecture, un seul portrait)
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import Footer from '../components/v2/Footer.astro';
import imgJonathan from '../assets/jonathan-vouilloz.webp';
import '../styles/v2.css';

import { personData, SITE_URL } from '../data/schema';
import { getAboutPageSchema, getBreadcrumbSchema } from '../lib/seo';

const pageTitle = "Jonathan Vouilloz : systèmes IA sur mesure, Genève";
const pageDescription = "Je construis des systèmes IA pour des entreprises qui n'ont pas d'équipe tech. Mon parcours, de l'ESIG et la HEG à Jon Labs, à Genève.";

const schemas = [
  getAboutPageSchema({ url: `${SITE_URL}/about`, name: pageTitle, description: pageDescription }),
  getBreadcrumbSchema([
    { name: "Accueil", url: SITE_URL },
    { name: "À propos", url: `${SITE_URL}/about` }
  ]),
];

const timeline = [
  { year: '2025', label: 'Lancement de Jon Labs' },
  { year: '2021', label: 'Co-fondateur Kusari Sàrl' },
  { year: '2020', label: 'Freelance Barber Concept' },
  { year: '2017', label: 'Bachelor HES, HEG Genève' },
  { year: '2015', label: 'CFC Informaticien de gestion, ESIG' },
];
---

<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </Fragment>

  <div class="v2">
    <Nav current="/about" />
    <Dock current="/about" />

    <main>
      <header class="r"><div class="w ab-m-col ab-m-hero">
        <div><Image src={imgJonathan} alt="Jonathan Vouilloz" width={160} height={200} quality={85} loading="eager" class="ab-m-face" /></div>
        <h1 class="v2-h1" data-words>Jonathan Vouilloz.<br /><span class="v2-dim">Systèmes IA sur mesure, Genève.</span></h1>
      </div></header>

      <section class="r"><div class="w ab-m-col">
        <p class="v2-reveal" data-reveal>
          Je construis des systèmes IA pour des entreprises qui n'ont pas d'équipe tech. Je préfère un outil simple
          qui tourne tous les jours à une démo impressionnante qui casse.
        </p>
      </div></section>

      <section class="r"><div class="w ab-m-col ab-m-text" data-rise>
        <p class="ab-m-lead">Je ne savais pas vraiment ce que je voulais faire. Honnêtement, c'est ce qui m'a le mieux servi.</p>
        <p>L'ESIG, puis la HEG, par curiosité plus que par plan : comprendre comment fonctionnent les systèmes, les entreprises, les gens.
          Juste après, une startup avec des amis : GetTime, un outil de prise de rendez-vous, puis un pivot vers le Web3 en 2021.</p>
        <p>J'y ai appris que l'argent ne m'a jamais vraiment motivé. Ce qui me fait lever le matin, c'est ce qu'on peut construire.</p>
        <p class="ab-m-lead">Deux choses me font avancer : faire ce que j'aime vraiment, et voir que ça sert à quelqu'un.</p>
      </div></section>

      <section class="r" aria-labelledby="parcours"><div class="w ab-m-col ab-m-path">
        <h2 class="v2-meta ab-m-h2" id="parcours">Mon parcours</h2>
        <ol class="ab-m-tl" data-rise>
          {timeline.map((t) => <li><span class="v2-meta">{t.year}</span>{t.label}</li>)}
        </ol>
        <p class="ab-m-links">
          <a href="/cv"><span>Voir le CV complet</span> <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
          <a href="/portfolio"><span>Voir mes réalisations</span> <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
        </p>
      </div></section>

      <section class="r"><div class="w ab-m-col ab-m-end">
        <p class="v2-h2" data-words>Un projet en tête&nbsp;?<br /><span class="v2-dim">On part de là.</span></p>
        <div><a href="/contact" class="v2-btn"><span data-roll>Parlons-en</span> <i class="ri-arrow-right-line"></i></a></div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .v2 .ab-m-col { padding: clamp(64px, 11vw, 140px) var(--pad); max-width: 1180px; }
  .v2 .ab-m-col > * { width: min(100%, 680px); margin-inline: auto; }
  .v2 .ab-m-hero { display: grid; gap: 40px; }
  .v2 .ab-m-hero .ab-m-face { width: 88px; height: 110px; object-fit: cover; border-radius: var(--r); display: block; }
  .v2 .ab-m-text { display: grid; gap: 28px; font-size: 1.1rem; line-height: 1.7; color: var(--mut); }
  .v2 .ab-m-text .ab-m-lead { font-family: var(--display); color: var(--ink); font-size: clamp(1.3rem, 2.2vw, 1.6rem); line-height: 1.25; letter-spacing: -0.03em; }
  .v2 .ab-m-path { display: grid; gap: 28px; }
  .v2 .ab-m-h2 { margin: 0; font-weight: 400; color: var(--ink); }
  .v2 .ab-m-tl { list-style: none; padding: 0; display: grid; }
  .v2 .ab-m-tl li { display: grid; grid-template-columns: 72px 1fr; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
  .v2 .ab-m-tl li:first-child { border-top: 1px solid var(--line); }
  .v2 .ab-m-links { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .v2 .ab-m-links a { display: inline-flex; align-items: center; gap: 6px; color: var(--mut); }
  .v2 .ab-m-links span { text-decoration: underline; text-underline-offset: 4px; }
  .v2 .ab-m-links a:hover { color: var(--ink); }
  .v2 .ab-m-end { display: grid; gap: 32px; }
</style>

<script>
  import '../scripts/v2-ui';
</script>

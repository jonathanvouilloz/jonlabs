---
// Formation IA pour équipes (v2, gabarit ServicePage). Prix : src/data/pricing.ts (sur devis).
import ServicePage from '../../components/v2/ServicePage.astro';
import { SITE_URL, localBusinessData } from '../../data/schema';
import { getServiceItemSchema, getBreadcrumbSchema, getFAQPageSchema, getWebPageSchema } from '../../lib/seo';
import { pricing } from '../../data/pricing';

const seoData = {
    title: "Formation IA pour équipes en Suisse romande",
    description: "Formation IA pour les équipes de PME romandes : usages concrets, outils, règles nLPD. À Genève ou à distance, sur devis."
};

const faqs = [
    { question: "Combien ça coûte ?", answer: "C'est sur devis, pour une équipe comme pour un particulier. Le prix dépend du nombre de personnes, de la durée et du format. Premier échange gratuit." },
    { question: "Vous formez aussi les particuliers ?", answer: "Oui. Même approche : on part de ce que vous faites au quotidien, et vous repartez avec des usages concrets." },
    { question: "En présentiel ou à distance ?", answer: "Les deux : dans vos locaux à Genève et en Suisse romande, ou en visio." },
    { question: "Combien de temps dure une formation ?", answer: "D'une demi-journée découverte à un programme de deux jours. On cale la durée selon vos objectifs." },
    { question: "Mon équipe n'y connaît rien, c'est un problème ?", answer: "Pas du tout. Aucun niveau technique n'est requis : on part de zéro, sur vos cas concrets." },
    { question: "Et après la formation ?", answer: "Vous gardez un guide interne (bons usages, règles nLPD), et je reste disponible pour vos questions." }
];

const schemas: any[] = [
    getServiceItemSchema("formation-ia-equipe"),
    getWebPageSchema({ url: `${SITE_URL}/services/formation-ia-equipe`, name: seoData.title, description: seoData.description }),
    getBreadcrumbSchema([
        { name: "Accueil", url: SITE_URL },
        { name: "Services", url: `${SITE_URL}/services` },
        { name: "Formation IA équipe", url: `${SITE_URL}/services/formation-ia-equipe` }
    ]),
    getFAQPageSchema(faqs),
    localBusinessData,
].filter(Boolean);

const cta = { href: "/contact", label: "Discuter d'une formation" };
---

<ServicePage
    title={seoData.title}
    description={seoData.description}
    schemas={schemas}
    head={{
        kicker: "Formation IA · présentiel à Genève, distanciel en Suisse romande",
        h1: "Formation IA",
        dim: "pour vos équipes.",
        lead: "Utiliser l'IA au quotidien, sur vos vrais outils, sans risque pour vos données. Pour une équipe ou en individuel.",
        cta,
        cta2: { href: "#programme", label: "Voir le programme" },
    }}
    sections={[
        {
            id: "problemes", kicker: "01 · Problèmes", title: "Ça vous", dim: "parle ?",
            text: "Le problème n'est pas l'IA, c'est l'absence de mode d'emploi. Et ça, ça se forme.",
            subs: [
                { title: "« On paie des outils IA que personne n'utilise »", text: "Deux ou trois curieux testent, le reste de l'équipe n'y touche pas." },
                { title: "« Mon équipe se méfie de l'IA »", text: "Peur de mal faire ou d'être remplacé : la curiosité reste bloquée." },
                { title: "« Chacun bricole dans son coin »", text: "Des données clients collées dans ChatGPT, sans aucun contrôle." },
                { title: "« On n'a pas de règles »", text: "Personne ne sait ce qu'on a le droit de mettre dans une IA." },
            ],
        },
        {
            id: "resultats", kicker: "02 · Résultats", title: "Ce que votre équipe", dim: "obtient.",
            text: "<strong>Exemple concret : une PME de 12 personnes qui payait dans le vide.</strong> Avant : ChatGPT, Copilot et deux autres abonnements, utilisés par deux ou trois curieux. Maintenant : chaque pôle a 2-3 usages ancrés (comptes rendus, réponses clients, offres) et des règles claires. Plusieurs heures récupérées chaque semaine, et des abonnements enfin utiles.",
            subs: [
                { title: "L'IA au quotidien", text: "Un réflexe de travail, plus un gadget testé une fois." },
                { title: "Du temps gagné", text: "Comptes rendus, réponses clients, rédaction : des heures récupérées chaque semaine." },
                { title: "Des usages sûrs", text: "Chacun sait ce qu'il peut mettre dans une IA, ou pas." },
                { title: "Un guide interne", text: "Les bons usages et les règles maison, dans un document que vous gardez." },
                { title: "Plus de peur", text: "Toute l'équipe s'approprie l'outil." },
                { title: "Des abonnements rentabilisés", text: "Les licences que vous payez servent enfin." },
            ],
        },
        {
            id: "formats", kicker: "03 · Formats", title: "Des formats adaptés", dim: "à votre équipe.",
            text: "On cale le format selon vos objectifs.",
            subs: [
                { title: "Présentiel à Genève", text: "Dans vos locaux, avec toute l'équipe autour de la table." },
                { title: "À distance", text: "Même approche pratique, en visio, partout en Suisse romande." },
                { title: "Atelier découverte (½ journée)", text: "Pour lever les blocages et montrer 3-4 usages concrets." },
                { title: "Programme sur 1 à 2 jours", text: "Pour ancrer les usages par pôle, avec le guide interne." },
            ],
        },
        {
            id: "difference", kicker: "04 · Approche", title: "Ce qui change", dim: "avec Jon Labs.",
            subs: [
                { title: "Sur vos cas", text: "Des usages concrets, pas de la théorie." },
                { title: "Données protégées", text: "Le cadre nLPD fait partie de la formation." },
                { title: "Un formateur qui construit", text: "Je déploie aussi des agents IA chez mes clients.", link: { href: "/hermes", label: "L'agent IA Hermès que je déploie" } },
            ],
        },
        {
            id: "local", kicker: "05 · Local", title: "Un formateur IA", dim: "basé à Genève.",
            text: "Sur place ou à distance, dans toute la Suisse romande.",
            subs: [
                { title: "Pourquoi un formateur local ?", text: "Je connais les outils des PME romandes et la nLPD. Je viens dans vos locaux, et je reste joignable après la formation." },
                { title: "Zones couvertes", features: ["Genève (présentiel)", "Vaud", "Valais", "Neuchâtel", "Fribourg", "Toute la Suisse romande (distanciel)"], text: "Les échanges se font en personne ou en visio selon vos préférences." },
            ],
        },
        {
            id: "prix", kicker: "06 · Tarifs", title: "Combien ça", dim: "coûte ?",
            text: "Un devis clair, adapté à votre équipe ou à vous seul. Premier échange gratuit et sans engagement.",
            price: { value: pricing.formationIA.display, note: "Entreprise ou particulier, selon le nombre de personnes, la durée et le format." },
            cta: { href: "/contact", label: "Demander un devis" },
            subs: [
                { title: "Ce qui influence le prix", features: ["La taille de votre équipe", "La durée (½ journée à 2 jours)", "Le format (présentiel ou distanciel)", "Le niveau de personnalisation des cas"] },
                { title: "Ce qui est toujours inclus", features: ["Audit préalable des usages", "Atelier pratique sur vos cas", "Garde-fous & cadre nLPD", "Guide interne remis à l'équipe", "Suivi post-formation"] },
                { title: "Deux durées", features: ["½ journée : atelier découverte", "1 à 2 jours : formation complète"] },
            ],
        },
    ]}
    method={{
        id: "programme",
        title: "Comment se passe", dim: "la formation ?",
        text: "Objectif : utiliser l'IA seul, sans risque.",
        steps: [
            { title: "Votre quotidien", text: "Je repère les tâches où l'IA vous fait vraiment gagner du temps.", meta: "1-2 h en amont" },
            { title: "Atelier sur vos cas", text: "Pas de slides génériques : on travaille sur vos vrais outils et dossiers.", meta: "½ journée à 2 jours" },
            { title: "Les règles du jeu", text: "Ce qu'on met dans une IA, et ce qu'on n'y met jamais (nLPD).", meta: "Inclus dans l'atelier" },
            { title: "Un guide pour la suite", text: "Vous gardez un guide interne, et je reste disponible pour vos questions.", meta: "Après la session" },
        ],
    }}
    links={[{
        title: "Pas encore prêt ?",
        text: "Découvrez tout l'accompagnement IA, ou comment automatiser vos tâches répétitives.",
        items: [
            { href: "/consultant-ia", k: "Systèmes IA", label: "Consultant IA à Genève", text: "Agents IA, automatisations et intégration à vos outils, pour les PME romandes." },
            { href: "/consultant-ia#automatisation", k: "Automatisation", label: "Automatiser vos tâches répétitives", text: "Relances, rapports, saisies : ce qu'on automatise le plus souvent." },
            { href: "/hermes", k: "Offre", label: "L'agent IA Hermès", text: "Un agent déjà éprouvé, branché sur vos outils, avec validation humaine." },
            { href: "/blog/adoption-ia-equipe-change-management", k: "Article", label: "Faire adopter l'IA à votre équipe sans résistance" },
            { href: "/blog/ia-nlpd-conformite-suisse", k: "Article", label: "IA et nLPD : les règles à connaître en Suisse" },
            { href: "/blog/garde-fous-ia-validations-audit", k: "Article", label: "Garde-fous IA : validations, escalades et audit" },
            { href: "/blog/ia-pragmatique-pme-suisse", k: "Article", label: "IA pour PME : 5 usages concrets au quotidien" },
        ],
    }]}
    faq={{ title: "Questions sur la formation IA pour équipes.", items: faqs }}
    contact="Premier échange gratuit. On regarde ensemble où en est votre équipe. Si une formation fait sens, je vous propose un format et un devis clairs. Sinon, je vous le dis honnêtement."
/>

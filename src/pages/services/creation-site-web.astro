---
// Création de site web — pilier web unique (v2, gabarit ServicePage).
// Absorbe /services/refonte-site-web et /services/developpeur-webflow (301, arbitrage Q1 du 17.11) :
// la refonte et Webflow deviennent des sous-offres (#refonte, #webflow). Prix : src/data/pricing.ts.
import ServicePage from '../../components/v2/ServicePage.astro';
import { serviceSchemas, SITE_URL, localBusinessData } from '../../data/schema';
import { getBreadcrumbSchema, getFAQPageSchema, getWebPageSchema } from '../../lib/seo';
import { pricing, terms, chf } from '../../data/pricing';
import { proofLecureux } from '../../data/proof-lecureux';

const seoData = {
    title: "Création de site web à Genève, freelance",
    description: "Création de site web à Genève : site sur mesure ou Webflow en 3 à 4 semaines, rapide et visible sur Google. Devis gratuit."
};

const faqs = [
    { question: "Combien coûte un site ?", answer: `Un site vitrine démarre à CHF ${chf(pricing.siteWeb.from)}, un site Webflow à CHF ${chf(pricing.webflow.from)}. Après un appel découverte gratuit, vous recevez un devis selon le nombre de pages et les fonctionnalités. Paiement : ${terms.payment}.` },
    { question: "Combien de temps pour avoir mon site ?", answer: "3 à 4 semaines pour un site vitrine. Une urgence ? On peut accélérer, on en parle au premier échange." },
    { question: "Qu'est-ce que je dois fournir ?", answer: "Vos textes (même bruts), vos photos et votre logo si vous en avez un. S'il manque quelque chose, je vous guide." },
    { question: "Je n'y connais rien en technique, c'est un problème ?", answer: "Pas du tout, c'est le cas de la plupart de mes clients. Je m'occupe de la technique et je vous explique tout simplement." },
    { question: "Et si j'ai besoin de modifications après ?", answer: "Les petites modifications, vous les faites vous-même. Pour une évolution plus importante, je vous fais un devis." },
    { question: "Serai-je visible sur Google tout de suite ?", answer: "Le site est optimisé dès le premier jour, mais Google prend quelques semaines à quelques mois pour le positionner." },
    { question: "Reprenez-vous des sites existants ?", answer: "Oui, c'est une demande fréquente : un site monté par un prestataire parti ou construit en interne, qui plafonne. Je commence par un audit de l'existant (structure, performance, SEO), puis je vous propose un plan de refonte clair avec un budget ferme. Une migration depuis WordPress est possible." },
    { question: "Webflow ou WordPress : que choisir en 2026 ?", answer: "Webflow si vous voulez un site visuel, rapide, hébergé et sécurisé sans plugins à maintenir. WordPress si vous avez besoin d'un blog très actif, de plugins métier spécifiques ou d'un budget plus serré au départ. Je vous oriente selon votre projet, pas selon mes préférences." },
    { question: "Webflow peut-il gérer un e-commerce ?", answer: "Oui, pour une boutique simple : moins de 100 produits, paiement Stripe, marché suisse. Au-delà (variantes complexes, multi-devises, TWINT, logistique avancée), Webflow Ecommerce montre ses limites. Dans ce cas je vous propose une solution sur mesure plutôt que de forcer l'outil." },
];

const schemas: any[] = [
    serviceSchemas["creation-site-web"],
    getWebPageSchema({ url: `${SITE_URL}/services/creation-site-web`, name: seoData.title, description: seoData.description }),
    getBreadcrumbSchema([
        { name: "Accueil", url: SITE_URL },
        { name: "Services", url: `${SITE_URL}/services` },
        { name: "Création de site web", url: `${SITE_URL}/services/creation-site-web` }
    ]),
    localBusinessData,
    getFAQPageSchema(faqs),
];

const cta = { href: "/contact", label: "Discuter de mon projet" };
---

<ServicePage
    title={seoData.title}
    description={seoData.description}
    schemas={schemas}
    head={{
        kicker: "Sites web · basé à Genève, service en Suisse romande",
        h1: "Création de site web",
        dim: "à Genève.",
        lead: `Un site simple et efficace qui vous ramène des clients. En ligne en 3-4 semaines, ${pricing.siteWeb.display.replace('Dès', 'dès')}.`,
        cta,
        cta2: { href: "#methode", label: "Voir comment ça marche" },
    }}
    proofs={{ slugs: ["physio-pommier", "ugo-mighali-coutelier", "barber-concept", "swiss-dental-care"] }}
    sections={[
        {
            id: "problemes", kicker: "01 · Problèmes", title: "Vous vous", dim: "reconnaissez ?",
            text: "La bonne nouvelle : un site pro ne demande ni des mois, ni un gros budget.",
            subs: [
                { title: "Invisible sur Google", text: "Quand on cherche votre métier à Genève, ce sont vos concurrents qui sortent." },
                { title: "Tout passe par le bouche-à-oreille", text: "Ça marche, mais c'est limité. Vous voulez aussi être trouvé par des inconnus." },
                { title: "Une image qui ne vous ressemble pas", text: "Une page Facebook ou LinkedIn ne montre pas le sérieux de votre travail." },
                { title: "Trop compliqué à faire seul", text: "Vous avez essayé Wix ou WordPress, puis abandonné. Vous voulez juste un site qui marche." },
                { title: "Un site existant qui vous freine", text: "Lent sur mobile, impossible à modifier sans votre prestataire, invisible sur Google : votre site actuel vous coûte plus qu'il ne vous rapporte." },
            ],
        },
        {
            id: "offres", kicker: "02 · Les offres", title: "Un site neuf, une refonte", dim: "ou Webflow.",
            text: "Le bon outil selon votre projet : un site statique sur mesure, très rapide, ou un site Webflow que vous gérez vous-même.",
            price: { value: pricing.siteWeb.display, note: `Site Webflow : ${pricing.webflow.display.replace('Dès', 'dès')}. Devis ferme avant de commencer.` },
            cta: { href: "/contact", label: "Demander un devis" },
            subs: [
                { id: "site-vitrine", meta: `Le plus demandé · ${pricing.siteWeb.display}`, title: "Site vitrine sur mesure", text: "Indépendants, artisans et PME qui veulent un site pro, simple et efficace.", features: ["Design sur mesure, adapté au mobile", "Optimisé pour Google", "Formulaire de contact", "Blog ou pages en plus si besoin", "Devis ferme après un premier appel"] },
                { id: "refonte", meta: "Refonte · sur devis", title: "Refonte de site existant", text: "Votre site plafonne : structure brouillonne, pages lentes, SEO inexistant. Je reprends l'existant, je garde ce qui marche, je restructure et je remets les performances à niveau.", features: ["Audit complet de l'existant", "Design adapté au mobile", "Optimisation SEO technique", "Formation à la modification des contenus"] },
                { id: "webflow", meta: `Option Webflow · ${pricing.webflow.display}`, title: "Site Webflow, géré par vous", text: "Un site Webflow sur mesure, construit depuis vos maquettes Figma ou de zéro. Structure de classes propre, CMS configuré pour que vous publiiez vous-même. Je vous forme à l'éditeur à la livraison : textes, images, articles, produits. S'y ajoute l'abonnement Webflow, qui remplace l'hébergement.", features: ["Pages sur mesure, adaptées au mobile", "Optimisé pour Google", "CMS (blog, portfolio) si besoin", "Formation à l'éditeur Webflow"] },
                { id: "e-commerce", meta: "Sur devis", title: "E-commerce & sur mesure", text: "Commerçants et entreprises avec des besoins spécifiques. Webflow suffit pour une boutique simple ; au-delà, je propose une <a href=\"/services/application-sur-mesure\">application sur mesure</a>.", features: ["Boutique en ligne", "Paiement sécurisé (Stripe, TWINT)", "Réservation, espace client…", "Intégrations (CRM, newsletter…)"] },
                { title: "Ce qui fait varier le prix", features: ["Nombre de pages", "Fonctionnalités (réservation, multilingue…)", "Délai souhaité", `Paiement : ${terms.payment}`], text: "Pour comparer : <a href=\"/blog/prix-site-web-suisse-2026\">combien coûte un site web en Suisse</a>." },
            ],
        },
        {
            id: "resultats", kicker: "03 · Résultats", title: "Ce que vous", dim: "obtenez.",
            subs: [
                { title: "Parfait sur mobile", text: "Plus de 60 % des visites viennent d'un téléphone." },
                { title: "Optimisé pour Google", text: "Construit pour sortir sur « votre métier + Genève », comme pour <a href=\"/portfolio/leo-lecureux-seo\">le SEO local d'un juriste à Genève</a>. Et pensé pour être cité par les IA : <a href=\"/blog/geo-seo-ia\">apparaître dans les réponses des IA</a>." },
                { title: "Rapide", text: "Moins de 2 secondes de chargement. Google et vos clients adorent." },
                { title: "Sur mesure", text: "Pas un modèle utilisé par 10'000 autres entreprises." },
                { title: "Vous gardez la main", text: "Textes, photos, horaires : vous les changez vous-même." },
                { title: "Sécurisé", text: "Hébergement fiable et cadenas HTTPS inclus." },
                { meta: "Ce qui change avec Jon Labs", title: "Pas de surprise, pas de dépendance", features: ["Pas de surprise : vous validez chaque étape avant qu'on avance", "Pas de dépendance : votre site vous appartient, vous pouvez le faire évoluer", "Pas de jargon : je vous explique tout en français, pas en « dev »", "Option express : besoin urgent ? On peut accélérer le calendrier"] },
            ],
        },
        {
            id: "local", kicker: "04 · Local", title: "Un prestataire à Genève,", dim: "ça change quoi ?",
            text: "Travailler avec quelqu'un dans la région, c'est aussi :",
            subs: [
                { title: "On peut se voir", text: "Un café pour lancer le projet, si vous préférez." },
                { title: "Le marché suisse", text: "Je connais les attentes des clients d'ici et la loi sur les données (nLPD)." },
                { title: "Réactivité", text: "Une question ? Réponse dans la journée." },
                { title: "Un réseau local", text: "Photographe, rédacteur : je peux vous recommander des gens de confiance." },
                { title: "Zones couvertes", features: ["Genève (basé sur place)", "Vaud", "Valais", "Neuchâtel", "Fribourg", "Toute la Suisse romande"], text: "Les échanges se font en personne ou en visio selon vos préférences.", link: { href: "/developpeur-web-freelance-geneve", label: "Développeur freelance à Genève" } },
            ],
        },
    ]}
    method={{
        id: "methode",
        title: "Comment", dim: "ça se passe ?",
        text: "Vous validez chaque étape. Site en ligne en 3-4 semaines.",
        steps: [
            { title: "Échange", text: "On parle de votre activité et de vos clients. Gratuit, sans engagement.", meta: "30-45 min" },
            { title: "Contenu", text: "Vous m'envoyez textes, photos et logo, même bruts. Je les mets en forme.", meta: "À votre rythme" },
            { title: "Maquette", text: "Vous voyez le site avant qu'il soit construit, et on ajuste.", meta: "3-5 jours" },
            { title: "Construction", text: "Un site sur mesure, rapide et optimisé pour Google.", meta: "1-2 semaines" },
            { title: "Mise en ligne", text: "Je publie le site et je vous montre comment modifier vos textes.", meta: "1 jour" },
        ],
    }}
    cases={{
        title: "Des exemples ?", dim: "Deux sites livrés.",
        text: "Ou <a href=\"/portfolio\">toutes mes réalisations de sites web</a>.",
        slugs: ["physio-pommier", "ugo-mighali-coutelier"],
    }}
    links={[{
        title: "Tout comprendre", dim: "avant de lancer votre site.",
        text: "Des guides pour vous faire votre avis avant de demander un devis.",
        items: [
            { href: "/blog/prix-site-web-suisse-2026", k: "Prix", label: "Combien coûte un site web en Suisse en 2026 ?" },
            { href: "/blog/specialiste-developpement-web-suisse", k: "Choisir", label: "Spécialiste du développement web en Suisse" },
            { href: "/developpeur-web-freelance-geneve", k: "Genève", label: "Développeur freelance à Genève", text: "IA, sites web et apps mobiles : un seul interlocuteur." },
            { href: "/services", k: "Services", label: "Tous les services", text: "Systèmes IA, sites web et applications mobiles." },
        ],
    }]}
    testimonials={[
        { quote: "Jonathan a été super flexible, rapide et a compris exactement ce que je voulais. Il a été très rapide en plus car j'avais un besoin urgent.", name: "Solène Derbal", role: "Cheffe d'orchestre" },
        { quote: proofLecureux.testimonial!.quote.split("\n")[0], name: proofLecureux.testimonial!.author, role: proofLecureux.metierShort, company: proofLecureux.company, result: proofLecureux.businessResult },
    ]}
    faq={{ title: "Questions sur la création de site web à Genève.", items: faqs }}
    contact="Premier échange gratuit et sans engagement. Je discute de votre projet avec vous, je vous donne mon avis honnête, vous décidez ensuite."
/>

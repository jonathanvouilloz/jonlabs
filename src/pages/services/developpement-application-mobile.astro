---
// Développement d'application mobile — pilier mobile (v2, gabarit ServicePage).
// Garde l'angle « agence + ville » (décision 02.09). Prix : src/data/pricing.ts (sur devis).
// /services/developpement-application-mobile/geneve est fusionnée ici (301) : seule Lausanne reste en déclinaison.
import ServicePage from '../../components/v2/ServicePage.astro';
import { serviceSchemas, SITE_URL, localBusinessData } from '../../data/schema';
import { getFAQPageSchema, getBreadcrumbSchema, getWebPageSchema } from '../../lib/seo';
import { pricing } from '../../data/pricing';

const seoData = {
    title: "Développement d'application mobile en Suisse romande",
    description: "Développement d'application mobile iPhone et Android à Genève et en Suisse romande, publiée sur les stores. Devis en CHF."
};

const faqs = [
    { question: "Combien coûte une application mobile ?", answer: "C'est sur devis, parce que tout dépend de ce que l'app doit faire. Après un premier appel gratuit, vous recevez un prix ferme en CHF. Pour vous faire une idée, j'ai écrit un guide sur le prix d'une application mobile en Suisse." },
    { question: "Combien de temps pour la développer ?", answer: "Une première version avec l'essentiel se fait en quelques semaines. Vous la testez sur votre téléphone tout au long du projet, pas seulement à la fin." },
    { question: "iPhone, Android : faut-il choisir ?", answer: "Non. Je développe les deux en même temps, sans doubler le prix, et je m'occupe de la publication sur les deux stores." },
    { question: "Ai-je vraiment besoin d'une app ?", answer: "Pas toujours. Parfois une application web installable (PWA) ou un bon site suffit, pour moins cher. Je vous le dis avant que vous investissiez." },
    { question: "Et après le lancement ?", answer: "Les téléphones et les stores évoluent : on peut prévoir un suivi léger. Et si vous avez déjà une app abandonnée, je peux la reprendre." },
    { question: "Pourquoi un freelance plutôt qu'une agence ?", answer: "Vous parlez directement à celui qui fait l'app, sans chef de projet entre nous. Je suis à Genève, et vos données restent protégées selon la loi suisse." }
];

const schemas: any[] = [
    serviceSchemas["developpement-application-mobile"],
    getWebPageSchema({ url: `${SITE_URL}/services/developpement-application-mobile`, name: seoData.title, description: seoData.description }),
    getBreadcrumbSchema([
        { name: "Accueil", url: SITE_URL },
        { name: "Services", url: `${SITE_URL}/services` },
        { name: "Développement application mobile", url: `${SITE_URL}/services/developpement-application-mobile` }
    ]),
    localBusinessData,
    getFAQPageSchema(faqs),
];

const cal = { href: "https://cal.com/jonathan-vouilloz/appel-de-bienvenue", label: "Discuter de mon app", external: true };
---

<ServicePage
    title={seoData.title}
    description={seoData.description}
    schemas={schemas}
    head={{
        kicker: "App mobile · basé à Genève, service en Suisse romande",
        h1: "Développement d'application mobile iOS & Android,",
        dim: "sans passer par une agence.",
        lead: "Une app iPhone et Android pour vos clients ou votre équipe, de l'idée à la publication sur les stores. Un seul interlocuteur, basé à Genève.",
        cta: cal,
        cta2: { href: "#methode", label: "Voir comment ça fonctionne" },
    }}
    sections={[
        {
            id: "problemes", kicker: "01 · Situations", title: "Vous vous", dim: "reconnaissez ?",
            text: "Une bonne app mobile, c'est d'abord une bonne décision : quoi construire, et surtout quoi ne pas construire. <strong>On commence petit, on grandit ensuite.</strong> Les projets qui dérapent construisent trop, trop tôt. Ici, on sort d'abord le cœur de votre app, puis on ajoute seulement si vos utilisateurs suivent. Et parfois la bonne réponse n'est pas une app : voir <a href=\"/blog/application-mobile-ou-pwa\">application mobile ou PWA</a>.",
            subs: [
                { title: "Vos clients réclament une app", text: "Pour réserver, suivre une commande ou recevoir une notification. Un site ne suffit plus." },
                { title: "Le devis d'agence vous a refroidi", text: "60 000 CHF, 8 mois et trois interlocuteurs. Il y a forcément plus simple." },
                { title: "Vous ne savez pas ce qu'il vous faut", text: "App, site mobile, application installable… Vous voulez un avis franc avant de dépenser." },
                { title: "Votre app est à l'abandon", text: "Elle plante, elle n'est plus à jour, et votre prestataire a disparu." },
            ],
        },
        {
            id: "resultats", kicker: "02 · Résultats", title: "Ce que vous", dim: "obtenez.",
            subs: [
                { title: "Une vraie app sur les stores", text: "Pas une maquette : une app que vos clients téléchargent et utilisent. Le parcours complet : <a href=\"/blog/sortir-application-mobile-app-store\">sortir une application mobile sur l'App Store</a>." },
                { title: "iPhone et Android", text: "Les deux, sans payer deux développements." },
                { title: "Branchée sur vos outils", text: "Agenda, facturation, fichier clients : l'app parle à ce que vous utilisez déjà. Elle peut aussi s'appuyer sur un <a href=\"/hermes\">agent IA sur mesure</a>." },
                { title: "Prête à grandir", text: "On ajoute des fonctionnalités quand vos utilisateurs en redemandent." },
                { title: "Un avis honnête", text: "Si un site ou une app plus simple suffit, je vous le dis." },
                { meta: "Ce qui change avec Jon Labs", title: "Un seul interlocuteur, une app à vous", features: ["Un seul interlocuteur : vous parlez à celui qui fait l'app", "iPhone et Android en même temps : vous ne payez pas deux fois", "Données protégées selon la loi suisse (nLPD)", "L'app est à vous : publiée à votre nom, sans dépendance"] },
            ],
        },
        {
            id: "prix", kicker: "03 · Investissement", title: "Un devis", dim: "clair.",
            text: "Chaque app est différente : c'est sur devis, avec un prix ferme avant de commencer.",
            price: { value: pricing.appMobile.display, note: "Appel découverte gratuit, devis clair en CHF." },
            cta: { ...cal, label: "Demander un devis" },
            subs: [
                { title: "Ce qui influence le prix", features: ["Le nombre d'écrans et de fonctionnalités", "Les comptes utilisateurs, paiements ou notifications", "Les connexions à vos outils existants"], text: "Pour vous faire une idée : <a href=\"/blog/prix-application-mobile-suisse\">prix d'une application mobile en Suisse</a>." },
            ],
        },
        {
            id: "about", kicker: "04 · À propos", title: "Qui est derrière", dim: "Jon Labs ?",
            subs: [
                { title: "Jonathan, développeur basé à Genève", text: "Je fais votre app moi-même, je la publie, et je vous aide à trancher quand il faut faire des choix. Mon approche : une app utile entre les mains de vos utilisateurs vaut mieux qu'un projet parfait qui ne sort jamais. Encore un doute ? <a href=\"/blog/freelance-ou-agence-application-mobile\">Freelance ou agence pour une application mobile</a>.", link: { href: "/about", label: "Mon parcours de développeur à Genève" } },
                { meta: "Local", title: "Basé à Genève, disponible partout en Suisse romande", text: "Tout peut se faire à distance : échanges, démos et tests sur votre téléphone. Si vous préférez vous voir pour le cadrage, je suis disponible à Genève et environs.", features: ["Genève (basé sur place)", "Lausanne", "Vaud", "Toute la Suisse romande"] },
            ],
        },
    ]}
    method={{
        id: "methode",
        title: "Comment", dim: "ça se passe ?",
        text: "Vous testez votre app sur votre téléphone à chaque étape.",
        steps: [
            { title: "On cadre", text: "On définit ce que votre app doit vraiment faire, et ce qu'elle ne fera pas (encore). Je vous dis quelle solution colle à votre besoin et à votre budget.", meta: "Un appel + quelques échanges" },
            { title: "Je construis", text: "Vous testez l'app sur votre téléphone au fur et à mesure. Pas besoin de comprendre le code : vous me dites ce qui va et ce qui ne va pas.", meta: "Quelques semaines" },
            { title: "On publie", text: "Je m'occupe de la mise en ligne sur l'App Store et Google Play. L'app est à votre nom, et vous pouvez la faire évoluer quand vous voulez.", meta: "Publication + passation" },
        ],
    }}
    cases={{
        title: "Des apps", dim: "déjà publiées.",
        text: "Ou l'ensemble de <a href=\"/portfolio\">mes applications publiées</a>.",
        slugs: ["nooria", "isla-plomo"],
    }}
    links={[
        {
            title: "Pages", dim: "locales.",
            items: [
                { href: "/services/developpement-application-mobile/lausanne", k: "Lausanne", label: "Application mobile à Lausanne", text: "Développement d'applications iOS et Android pour les entreprises de la région lausannoise et du canton de Vaud." },
            ],
        },
        {
            title: "Tout comprendre", dim: "avant de vous lancer.",
            text: "Pour vous faire votre avis avant un devis, commencez par le <a href=\"/blog/developper-application-mobile-suisse\">guide pour développer une application mobile en Suisse</a>. Pour un outil interne à votre équipe plutôt qu'une app sur les stores, voyez l'<a href=\"/services/application-sur-mesure\">application sur mesure</a>.",
            items: [
                { href: "/blog/application-mobile-pme-suisse", k: "Décider", label: "App mobile pour PME : vaut-il le coup ?" },
                { href: "/blog/application-mobile-ou-pwa", k: "Décider", label: "Application mobile ou PWA : comment choisir ?" },
                { href: "/blog/freelance-ou-agence-application-mobile", k: "Décider", label: "Freelance ou agence pour votre app mobile ?" },
                { href: "/blog/flutter-vs-react-native-pme", k: "Choisir la techno", label: "Flutter vs React Native : lequel choisir ?" },
                { href: "/blog/application-native-vs-hybride", k: "Choisir la techno", label: "Application native vs hybride : les différences" },
                { href: "/blog/prix-application-mobile-suisse", k: "Budgéter", label: "Prix d'une application mobile en Suisse 2026" },
                { href: "/blog/budget-mvp-application-mobile", k: "Budgéter", label: "MVP application mobile : combien prévoir ?" },
                { href: "/blog/application-metier-pme-sur-mesure", k: "S'inspirer", label: "Application métier sur mesure : 5 cas concrets" },
                { href: "/blog/application-mobile-automatisation-pme", k: "S'inspirer", label: "App mobile + automatisation : connecter son app" },
            ],
        },
    ]}
    faq={{ title: "Questions sur le développement d'application mobile.", items: faqs }}
    contact="En 30 minutes, on regarde votre projet et je vous dis honnêtement ce qu'il vous faut, et combien ça coûterait."
/>

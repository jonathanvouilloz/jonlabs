---
// Référencement local (SEO/GEO) — sous-page service (blueprint).
// Migrée du brutaliste vers le design system .co-* : sections cadrées, filets fins,
// accent teal unique, Inter Tight × Instrument Serif. Namespace scopé .rl-*.
// Gabarit-or de référence : services/creation-site-web.astro.
//
// HARD-PRESERVE : Schema.org (serviceSchemas/breadcrumb/FAQ) + ordre, data imports
// (proofLecureux), câblage Web3Forms (#seo-form, access_key + hidden inputs, tous les
// name=, honeypot botcheck, JS submit), prix via src/data/pricing.ts (390 + 199/mois),
// tous les liens SEO internes (/portfolio/leo-lecureux-seo, /blog/geo-seo-ia, /tarifs,
// /services, /blog).

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Schema.org
import { serviceSchemas, SITE_URL, localBusinessData } from '../../data/schema';
import { getBreadcrumbSchema, getFAQPageSchema } from '../../lib/seo';
import { proofLecureux } from '../../data/proof-lecureux';
import { pricing, chf } from "../../data/pricing";

// SEO Data
const seoData = {
    title: "Référencement local & SEO/GEO à Genève — freelance",
    description: "Référencement local et SEO freelance à Genève et en Suisse romande : SEO local + visibilité IA (GEO) pour PME. #1 sur sa niche prouvé en 5 mois. Audit SEO gratuit."
};

// Schema.org data
const breadcrumb = getBreadcrumbSchema([
    { name: "Accueil", url: SITE_URL },
    { name: "Services", url: `${SITE_URL}/services` },
    { name: "Référencement local", url: `${SITE_URL}/services/referencement-local` }
]);
const schemas: any[] = [serviceSchemas["referencement-local"], breadcrumb, localBusinessData];

// Pain points data (4 items)
const painPoints = [
    {
        icon: "ri-eye-off-line",
        title: "Invisible sur Google",
        description: "Quand on cherche votre métier à Genève, ce sont vos concurrents qui sortent."
    },
    {
        icon: "ri-money-dollar-circle-line",
        title: "Dépendant de la pub",
        description: "Google Ads coûte de plus en plus cher, et tout s'arrête dès que vous coupez."
    },
    {
        icon: "ri-question-line",
        title: "Un sujet opaque",
        description: "Trop de jargon, trop de promesses. Difficile de savoir à qui faire confiance."
    },
    {
        icon: "ri-time-line",
        title: "Pas le temps",
        description: "Vous savez que c'est important, mais ça passe toujours après vos clients."
    }
];

// Case study stats — dérivé de la source unique proof-lecureux
const caseStudyStats = proofLecureux.stats;

// Methodology steps (4 phases)
const methodSteps = [
    {
        step: "1",
        title: "Audit",
        description: "Je regarde votre site, votre fiche Google et vos concurrents, et je repère ce que vos clients tapent vraiment.",
        duration: "1 semaine"
    },
    {
        step: "2",
        title: "Mise en place",
        description: "Je corrige le site et j'optimise votre fiche Google pour que Google comprenne ce que vous faites, et où.",
        duration: "2-3 semaines"
    },
    {
        step: "3",
        title: "Suivi",
        description: "Chaque mois : publications sur la fiche, réponses aux avis, ajustements du site.",
        duration: "Continu"
    },
    {
        step: "4",
        title: "Point mensuel",
        description: "Vos positions, vos appels, vos clics. Des chiffres de Google, expliqués simplement.",
        duration: "Chaque mois"
    }
];

// Differentiators
const differentiators = [
    {
        icon: "ri-tools-line",
        title: "Outils gratuits",
        description: "pas de frais d'abonnement cachés, on utilise les outils de Google"
    },
    {
        icon: "ri-bar-chart-box-line",
        title: "Résultats mesurables",
        description: "rapports Google Search Console, pas des métriques inventées"
    },
    {
        icon: "ri-map-pin-line",
        title: "Focus local",
        description: "stratégie pensée pour le marché suisse romand"
    },
    {
        icon: "ri-shield-check-line",
        title: "Transparence totale",
        description: "vous voyez exactement ce qui est fait, pas de boîte noire"
    }
];

// Results (6 items)
const results = [
    {
        icon: "ri-map-pin-2-line",
        title: "Présent sur Google Maps",
        description: "Vous apparaissez quand on cherche votre métier dans votre zone."
    },
    {
        icon: "ri-store-2-line",
        title: "Une fiche Google active",
        description: "Complète, à jour, avec des avis bien gérés."
    },
    {
        icon: "ri-article-line",
        title: "Des pages qui répondent",
        description: "Du contenu local qui répond aux vraies questions de vos clients."
    },
    {
        icon: "ri-speed-line",
        title: "Un site rapide",
        description: "Les bases techniques qui font que Google vous fait confiance."
    },
    {
        icon: "ri-line-chart-line",
        title: "Des chiffres clairs",
        description: "Chaque mois, vous voyez ce qui a bougé et pourquoi."
    },
    {
        icon: "ri-route-line",
        title: "Des résultats durables",
        description: "Contrairement à la pub, la visibilité reste quand vous arrêtez de payer au clic."
    }
];

// Les leviers concrets du référencement local
const localLevers = [
    { icon: "ri-store-2-line", title: "La fiche Google", description: "Bonne catégorie, photos récentes, services et horaires à jour. C'est le levier n°1." },
    { icon: "ri-star-smile-line", title: "Les avis", description: "En récolter régulièrement et répondre à tous. Google (et vos clients) le voient." },
    { icon: "ri-equalizer-line", title: "Des infos cohérentes", description: "Même nom, même adresse, même téléphone partout : site, fiche, annuaires." },
    { icon: "ri-map-pin-range-line", title: "Des pages locales", description: "Une page par zone ou par service, avec un vrai contenu, pas du copier-coller." },
    { icon: "ri-code-s-slash-line", title: "Un site lisible par Google", description: "Rapide, bien structuré, avec les balises qui disent qui vous êtes et où." },
    { icon: "ri-links-line", title: "Des liens locaux", description: "Être cité par des sites romands : partenaires, associations, médias locaux." }
];

// Pricing plans (SEO) — prix : src/data/pricing.ts
const pricingPlans = [
    {
        name: "Mise en place",
        price: chf(pricing.seoLocal.setup),
        priceLabel: "Une fois",
        unit: "CHF",
        features: [
            "Audit de votre site et de votre fiche Google",
            "Corrections techniques du site",
            "Fiche Google Business Profile optimisée",
            "Plan d'action clair pour la suite"
        ],
        ideal: "Tout le monde : c'est le point de départ.",
        highlighted: false
    },
    {
        name: "Suivi mensuel",
        price: chf(pricing.seoLocal.monthly),
        priceLabel: "Par mois, sans engagement",
        unit: "CHF/mois",
        features: [...pricing.seoLocal.monthlyIncludes],
        ideal: "Les entreprises qui veulent monter, puis rester, en haut de Google Maps.",
        highlighted: true
    }
];

// FAQs
const faqs = [
    {
        question: "Combien ça coûte ?",
        answer: "CHF 390 pour la mise en place (audit, corrections du site, fiche Google optimisée), puis CHF 199 par mois : suivi des positions SEO, publication automatisée de posts, réponses aux avis et rapport mensuel des évolutions. Aucun contrat de durée, résiliable d'un mois à l'autre."
    },
    {
        question: "Combien de temps pour voir des résultats ?",
        answer: "Les premiers effets sur Google Maps arrivent souvent en quelques semaines. Pour le site, comptez 2 à 3 mois, et 4 à 6 mois pour des positions solides. Léo Lécureux est passé #1 sur sa niche en 5 mois."
    },
    {
        question: "Est-ce que ça marche pour mon secteur ?",
        answer: "Oui, si vos clients cherchent « votre métier + votre ville » : artisans, cabinets, restaurants, commerces, thérapeutes, coachs…"
    },
    {
        question: "J'ai déjà un site, vous pouvez l'optimiser ?",
        answer: "Oui. La mise en place commence justement par un audit de votre site existant. Parfois quelques corrections suffisent, parfois une refonte est plus rentable : je vous le dis franchement."
    },
    {
        question: "Quelle différence avec Google Ads ?",
        answer: "Avec Google Ads, vous payez chaque clic et vous disparaissez dès que vous coupez. Le référencement local reste en place : une fois bien positionné, vous restez visible."
    },
    {
        question: "Garantissez-vous la première position ?",
        answer: "Non, et méfiez-vous de ceux qui le font. Personne ne contrôle Google. Ce que je garantis : un travail concret chaque mois, et des chiffres que vous pouvez vérifier vous-même."
    },
    {
        question: "Pourquoi un freelance plutôt qu'une agence ?",
        answer: "Un seul interlocuteur qui fait le travail lui-même, aucun contrat de durée (le suivi se résilie d'un mois à l'autre), et des outils Google gratuits : vos accès et vos données restent à vous."
    }
];
schemas.push(getFAQPageSchema(faqs));

// Local advantages
const localAdvantages = [
    {
        icon: "ri-user-voice-line",
        title: "Des échanges facilités",
        description: "On peut se voir en personne si besoin. Un café pour discuter du projet, un atelier pour affiner les détails."
    },
    {
        icon: "ri-bar-chart-line",
        title: "La même réalité business",
        description: "Je connais le marché suisse, les attentes des clients locaux, les spécificités légales (LPD, facturation)."
    },
    {
        icon: "ri-time-line",
        title: "Réactivité",
        description: "Même fuseau horaire, même rythme. Une question urgente ? Vous avez une réponse dans la journée."
    },
    {
        icon: "ri-group-line",
        title: "Un réseau local",
        description: "Besoin d'un photographe professionnel ? D'un rédacteur ? Je peux vous recommander des personnes de confiance dans la région."
    }
];

// Local zones
const zones = [
    { name: "Genève", type: "primary", icon: "ri-map-pin-fill" },
    { name: "Vaud", type: "secondary", icon: "ri-map-pin-line" },
    { name: "Valais", type: "secondary", icon: "ri-map-pin-line" },
    { name: "Neuchâtel", type: "secondary", icon: "ri-map-pin-line" },
    { name: "Fribourg", type: "secondary", icon: "ri-map-pin-line" },
    { name: "Toute Suisse romande", type: "tertiary", icon: "ri-global-line" }
];

// Project type options for form
const projectTypes = [
    { value: "audit-seo", label: "Audit de référencement" },
    { value: "seo-nouveau-site", label: "Référencement + nouveau site" },
    { value: "optimiser-existant", label: "Optimiser mon site existant" },
    { value: "accompagnement-mensuel", label: "Accompagnement mensuel" },
    { value: "ne-sait-pas", label: "Je ne sais pas encore" }
];

// Budget options for form
const budgetOptions = [
    { value: "setup-suivi", label: "Mise en place + suivi (CHF 390 + 199/mois)" },
    { value: "setup-seul", label: "Mise en place seule (CHF 390)" },
    { value: "site-et-seo", label: "Nouveau site + référencement" },
    { value: "ne-sait-pas", label: "Je ne sais pas encore" }
];
---

<Layout title={seoData.title} description={seoData.description} schemas={schemas}>
    <Header />

    <main class="co-root">

        <!-- ══ HERO ══ -->
        <section class="co-sec co-pad co-hero rl-hero">
            <div class="rl-hero-grid">
                <div class="rl-hero-copy">
                    <h1 class="rl-hero-title" data-animate data-delay="0.1">
                        Référencement local à Genève. Vos clients vous <span class="co-ser">trouvent enfin.</span>
                    </h1>
                    <p class="rl-hero-lead" data-animate data-delay="0.2">
                        Votre site et votre fiche Google remontent quand on cherche votre métier près de chez vous.
                        Cas réel : <strong>#1 sur sa niche en 5 mois</strong>.
                    </p>
                    <div class="rl-hero-btns" data-animate data-delay="0.3">
                        <a href="#contact" class="co-btn"><i class="ri-search-eye-line"></i> Obtenir mon audit gratuit</a>
                        <a href="#etude-de-cas" class="co-btn co-btn--ghost">Voir un cas concret <i class="ri-arrow-down-line"></i></a>
                    </div>
                    <p class="rl-hero-loc co-mut" data-animate data-delay="0.4">
                        <i class="ri-map-pin-fill"></i> Référencement local à Genève · Freelance SEO en Suisse romande
                    </p>
                </div>

                <div class="rl-hero-media" data-animate="scale" data-delay="0.3">
                    <div class="rl-serp co-frame">
                        <span class="co-x tl"></span><span class="co-x tr"></span>
                        <span class="co-x bl"></span><span class="co-x br"></span>
                        <div class="rl-serp-bar">
                            <span class="rl-serp-dot"></span>
                            <span class="rl-serp-dot"></span>
                            <span class="rl-serp-dot"></span>
                            <span class="rl-serp-url">google.ch/search?q=juriste restauration genève</span>
                        </div>
                        <div class="rl-serp-body">
                            <div class="rl-serp-result rl-serp-result--top">
                                <span class="rl-serp-link">www.leo-lecureux.ch</span>
                                <span class="rl-serp-title">Léo Lécureux — Juriste spécialisé restauration à Genève</span>
                                <span class="rl-serp-desc">Conseil juridique spécialisé en droit de la restauration à Genève (LRDBHD, patentes, autorisations). Consultation personnalisée...</span>
                            </div>
                            <div class="rl-serp-result rl-serp-result--dim">
                                <span class="rl-serp-link">www.concurrent-2.ch</span>
                                <span class="rl-serp-title">Autre cabinet — Juriste à Genève</span>
                                <span class="rl-serp-desc">Résultat concurrent en position 2...</span>
                            </div>
                        </div>
                    </div>
                    <div class="rl-badge rl-badge--score">
                        <b>#1</b><span>Google</span>
                    </div>
                    <div class="rl-badge rl-badge--speed">5 mois</div>
                </div>
            </div>
        </section>

        <!-- ══ 01 · PROBLÈMES ══ -->
        <section id="problemes" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">01 — Problèmes</p>
            <h2 style="margin-top:var(--space-eyebrow);">Vous vous <span class="co-ser">reconnaissez ?</span></h2>
            <div class="rl-grid rl-grid--2" data-animate-stagger>
                {painPoints.map((point) => (
                    <div class="rl-card co-frame co-frame--reveal" data-animate-item>
                        <i class={`${point.icon} rl-card-icon`} aria-hidden="true"></i>
                        <h3 class="rl-card-title">{point.title}</h3>
                        <p class="rl-card-text">{point.description}</p>
                    </div>
                ))}
            </div>

            <div class="rl-note rl-note--accent" data-animate>
                <i class="ri-lightbulb-line"></i>
                <p><strong>La bonne nouvelle :</strong> pas besoin d'un gros budget ni d'être expert. Il faut la bonne méthode.</p>
            </div>
        </section>

        <!-- ══ 02 · CAS RÉEL (étude de cas Lécureux) ══ -->
        <section id="etude-de-cas" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">02 — Cas réel</p>
            <h2 style="margin-top:var(--space-eyebrow);">De <span class="rl-strike">invisible</span> à <span class="co-ser">#1 sur sa niche</span> en 5 mois</h2>
            <p class="co-mut" style="margin-top:var(--space-title-lead);max-width:62ch;line-height:1.6;">
                Léo Lécureux, juriste en droit de la restauration à Genève. Zéro présence en ligne au départ.
            </p>

            <div class="rl-stats" data-animate-stagger>
                {caseStudyStats.map((stat) => (
                    <div class="rl-stat co-frame co-frame--reveal" data-animate-item>
                        <i class={`${stat.icon} rl-stat-icon`} aria-hidden="true"></i>
                        <div class="rl-stat-value">{stat.value}</div>
                        <div class="rl-stat-label">{stat.label}</div>
                    </div>
                ))}
            </div>

            <div class="rl-context co-frame" data-animate>
                <span class="co-x tl"></span><span class="co-x tr"></span>
                <span class="co-x bl"></span><span class="co-x br"></span>
                <h3 class="rl-context-title"><i class="ri-information-line"></i> Le contexte</h3>
                <div class="rl-context-grid">
                    <ul class="co-list">
                        <li>Niche juridique ultra-concurrentielle à Genève</li>
                        <li>800+ cabinets d'avocats dans le canton</li>
                    </ul>
                    <ul class="co-list">
                        <li>Zéro présence en ligne au départ</li>
                        <li>Outils Google gratuits uniquement (pas de budget logiciels SEO)</li>
                    </ul>
                </div>
                <p class="rl-context-cta">
                    <a href="/portfolio/leo-lecureux-seo" class="rl-inline">
                        Voir l'étude de cas complète <i class="ri-arrow-right-line"></i>
                    </a>
                </p>
            </div>
        </section>

        <!-- ══ 03 · MÉTHODE ══ -->
        <section id="methode" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">03 — Méthode</p>
            <h2 style="margin-top:var(--space-eyebrow);">Comment je vous fais remonter sur Google</h2>

            <div class="rl-steps" data-animate-stagger>
                {methodSteps.map((step, index) => (
                    <div class="rl-step" data-animate-item>
                        <span class="rl-step-num co-index">0{index + 1}</span>
                        <div class="rl-step-body">
                            <h3 class="rl-step-title">{step.title}</h3>
                            <p class="rl-step-text">{step.description}</p>
                            <p class="rl-step-dur"><i class="ri-time-line"></i> {step.duration}</p>
                        </div>
                    </div>
                ))}
            </div>

            <div class="rl-diff co-frame" data-animate>
                <span class="co-x tl"></span><span class="co-x tr"></span>
                <span class="co-x bl"></span><span class="co-x br"></span>
                <h3 class="rl-diff-title">Ce qui change avec Jon Labs</h3>
                <div class="rl-diff-grid">
                    {differentiators.map((diff) => (
                        <div class="rl-diff-item">
                            <i class={`${diff.icon} rl-diff-icon`} aria-hidden="true"></i>
                            <h4 class="rl-diff-name">{diff.title}</h4>
                            <p class="rl-diff-desc">{diff.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- ══ 04 · LEVIERS ══ -->
        <section id="leviers" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">04 — Leviers</p>
            <h2 style="margin-top:var(--space-eyebrow);">Ce sur quoi <span class="co-ser">je travaille</span></h2>

            <div class="rl-grid rl-grid--2" data-animate-stagger>
                {localLevers.map((lever, index) => (
                    <div class="rl-lever co-frame co-frame--reveal" data-animate-item>
                        <div class="rl-lever-head">
                            <span class="rl-lever-num co-index">0{index + 1}</span>
                            <i class={`${lever.icon} rl-lever-icon`} aria-hidden="true"></i>
                        </div>
                        <h3 class="rl-card-title">{lever.title}</h3>
                        <p class="rl-card-text">{lever.description}</p>
                    </div>
                ))}
            </div>

            <p class="rl-note-inline" style="text-align:center;margin-top:24px;">
                Être visible aussi dans ChatGPT et Perplexity :
                <a href="/blog/geo-seo-ia" class="rl-inline">GEO et SEO IA en 2026</a>.
            </p>
        </section>

        <!-- ══ 05 · RÉSULTATS ══ -->
        <section id="resultats" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">05 — Résultats</p>
            <h2 style="margin-top:var(--space-eyebrow);">Ce que vous <span class="co-ser">obtenez.</span></h2>

            <div class="rl-grid rl-grid--3" data-animate-stagger>
                {results.map((result) => (
                    <div class="rl-card co-frame co-frame--reveal" data-animate-item>
                        <i class={`${result.icon} rl-card-icon`} aria-hidden="true"></i>
                        <h3 class="rl-card-title">{result.title}</h3>
                        <p class="rl-card-text">{result.description}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- ══ 06 · TARIFS ══ -->
        <section id="prix" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">06 — Tarifs</p>
            <h2 style="margin-top:var(--space-eyebrow);">Des tarifs <span class="co-ser">clairs.</span></h2>
            <p class="co-mut" style="margin-top:var(--space-title-lead);max-width:56ch;">Site et fiche Google compris. Sans engagement.</p>

            <div class="rl-tiers" data-animate-stagger>
                {pricingPlans.map((plan) => (
                    <div class={`rl-tier ${plan.highlighted ? 'rl-tier--reco' : ''}`} data-animate-item>
                        {plan.highlighted && <span class="co-badge co-badge--solid rl-tier-reco">Le cœur du travail</span>}
                        <h3 class="rl-tier-name">{plan.name}</h3>
                        <div class="rl-tier-price">
                            {plan.priceLabel && <span class="rl-tier-pricelabel">{plan.priceLabel}</span>}
                            <b>{plan.price}<span class="rl-tier-cur"> {plan.unit}</span></b>
                        </div>
                        <ul class="co-list co-list--check rl-tier-features">
                            {plan.features.map((feature) => (
                                <li><i class="ri-check-line"></i><span>{feature}</span></li>
                            ))}
                        </ul>
                        <p class="rl-tier-ideal"><strong>Idéal pour :</strong> {plan.ideal}</p>
                    </div>
                ))}
            </div>

            <p class="rl-note-inline" style="margin-top:24px;">
                Besoin d'un nouveau site en plus ? Voir la <a href="/tarifs" class="rl-inline">page tarifs</a>.
            </p>
        </section>

        <!-- ══ 07 · FAQ (accordéon natif <details>, zéro JS) ══ -->
        <section id="faq" class="co-sec co-pad" style="padding:var(--sec-pad-y) var(--sec-pad-x);">
            <p class="co-eyebrow">07 — FAQ</p>
            <h2 style="margin-top:var(--space-eyebrow);">Questions fréquentes</h2>

            <div class="rl-faq" style="margin-top:var(--space-block);">
                {faqs.map((faq, index) => (
                    <details open={index === 0}>
                        <summary>
                            {faq.question}
                            <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
                        </summary>
                        <p class="rl-faq-answer">{faq.answer}</p>
                    </details>
                ))}
            </div>

            <p class="co-mut" style="margin-top:24px;text-align:center;">
                Une autre question ? <a href="#contact" class="rl-inline">Contactez-moi directement</a>, je réponds sous 24h.
            </p>
        </section>

        <!-- ══ 08 · LOCAL (SEO géo) ══ -->

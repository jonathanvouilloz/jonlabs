    .rl-trust i { color: var(--accent); margin-right: 4px; }
    .rl-alt { display: flex; flex-direction: column; gap: 4px; }
    .rl-alt .rl-inline { display: inline-flex; align-items: center; gap: 6px; justify-content: center; }

    /* ── Anchor scroll offset ── */
    .co-root section[id] { scroll-margin-top: 100px; }


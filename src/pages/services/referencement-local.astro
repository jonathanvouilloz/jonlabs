    @media (max-width: 720px) {
        .rl-grid--2, .rl-grid--3, .rl-tiers, .rl-form-grid, .rl-context-grid { grid-template-columns: 1fr; }
        .rl-diff-grid { grid-template-columns: 1fr 1fr; }
        .rl-stats { grid-template-columns: repeat(2, 1fr); }

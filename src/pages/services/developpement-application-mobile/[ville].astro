---
// Application mobile à {ville} — page déclinée v2 (gabarit src/components/v2/declinee/).
// Données : src/data/villes-mobile.ts (Lausanne ; Genève fusionnée dans le pilier).
// ANTI-CANNIBALISATION : le pilier tient le générique, cette route l'exact-match ville (metaTitle / h1 par ville).
// SCHEMA : Service géo avec @id propre à l'URL (isPartOf = Service du pilier) + WebPage / BreadcrumbList / FAQPage / LocalBusiness.
import DeclineePage from '../../../components/v2/declinee/DeclineePage.astro';
import type { DcPage } from '../../../components/v2/declinee/types';
import { SITE_URL, localBusinessData } from '../../../data/schema';
import { villesSuisseIA } from '../../../data/villes-suisse-ia';
import { villesMobile, getVoisinesMobile, type VilleMobileData } from '../../../data/villes-mobile';

export async function getStaticPaths() {
  return villesMobile.map((ville) => ({ params: { ville: ville.slug }, props: { ville } }));
}

interface Props { ville: VilleMobileData }
const { ville } = Astro.props;

const pilier = '/services/developpement-application-mobile';
const path = `${pilier}/${ville.slug}`;
const pageUrl = `${SITE_URL}${path}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Développement d'application mobile à ${ville.nom} — iOS et Android`,
  url: pageUrl,
  description: ville.metaDescription,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: {
    '@type': 'City',
    name: ville.nom,
    containedInPlace: { '@type': 'AdministrativeArea', name: `Canton de ${ville.canton}` },
  },
  serviceType: 'Développement application mobile',
  isPartOf: { '@id': `${SITE_URL}${pilier}#service` },
};

const page: DcPage = {
  path, title: ville.metaTitle, description: ville.metaDescription,
  crumbs: [
    { name: 'Accueil', path: '/' },
    { name: 'Services', path: '/services' },
    { name: 'Développement application mobile', path: pilier },
    { name: ville.nom, path },
  ],
  meta: `Application mobile · canton de ${ville.canton}`,
  h1: ville.h1, h1Dim: ville.nom,
  lead: ville.angleHero,
  pillarLink: [{ text: 'Méthode et budgets détaillés sur la page ' }, { text: "développement d'application mobile", href: pilier }, { text: '.' }],
  trust: ville.preuveLocale.split('·').map((p) => p.trim()).filter(Boolean),
  ctaLabel: "Parler de votre projet d'app",
  sections: [
    {
      kind: 'prose', id: 'contexte', meta: `Contexte local · ${ville.nomComplet}`,
      title: 'Développer une app mobile', dim: `à ${ville.nom}, concrètement.`,
      paras: [ville.description, ville.contexteEconomique],
      listTitle: `Secteurs dominants à ${ville.nom}`, list: ville.secteursDominants,
    },
    {
      kind: 'prose', id: 'plateforme', meta: 'iOS ou Android',
      title: `À ${ville.nom} :`, dim: `${ville.plateforme.label}.`,
      paras: [ville.plateforme.explication],
    },
    {
      kind: 'cells', id: 'cas-usage', title: "Ce qu'une app change", dim: `dans les métiers de ${ville.nom}.`,
      intro: `Pas une liste de fonctionnalités génériques. Des applications branchées sur des métiers réellement présents dans le bassin de ${ville.nom}, secteur par secteur.`,
      items: ville.casUsageMobile.map((c) => ({ k: c.secteur, d: c.cas })),
    },
    {
      kind: 'cells', id: 'technos', title: 'Les technos', dim: 'qui ont du sens ici.',
      intro: `Le bon choix technique dépend de votre usage réel, pas de la mode. Voilà ce qui revient le plus souvent sur les projets à ${ville.nom}.`,
      items: ville.technos.map((t) => ({ t: t.nom, d: t.pourquoi })),
    },
    {
      kind: 'cells', id: 'blocages', title: 'Les blocages', dim: `que je vois à ${ville.nom}.`,
      intro: "Si vous vous reconnaissez dans l'un de ces points, le problème n'est probablement pas technique.",
      items: ville.pains.map((p, i) => ({ k: String(i + 1).padStart(2, '0'), d: p })), cols: 2,
    },
    {
      kind: 'cells', id: 'methode', title: 'Du cadrage', dim: 'à la publication sur les stores.',
      items: [
        { k: '01', t: 'Cadrage', d: "On tranche ce que l'app doit vraiment faire, sur quelles plateformes, et avec quel choix technique : natif, hybride ou PWA. Les questions de données et d'hébergement se règlent ici, pas à la livraison." },
        { k: '02', t: 'Construction', d: "Je développe par itérations courtes. Vous testez des versions réelles sur votre téléphone au fil du projet, pas seulement à la fin. Pas besoin de lire le code, juste de dire ce qui va ou pas." },
        { k: '03', t: 'Lancement', d: "Publication sur l'App Store et le Google Play Store : comptes développeurs, fiches, captures, questionnaires de confidentialité, revue. L'app est publiée à votre nom, avec une documentation de passation." },
      ],
    },
    { kind: 'prose', id: 'pour-qui', title: "À qui je m'adresse", dim: `à ${ville.nom}.`, paras: [], list: ville.publicCible },
  ],
  faqs: ville.faqs,
  faqTitle: `Questions sur l'application mobile à ${ville.nom}.`,
  links: [
    { href: pilier, k: 'Page pilier', t: "Développement d'application mobile", d: 'Natif, hybride ou PWA, publication sur les stores, ce qui fait varier le budget.' },
    ...getVoisinesMobile(ville).map((v) => ({ href: `${pilier}/${v.slug}`, k: 'Ville', t: `Application mobile à ${v.nom}`, d: v.angleHero })),
    ...ville.articles.map((a) => ({ href: a.href, k: 'Article', t: a.title, d: a.description })),
    ...villesSuisseIA.filter((v) => v.slug === ville.slug).map(() => ({ href: `/consultant-ia/${ville.slug}`, k: `Aussi à ${ville.nom}`, t: `Consultant IA à ${ville.nom}`, d: 'Automatisations et agents IA pour les PME du bassin.' })),
  ],
  cta: {
    title: 'Votre application mobile', dim: `à ${ville.nom}.`,
    text: "Premier échange gratuit, sans engagement. On regarde ce que votre app doit vraiment faire, sur quelles plateformes, et je vous dis franchement si une application est le bon outil.",
  },
  schemas: [serviceSchema, localBusinessData],
};
---

<DeclineePage page={page} />

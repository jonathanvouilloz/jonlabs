---
// CV — gabarit v2 « page simple ». Contenu repris des anciens composants cv/* (supprimés).
// La version imprimable reste /cv-pdf (noindex).
import V2Simple from '../layouts/V2Simple.astro';
import { author } from '../sample';
import { proofLecureux } from '../data/proof-lecureux';
import { personData, SITE_URL } from '../data/schema';
import { getProfilePageSchema } from '../lib/seo';

const pageTitle = "CV de Jonathan Vouilloz, systèmes IA à Genève";
const pageDescription = "CV de Jonathan Vouilloz, informaticien de gestion à Genève : systèmes IA, développement web et applications sur mesure. Parcours et projets.";

const profilePageSchema = getProfilePageSchema({
  url: `${SITE_URL}/cv`,
  name: pageTitle,
  description: pageDescription
});

const schemas = [profilePageSchema];

const formations = [
  { title: "Bachelor HES en Informatique de Gestion", school: "Haute École de Gestion (HEG) - Genève", years: "2017 - 2020" },
  { title: "CFC Informaticien de Gestion", school: "École Supérieure d'Informatique de Gestion (ESIG) - Genève", years: "2015 - 2017" },
];

const continuousLearning = [
  { label: "Marketing Digital & Copywriting", sublabel: "École des Copywriters (Stan Leloup)", period: "2024-2025", active: true },
  { label: "SEO & Référencement Naturel", period: "2025", active: true },
  { label: "Blockchain & Web3", period: "2021-2024" },
  { label: "Intelligence Artificielle & Prompt Engineering", period: "2024-2025", active: true },
];

const experiences = [
  {
    title: "Fondateur & Développeur Full-Stack", company: "Jon Labs - Freelance", location: "Genève", period: "2024 - Présent",
    missions: [
      "Développement de sites web et applications sur-mesure pour entrepreneurs et PME",
      "Automatisation de processus métiers (workflows, emails, intégrations)",
      "Conseil stratégique digital et accompagnement de projets",
      "Formation et vulgarisation technique",
    ],
    stack: ["Astro", "React", "Node.js", "Supabase", "Make", "Zapier", "MCP", "Claude Code"],
    highlights: "App gestion camps CPV • Stratégie SEO cabinet juridique • Growth marketing Le Matin Dimanche",
  },
  {
    title: "Employé Ludothèque", company: "Secteur du jeu (Temps Partiel)", location: "Genève", period: "2025 - Présent",
    missions: ["Gestion et animation d'activités ludiques", "Conseil et recommandations jeux de société", "Animation de communauté et gestion d'événements"],
  },
  {
    title: "Co-fondateur & Développeur", company: "Kusari Sàrl", location: "Genève", period: "2021 - 2024",
    missions: [
      "Exploration et développement de projets blockchain/Web3",
      "Formation approfondie sur l'écosystème crypto",
      "Développement de prototypes et applications décentralisées",
      "Veille technologique et analyse de projets innovants",
    ],
    stack: ["Solidity", "Web3.js", "Smart Contracts", "DeFi"],
  },
  {
    title: "Développeur & Consultant Marketing", company: "Barber Concept (Freelance)", location: "Genève", period: "2020 - Présent",
    missions: [
      "Développement d'un système de prise de rendez-vous en ligne",
      "Création du site web et de l'identité graphique",
      "Support marketing digital et stratégie de croissance",
    ],
    stack: ["Node.js", "PostgreSQL", "APIs"],
    highlights: "19'000 utilisateurs • 6 salons • 5 ans de relation client",
  },
  {
    title: "Moniteur de Camps de Vacances", company: "Centre Protestant de Vacances (CPV)", location: "Valais", period: "2015 - Présent",
    missions: [
      "Animation et encadrement de camps de vacances (10 ans d'ancienneté)",
      "Identification de besoins terrain → développement d'une application",
      "Collaboration officielle avec le CPV pour déploiement 2026",
    ],
  },
];

const projects = [
  {
    title: "Application Gestion Camps", client: "Centre Protestant de Vacances (CPV)", year: "2025", type: "Application sur-mesure",
    description: "Application de gestion budgétaire pour optimiser la gestion administrative des camps de vacances. Prototype validé sur le terrain → collaboration officielle.",
    results: ["-70% temps gestion", "déploiement 2026"], stack: ["Astro", "Supabase", "PostgreSQL"],
    link: "https://camp-manager-three.vercel.app/",
  },
  {
    title: "Système RDV & Site Web", client: "Barber Concept", year: "2020-2021", type: "Web + Application métier",
    description: "Système complet de prise de rendez-vous, site web et identité graphique pour une chaîne de salons de coiffure.",
    results: ["19k utilisateurs", "6 salons"], stack: ["Node.js", "PostgreSQL", "APIs"],
    link: "https://www.barberconcept.ch/",
  },
  {
    title: "Séquence Emailing Growth", client: "Le Matin Dimanche", year: "Mai 2025", type: "Marketing digital",
    description: "Conception et rédaction d'une séquence d'onboarding complète pour améliorer la rétention des nouveaux utilisateurs.",
    results: ["+25% rétention", "500+ utilisateurs"], stack: ["Copywriting", "Email Marketing", "Growth"],
  },
  {
    title: "Site & Stratégie SEO — Juriste restauration", client: proofLecureux.company, year: proofLecureux.year, type: "Site web, Branding & SEO",
    description: "Création du site web, identité visuelle et optimisation SEO complète pour générer des leads qualifiés via le référencement naturel. De zéro au #1 sur sa niche (droit de la restauration).",
    results: ["10+ leads qualifiés", "5 mois mission"], stack: [proofLecureux.platform, "SEO", "Branding", "Analytics"],
    link: "https://lecureux-conseil.ch/",
  },
  {
    title: "Automatisation Club & Comité Badminton", client: "Club local + ACGB (Association Cantonale Genevoise de Badminton)", year: "2023-2024", type: "Process, Automatisation & Comité",
    description: "Membre du comité ACGB. Création de processus automatisés pour optimiser la gestion administrative d'un club sportif de 100 membres et amélioration côté informatique de l'association.",
    results: ["100 membres gérés", "++ heures économisées"], stack: ["Airtable", "Make", "n8n"],
    link: "https://bcchenois.ch/",
  },
  {
    title: "Présentation Tokenisation Actifs Réels", client: "GEC (Geneva Event Crypto)", year: "Été 2024", type: "Conférence / Présentation",
    description: "Présentation sur la tokenisation des actifs réels (Real World Assets) lors d'un événement crypto à Genève. Vulgarisation de concepts complexes pour un public mixte.",
    results: ["50+ participants", "événement GEC"], stack: ["Blockchain", "Analyse fondamentale", "Présentation"],
    link: "https://www.linkedin.com/posts/jonathan-vouilloz-3b5741139_crypto-blockchain-activity-7238834575546744832-xdEI",
  },
];

const skillCategories = [
  { title: "Développement Web", skills: ["Astro", "React", "Node.js", "TypeScript", "JavaScript", "HTML/CSS", "Webflow", "Framer"] },
  { title: "Design & UI/UX", skills: ["Figma", "Tailwind CSS", "UI/UX Design", "Responsive", "Identité graphique"] },
  { title: "Backend & BDD", skills: ["Supabase", "PostgreSQL", "APIs RESTful", "Auth", "Architecture données"] },
  { title: "Automatisation", skills: ["Make", "Airtable", "Scripts custom", "Intégrations API", "n8n"] },
  { title: "Marketing Digital", skills: ["SEO/SEM", "Copywriting", "Email Marketing", "Analytics", "Content Strategy"] },
  { title: "Intelligence Artificielle", skills: ["Prompt Engineering", "Claude", "MCP", "Claude Code", "Workflows IA", "Cursor"] },
  { title: "Blockchain & Web3", skills: ["Analyse fondamentale", "Économie crypto", "Histoire blockchain", "Concepts DeFi", "Veille marché"] },
  { title: "Outils & Workflow", skills: ["Git/GitHub", "VS Code", "Vercel/Netlify", "Markdown", "Documentation"] },
];

const softSkills = [
  { title: "Pédagogie & Formation", description: "Vulgarisation de concepts techniques" },
  { title: "Gestion de projets", description: "De la conception à la livraison" },
  { title: "Communication", description: "Clients techniques et non-techniques" },
  { title: "Vision stratégique", description: "Conseil au-delà de l'exécution" },
  { title: "Polyvalence", description: "Tech + business + design" },
  { title: "Autonomie", description: "Freelance depuis 2020" },
];

const languages = [
  { name: "Français", level: "Langue maternelle", sublevel: "Rédaction, communication client, documentation" },
  { name: "Anglais", level: "Technique B1", sublevel: "Lecture documentation, communication professionnelle" },
];

const interests = [
  { title: "Badminton", description: "Pratique régulière + support technique et automatisation pour clubs sportifs.", skills: "Gestion d'événements, travail d'équipe, process organisationnels" },
  { title: "Photographie", description: "Capturer des moments et raconter des histoires visuelles.", skills: "Composition, storytelling visuel, design graphique" },
  { title: "Jeux de Société", description: "Animation de communauté, newsletter, emploi actuel en ludothèque.", skills: "Animation, curation de contenu, gestion de communauté" },
  { title: "Cryptomonnaies", description: "Exploration approfondie de l'écosystème (2021-2024), newsletter passée.", skills: "Analyse macro/micro, veille technologique, innovation financière" },
];

const contacts = [
  { label: "Email", value: "contact@jonlabs.ch", href: `mailto:${author.email}` },
  { label: "LinkedIn", value: "/jonathan-vouilloz", href: author.linkedin },
  { label: "GitHub", value: "/jonathanvouilloz", href: author.github },
  { label: "YouTube", value: "@jonvolio", href: author.youtube },
  { label: "Portfolio", value: "jonlabs.ch/portfolio", href: "/portfolio" },
];
---

<V2Simple
  current="/about"
  title={pageTitle}
  description={pageDescription}
  schemas={schemas}
  h1="Jonathan Vouilloz"
  lead="Informaticien de gestion & créateur digital. Bachelor HES en Informatique de Gestion."
>
  <Fragment slot="head">
    <div class="v2-simple-acts">
      <a href="/cv-pdf" target="_blank" class="v2-btn"><i class="ri-download-2-line" aria-hidden="true"></i> <span data-roll>Télécharger le CV (PDF)</span></a>
      <a href="/contact" class="v2-btn v2-btn-ghost"><span data-roll>Me contacter</span></a>
    </div>
    <p class="v2-meta"><span class="v2-meta-hl">Disponible pour opportunités</span><span>Genève, Suisse</span></p>
  </Fragment>

  <h2 id="profil">Profil</h2>
  <p>Informaticien de gestion avec <strong>8+ ans d'expérience</strong> combinant développement web, automatisation et stratégie digitale. Parcours polyvalent alliant compétences techniques, vision business et capacité de transmission. Passionné par l'accompagnement de projets de A à Z, de la conception à la mise en production.</p>
  <p>Approche pragmatique : créer des <strong>solutions concrètes</strong> qui génèrent des <strong>résultats mesurables</strong>. Formé aux nouvelles technologies (IA, blockchain, no-code) avec une veille active sur les tendances tech.</p>
  <p class="v2-meta cv-meta"><span>8+ années d'expérience</span><span>19k utilisateurs touchés</span><span>Full-Stack</span><span>Marketing Digital</span><span>IA &amp; Automatisation</span><span>Formation &amp; Pédagogie</span></p>

  <h2 id="formation">Formation</h2>
  <table>
    <tbody>
      {formations.map((f) => <tr><th scope="row">{f.years}</th><td><strong>{f.title}</strong><br />{f.school}</td></tr>)}
    </tbody>
  </table>
  <h3>Formations continues</h3>
  <ul>
    {continuousLearning.map((c) => <li><strong>{c.label}</strong>{c.sublabel && <> — {c.sublabel}</>} · {c.period}{c.active && ' · en cours'}</li>)}
  </ul>

  <h2 id="parcours">Parcours professionnel</h2>
  {experiences.map((e) => (
    <>
      <h3>{e.title}</h3>
      <p class="v2-meta cv-meta"><span>{e.company}</span><span>{e.location}</span><span>{e.period}</span></p>
      <ul>{e.missions.map((m) => <li>{m}</li>)}</ul>
      {e.stack && <p class="v2-meta cv-meta">{e.stack.map((t) => <span>{t}</span>)}</p>}
      {e.highlights && <p><strong>Projets notables :</strong> {e.highlights}</p>}
    </>
  ))}

  <h2 id="projets">Projets marquants</h2>
  <p>Sélection de projets illustrant mon approche : comprendre les besoins, créer des solutions concrètes, générer des résultats mesurables.</p>
  {projects.map((p) => (
    <>
      <h3>{p.title}</h3>
      <p class="v2-meta cv-meta"><span>{p.client}</span><span>{p.year}</span><span>{p.type}</span></p>
      <p>{p.description}</p>
      <p><strong>Résultats :</strong> {p.results.join(' · ')}{p.link && <> · <a href={p.link} target="_blank" rel="noopener noreferrer">Voir le projet</a></>}</p>
      <p class="v2-meta cv-meta">{p.stack.map((t) => <span>{t}</span>)}</p>
    </>
  ))}

  <h2 id="competences">Stack &amp; compétences</h2>
  <table>
    <tbody>
      {skillCategories.map((c) => <tr><th scope="row">{c.title}</th><td>{c.skills.join(', ')}</td></tr>)}
    </tbody>
  </table>
  <h3>Compétences transversales</h3>
  <ul>{softSkills.map((s) => <li><strong>{s.title}</strong> : {s.description}</li>)}</ul>

  <h2 id="langues">Langues</h2>
  <ul>{languages.map((l) => <li><strong>{l.name}</strong> — {l.level}. {l.sublevel}</li>)}</ul>

  <h2 id="interets">Au-delà du code</h2>
  <p>Mes passions enrichissent ma vision créative et ma capacité à penser différemment les projets.</p>
  <ul>{interests.map((i) => <li><strong>{i.title}</strong> : {i.description} <em>Compétences liées : {i.skills}</em></li>)}</ul>

  <h2 id="contact">Contact</h2>
  <p>Que ce soit pour un projet, une opportunité ou simplement échanger, je suis disponible.</p>
  <table>
    <tbody>
      {contacts.map((c) => <tr><th scope="row">{c.label}</th><td><a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{c.value}</a></td></tr>)}
    </tbody>
  </table>
  <p class="v2-meta">CV interactif — Dernière mise à jour : Décembre 2024</p>
</V2Simple>

<style>
  .cv-meta { flex-wrap: wrap; row-gap: 4px; margin-top: -.6em !important; }
</style>

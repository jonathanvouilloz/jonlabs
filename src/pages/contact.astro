---
// Page Contact (v2) : formulaire en 3 étapes (ContactSteps, Web3Forms) + canaux directs, agenda Cal.com, FAQ.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import ContactSteps from '../components/v2/ContactSteps.astro';
import Faq from '../components/v2/Faq.astro';
import Footer from '../components/v2/Footer.astro';
import { WHATSAPP, socials } from '../data/v2';
import { author } from '../sample';
import '../styles/v2.css';

import { SITE_URL } from '../data/schema';
import { getContactPageSchema, getFAQPageSchema } from '../lib/seo';

const pageTitle = "Me contacter";
const pageDescription = "Discutons de votre projet digital — développement web, IA, automatisation. Réponse sous 24 h.";

const channels = [
  { k: 'E-mail', icon: 'ri-mail-line', l: 'contact@jonlabs.ch', href: 'mailto:contact@jonlabs.ch' },
  { k: 'Message', icon: 'ri-whatsapp-line', l: 'WhatsApp', href: `https://wa.me/${WHATSAPP}`, ext: true },
  { k: 'Appel', icon: 'ri-calendar-line', l: 'Réserver un créneau', href: '#agenda' },
];
const links = [...socials, { icon: 'ri-github-fill', l: 'GitHub', href: author.github }];

// FAQ : même source pour l'affichage et le schéma FAQPage. Copy orientée « site web », à trancher par Jonathan.
const faqs = [
  { q: 'Vous travaillez en remote ou sur site ?', a: 'Principalement en remote, mais je peux me déplacer en Suisse romande pour des réunions si nécessaire. La plupart de mes clients préfèrent le remote pour sa flexibilité.' },
  { q: 'Quels sont vos tarifs ?', a: "Site web dès CHF 850 (Webflow dès CHF 950), référencement local CHF 390 puis CHF 199/mois, agent IA dès CHF 1'500. Les applications mobiles et les formations IA sont sur devis. Tous les détails sur la page tarifs." },
  { q: 'Vous prenez des petits projets ?', a: 'Absolument ! Les petits projets peuvent avoir un gros impact. Que ce soit une landing page, une automatisation simple ou un prototype, je suis ouvert à discuter.' },
  { q: 'Quels sont les délais typiques ?', a: 'Ça dépend de la complexité : 2-3 semaines pour un site vitrine, 1-2 mois pour une web app, et plusieurs mois pour une application complète. Je vous donnerai une estimation précise après avoir discuté de votre projet.' },
];

const schemas = [
  getContactPageSchema({ url: `${SITE_URL}/contact`, name: pageTitle, description: pageDescription }),
  getFAQPageSchema(faqs.map((f) => ({ question: f.q, answer: f.a }))),
];
---
<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/contact" />
    <Dock current="/contact" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <h1 class="v2-h1" data-words>Parlons de<br /><span class="v2-dim">votre projet.</span></h1>
        <p class="v2-head-p">Trois étapes, quelques lignes. Je reviens vers vous avec une première piste et un devis clair, sous 24&nbsp;h.</p>
      </div></header>

      <section class="r" aria-label="Formulaire et coordonnées"><div class="w ct-n-grid">
        <ContactSteps />

        <aside class="ct-n-side">
          <div>
            {channels.map((c) => (
              <a href={c.href} class="ct-n-row" {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="v2-meta">{c.k}</span>
                <b><i class={c.icon}></i> {c.l}</b>
                <i class="ri-arrow-right-up-line ct-n-arrow" aria-hidden="true"></i>
              </a>
            ))}
          </div>
          <div class="ct-n-soc">
            {links.map((s) => <a href={s.href} target="_blank" rel="noopener"><i class={s.icon}></i> <span class="v2-a">{s.l}</span></a>)}
          </div>
          <div class="v2-meta ct-n-foot">
            <span><i class="v2-live"></i> Réponse sous 24&nbsp;h</span>
            <span>Genève · <time data-clock>--:--</time></span>
          </div>
        </aside>
      </div></section>

      <section class="r" id="agenda" aria-labelledby="ct-n-cal">
        <div class="w v2-head v2-head-2 v2-dots v2-teal" data-spot>
          <i class="v2-dots-glow" aria-hidden="true"></i>
          <h2 class="v2-h2" id="ct-n-cal" data-words>Ou réservez<br />un appel.</h2>
          <p class="v2-head-p">L'appel découverte est gratuit. Choisissez un créneau directement dans l'agenda.</p>
        </div>
      </section>
      <section class="r" aria-label="Agenda">
        <div class="w v2-agenda"><div class="v2-cal" id="cal-inline" data-cal></div></div>
      </section>

      <section class="r"><Faq items={faqs} /></section>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .v2 .ct-n-grid { display: grid; grid-template-columns: 1.45fr 1fr; }
  .v2 .ct-n-grid > .cs { border-right: 1px solid var(--line); }

  .v2 .ct-n-side { display: flex; flex-direction: column; }
  .v2 .ct-n-row { position: relative; display: grid; gap: 8px; padding: 24px var(--pad); border-bottom: 1px solid var(--line); transition: background .2s; }
  .v2 .ct-n-row:hover { background: var(--soft); }
  .v2 .ct-n-row b { font-family: var(--display); font-weight: 500; font-size: 1.35rem; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .v2 .ct-n-row b i { font-size: 1.1rem; color: var(--accent-strong); }
  .v2 .ct-n-arrow { position: absolute; top: 22px; right: var(--pad); color: var(--mut); transition: translate .25s var(--ease), color .2s; }
  .v2 .ct-n-row:hover .ct-n-arrow { translate: 2px -2px; color: var(--ink); }
  .v2 .ct-n-soc { display: flex; flex-wrap: wrap; gap: 10px 20px; padding: 24px var(--pad); font-size: .95rem; }
  .v2 .ct-n-soc i { color: var(--mut); }
  .v2 .ct-n-foot { margin-top: auto; justify-content: space-between; padding: 16px var(--pad); border-top: 1px solid var(--line); }

  @media (max-width: 900px) {
    .v2 .ct-n-grid { grid-template-columns: 1fr; }
    .v2 .ct-n-grid > .cs { border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  import '../scripts/v2-ui';

  // Cal.com inline (même embed que la home), chargé à l'approche de la section.
  const calEl = document.querySelector('[data-cal]');
  if (calEl) {
    new IntersectionObserver((entries, obs) => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      const w = window as any;
      (function (C: any, A: string, L: string) {
        const p = (a: any, ar: any) => a.q.push(ar);
        const d = C.document;
        C.Cal = C.Cal || function (...ar: any[]) {
          const cal = C.Cal;
          if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
          if (ar[0] === L) {
            const api: any = function (...a: any[]) { p(api, a); };
            const ns = ar[1]; api.q = api.q || [];
            if (typeof ns === 'string') { cal.ns[ns] = cal.ns[ns] || api; p(cal.ns[ns], ar); p(cal, ['initNamespace', ns]); } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(w, 'https://app.cal.com/embed/embed.js', 'init');
      w.Cal('init', 'rdv', { origin: 'https://cal.com' });
      w.Cal.ns.rdv('inline', { elementOrSelector: '#cal-inline', calLink: 'jonathan-vouilloz/appel-de-bienvenue', layout: 'month_view' });
      w.Cal.ns.rdv('ui', { theme: 'light', hideEventTypeDetails: false });
    }, { rootMargin: '400px' }).observe(calEl);
  }
</script>

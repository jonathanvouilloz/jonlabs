---
// Consultant IA pour PME romandes — landing pilier (blueprint).
// Migrée du brutaliste vers le design system .co-* : sections cadrées, filets fins,
// crosshairs, accent teal unique, Inter Tight × Instrument Serif. Namespace scopé .cii-*.
// Halo (blob décoratif) retiré ; illustration encadrée .co-frame. IconChip retiré →
// icônes Remix mono inline (muted → teal au hover sur les cartes interactives).
// Gabarit-or de référence : services/referencement-local.astro.
//
// HARD-PRESERVE : tout le Schema.org (getServiceItemSchema / getWebPageSchema /
// getBreadcrumbSchema / getFAQPageSchema, tableau `schemas` + localBusinessData,
// injection via schemas={} du Layout) — même data, même ordre ; data imports
// (SITE_URL, localBusinessData, lib/seo) ; pageTitle + pageDescription exacts ;
// chaque lien SEO interne (/services/*, /consultant-ia/*, /metiers/*, /portfolio,
// /hermes, /blog/*, /contact, mailto) ; toute la copie éditoriale FR.

import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import { Image } from "astro:assets";
import illuConsultant from "../../assets/illustrations/consultant-ia.webp";

import { getServiceItemSchema, getWebPageSchema, getBreadcrumbSchema, getFAQPageSchema } from "../../lib/seo";
import { SITE_URL, localBusinessData } from "../../data/schema";

// ============================================
// SEO META
// ============================================
const pageUrl = `${SITE_URL}/consultant-ia`;
const pageTitle = "Consultant IA pour PME romandes — agents IA";
const pageDescription = "Consultant IA pour PME en Suisse romande : agents IA sur-mesure, automatisation et conseil. Prix CHF transparents, conformité nLPD. Freelance basé à Genève.";


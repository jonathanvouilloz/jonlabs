---
// Consultant IA — pilier IA (v2, gabarit ServicePage). Angle réécrit « systèmes IA sur mesure » (audit v2) ;
// garde l'URL et les ancres #automatisation, #integration-outils, #agents-sur-mesure (cibles de 301 et du méga-menu).
// /consultant-ia/geneve est fusionnée ici (301) : seule Lausanne reste en déclinaison ville.
import ServicePage from "../../components/v2/ServicePage.astro";
import { getServiceItemSchema, getWebPageSchema, getBreadcrumbSchema, getFAQPageSchema } from "../../lib/seo";
import { SITE_URL, localBusinessData } from "../../data/schema";
import { pricing, chf } from "../../data/pricing";

const pageUrl = `${SITE_URL}/consultant-ia`;
const pageTitle = "Consultant IA pour PME romandes : stratégie et mise en place";
const pageDescription = "Consultant IA à Genève : agents IA, automatisations et intégration à vos outils pour PME romandes. Prix en CHF, nLPD.";

const faqs = [
  { question: "C'est quoi, concrètement, un consultant IA ?", answer: "Quelqu'un qui vous aide à utiliser l'intelligence artificielle pour des résultats concrets, pas pour la mode. Dans mon cas : j'identifie les tâches où l'IA vous fait gagner du temps, je conçois les agents IA et les automatisations correspondants, je les intègre à vos outils, et je forme votre équipe. Vous avez un seul interlocuteur du diagnostic à la mise en production, sans jargon." },
  { question: "Combien coûte un projet IA pour une PME ?", answer: `Un agent IA démarre à CHF ${chf(pricing.agentIA.from)}. Le prix final dépend du nombre de tâches et d'outils à connecter : vous recevez un devis ferme après un premier échange gratuit. Une fois en place, l'agent tourne sur un hébergement suisse pour environ ${pricing.agentIA.runningCost.replace(' / mois', '')} par mois. Si le retour sur investissement n'est pas là, je vous le dis.` },
  { question: "Mes données sont-elles protégées ? Et la nLPD ?", answer: "C'est une partie centrale du cadrage, pas une option. On définit où vivent vos données, quels modèles y ont accès et quelles actions passent par une validation humaine. Je travaille avec des outils hébergés en Europe quand c'est nécessaire et je conçois les agents pour rester conformes à la nLPD suisse. Vos informations clients ne partent pas dans la nature." },
  { question: "Faut-il des compétences techniques de notre côté ?", answer: "Non. Vous m'expliquez votre métier et les tâches qui vous pèsent, je m'occupe de la technique. À la livraison, votre équipe sait utiliser l'agent au quotidien et vous comprenez ce qui tourne sous le capot, sans avoir à devenir développeur." },
  { question: "En combien de temps voit-on des résultats ?", answer: "Un prototype d'agent IA sur un périmètre réduit est généralement prêt en 1 à 3 semaines. Une automatisation simple peut tourner en quelques jours. Vous voyez le système fonctionner sur vos cas réels très tôt, avant de l'étendre à toute votre activité." },
  { question: "Quelle différence avec une agence IA ?", answer: "Vous parlez directement à la personne qui conçoit et code, pas à un commercial puis à un sous-traitant. Je suis basé à Genève, pas transfrontalier, mes prix sont en CHF et affichés, et je couvre toute la chaîne : IA, site web et application mobile. Une agence vous facture des couches d'intermédiaires ; ici, c'est un seul prestataire responsable du résultat." },
];

const schemas = [
  getServiceItemSchema("consultant-ia"),
  getWebPageSchema({ url: pageUrl, name: pageTitle, description: pageDescription }),
  getBreadcrumbSchema([
    { name: "Accueil", url: SITE_URL },
    { name: "Consultant IA", url: pageUrl },
  ]),
  getFAQPageSchema(faqs),
  localBusinessData,
].filter(Boolean);

const cta = { href: "/contact", label: "Cadrer mon projet IA" };
---

<ServicePage
  title={pageTitle}
  description={pageDescription}
  schemas={schemas}
  head={{
    kicker: "Consultant IA · Genève et Suisse romande",
    h1: "Consultant IA à Genève :",
    dim: "des systèmes IA sur mesure pour les PME romandes.",
    lead: "Je conçois et je construis les systèmes IA de votre entreprise : des agents IA et des automatisations qui enlèvent les tâches répétitives de votre quotidien. Prix en CHF, conformité nLPD, un seul interlocuteur du diagnostic à la mise en production.",
    cta,
    cta2: { href: "#services", label: "Voir les services" },
  }}
  proofs={{ items: [
    { value: "50", label: "sites romands audités", client: "Le terrain romand" },
    { value: "24/7", label: "avis Google traités en autonomie", client: "Cas barbershop" },
    { value: "50+", label: "sites et projets livrés", client: "IA, web et mobile" },
  ] }}
  sections={[
    {
      id: "services", kicker: "01 · Services", title: "Des systèmes IA", dim: "sur mesure.",
      text: "De l'automatisation simple à l'agent IA métier : toute la chaîne, un seul prestataire. Pour démarrer sans risque, un <a href=\"/blog/projet-pilote-ia-30-jours\">projet pilote IA en 30 jours</a>.",
      price: { value: pricing.agentIA.display, note: "Agent IA, devis ferme après un premier échange gratuit." },
      cta,
      subs: [
        { meta: pricing.agentIA.display, title: "Agents IA sur mesure", text: "Conception d'agents autonomes capables d'agir sur vos outils, avec mémoire et validation humaine. Pour les tâches pointues que les workflows génériques ne couvrent pas.", link: { href: "#agents-sur-mesure", label: "Ce qu'est un agent sur mesure" } },
        { meta: "Sur devis", title: "Automatisation de tâches", text: "Relances, rapports, saisies répétitives qui se déclenchent toutes seules. On supprime les corvées du lundi matin avant même de parler d'IA avancée.", link: { href: "#automatisation", label: "Ce qu'on automatise" } },
        { meta: "Sur devis", title: "Intégration d'outils", text: "On fait parler vos applications entre elles : Bexio, CRM, Google Workspace, votre facturation. L'info saisie une fois, partout, sans recopie.", link: { href: "#integration-outils", label: "Quand les outils bloquent" } },
        { meta: pricing.formationIA.display, title: "Formation IA pour votre équipe", text: "Vos collaborateurs apprennent à utiliser l'IA au quotidien sans se mettre en danger côté données. Cas concrets de votre métier, pas une démo générique.", link: { href: "/services/formation-ia-equipe", label: "Formation IA pour votre équipe" } },
        { meta: `Clé en main · ${pricing.agentIA.display} · en production en 2 à 3 semaines`, title: "Hermès, l'agent que je déploie chez vous", text: "Un agent IA déjà éprouvé sur des tâches concrètes de PME : tri d'e-mails, relances, préparation de documents. On part de cette base, on le branche sur vos outils, on pose les garde-fous. Vous ne payez pas six mois de R&D.", link: { href: "/hermes", label: "Découvrir l'agent IA Hermès" } },
      ],
    },
    {
      id: "automatisation", kicker: "02 · Automatisation", title: "Avant l'agent,", dim: "les corvées.",
      text: "Une bonne part du temps perdu ne demande aucune IA : juste des tâches qui se déclenchent toutes seules, et des outils qui se parlent. C'est souvent par là qu'on commence.",
      subs: [
        { title: "Relances de paiement", text: "J+7 rappel courtois, J+15 relance avec la facture en pièce jointe, J+30 notification pour que vous repreniez la main. Vous n'intervenez que sur les cas qui le méritent." },
        { title: "Rapports hebdomadaires", text: "Les données sont agrégées depuis vos outils (Bexio, CRM, tableurs) et le rapport arrive formaté dans votre boîte chaque lundi à 8h. La visibilité sans le travail." },
        { title: "Onboarding client", text: "Le client signe, et tout s'enchaîne : e-mail de bienvenue, fiche CRM créée, documents envoyés, tâche de suivi posée à deux semaines. Même niveau de service à chaque fois." },
        { title: "Validations", text: "Une demande arrive, le validateur reçoit une notification avec deux boutons, sa réponse met le système à jour et le demandeur est prévenu. Plus personne ne relance à la main." },
      ],
    },
    {
      id: "integration-outils", kicker: "03 · Intégration", title: "Quand ce sont", dim: "les outils qui bloquent.",
      text: "Bexio, votre CRM, Google Workspace, votre facturation : l'information est saisie une fois, puis elle circule. Sans recopie, sans fichier qui diverge.",
      subs: [
        { title: "Vous ressaisissez les mêmes infos partout", text: "Un nouveau client : dans le CRM, puis dans la facturation, puis dans le fichier de suivi. Trois saisies, trois risques d'erreur, zéro valeur ajoutée." },
        { title: "Vos outils fonctionnent en silos", text: "Le formulaire ne parle pas au CRM, le CRM ne parle pas à la comptabilité. Vous êtes le seul pont entre eux, et des infos se perdent en route." },
        { title: "Vous avez empilé des outils au fil du temps", text: "Notion, Trello, Bexio, Mailchimp et cinq autres. Chacun fait son job, mais ensemble c'est le chaos, et vous n'avez pas le temps de démêler ça." },
      ],
    },
    {
      id: "agents-sur-mesure", kicker: "04 · Agents sur mesure", title: "Un agent IA sur mesure,", dim: "c'est quoi ?",
      text: "Pas un chatbot générique. Un assistant conçu pour votre métier, qui se souvient du contexte, agit sur vos outils, et passe la main quand un humain doit valider. Les règles côté données : <a href=\"/blog/ia-nlpd-conformite-suisse\">IA et nLPD en Suisse</a>.",
      subs: [
        { title: "Une mémoire", text: "Il garde le contexte d'un client, d'un dossier, d'une conversation. Vous ne répétez pas trois fois la même information." },
        { title: "Une capacité d'action", text: "Il ne se contente pas de répondre : il crée une fiche, envoie un e-mail, met à jour un statut dans vos outils." },
        { title: "Une validation humaine", text: "Les actions sensibles passent par vous. L'agent prépare, vous décidez. Rien ne part dans la nature sans contrôle." },
        { meta: "Agent sur mesure ou automatisation ?", title: "Deux réponses à deux problèmes", features: ["L'automatisation couvre les workflows larges et prévisibles : « quand X arrive, fais Y ». Idéale pour les relances, les rapports, les saisies récurrentes.", "L'agent IA sur mesure est un assistant autonome pour une tâche pointue qui demande du jugement, du contexte et plusieurs étapes. C'est de la conception, pas du branchement d'outils."] },
      ],
    },
    {
      id: "cas-usage", kicker: "05 · Cas d'usage", title: "Où l'IA peut vous", dim: "enlever du travail.",
      text: "Six cas valables pour la plupart des PME de Suisse romande. Les heures gagnées sont des estimations réalistes, pas des promesses.",
      subs: [
        { meta: "3 à 5 h/sem", title: "Tri et routage des demandes", text: "Chaque message entrant est lu, classé et transmis à la bonne personne avec un résumé. Vous ne triez plus, vous traitez." },
        { meta: "2 à 4 h/sem", title: "Documents préparés", text: "Devis, contrats et comptes-rendus montés à partir de vos données existantes. Vous relisez au lieu de tout retaper, et vous validez avant l'envoi." },
        { meta: "2 à 3 h/sem", title: "Relances automatiques", text: "Factures impayées, devis sans réponse, rendez-vous à confirmer : les relances partent au bon moment." },
        { meta: "2 à 4 h/sem", title: "Veille ciblée", text: "Appels d'offres, actualité réglementaire, concurrents : un digest filtré arrive chez vous, sans le bruit. Vous lisez ce qui compte." },
        { meta: "3 à 6 h/sem", title: "Support multilingue", text: "Vos clients écrivent en français, allemand ou anglais, l'agent comprend et répond dans la bonne langue au premier niveau." },
        { meta: "2 à 3 h/sem", title: "Reporting automatisé", text: "Les chiffres sont agrégés depuis vos outils et le tableau de bord arrive chaque lundi dans votre boîte mail. Sans Excel à la main." },
      ],
    },
    {
      id: "differenciants", kicker: "06 · Pourquoi moi", title: "Un consultant IA", dim: "vraiment suisse.",
      text: "Quatre choses que les freelances IA transfrontaliers ne vous offrent pas. Concrètes, vérifiables, sans plaquette.",
      subs: [
        { title: "Vraiment basé à Genève", text: "Atelier installé à Chêne-Bougeries, pas un prestataire transfrontalier qui facture depuis l'autre côté de la frontière. On se voit pour un café si le projet le mérite, et je connais le terrain romand." },
        { title: "Prix en CHF, affichés", text: `Un agent IA démarre à CHF ${chf(pricing.agentIA.from)}, avec un devis ferme après un premier échange gratuit. Pas de prix caché jusqu'au dernier rendez-vous.` },
        { title: "Des preuves chiffrées", text: "50 sites romands audités, un système de réponse aux avis Google qui tourne en autonomie (cas barbershop), 50+ sites livrés. Des résultats vérifiables, pas des promesses de plaquette.", link: { href: "/portfolio", label: "Voir les réalisations IA en production" } },
        { title: "Un seul prestataire", text: "IA, site web et application mobile sous le même toit : une <a href=\"/services/application-sur-mesure\">application sur mesure</a> pour votre équipe, ou un <a href=\"/services/developpement-application-mobile\">développement d'application mobile</a> pour vos clients. Vous arrêtez de jongler entre plusieurs agences qui se renvoient la balle quand ça coince." },
      ],
    },
  ]}
  bento={{ title: "Ce que", dim: "je construis.", text: "Des agents, des apps et des automatisations branchés sur vos outils." }}
  method={{
    title: "Comment on construit", dim: "votre agent.",
    text: "Une méthode courte qui part de vos tâches réelles et finit avec un système en production.",
    steps: [
      { title: "Audit du besoin", text: "On identifie la tâche précise à confier à l'agent et on vérifie qu'elle est rentable à automatiser. Si elle ne l'est pas, je vous le dis." },
      { title: "Prototype", text: "Je construis une première version de l'agent sur un périmètre réduit. Vous le voyez fonctionner sur vos cas réels avant tout engagement lourd." },
      { title: "Garde-fous", text: "On cadre ce que l'agent peut faire seul et ce qui passe par une validation humaine. Vos données restent conformes nLPD, les actions sensibles sont sous contrôle." },
      { title: "Prise en main", text: "Documentation claire, formation de votre équipe et support pour les premières semaines. Pas de boîte noire : vous comprenez ce qui tourne." },
    ],
  }}
  links={[
    {
      title: "L'IA près de chez vous", dim: "et dans votre métier.",
      items: [
        { href: "/consultant-ia/lausanne", k: "Vaud", label: "Consultant IA à Lausanne", text: "Conseil et agents IA pour les entreprises de la région lausannoise et du canton de Vaud." },
        { href: "/consultant-ia/annemasse", k: "Genevois français", label: "Consultant IA à Annemasse", text: "Agents IA et automatisation pour les entreprises du Genevois français, à quelques minutes de Genève." },
        { href: "/consultant-ia/gaillard", k: "Frontière genevoise", label: "Consultant IA à Gaillard", text: "Agents IA et automatisation pour les entreprises de Gaillard et de la frontière genevoise." },
        { href: "/metiers/ia-fiduciaire", k: "Métier", label: "IA pour fiduciaires", text: "Tri et pré-imputation des pièces (Bexio, Crésus), relances, TVA, veille légale. La validation reste humaine." },
        { href: "/metiers/ia-agence-immobiliere", k: "Métier", label: "IA pour agences immobilières", text: "Qualification des leads, tri des dossiers locataires, rédaction d'annonces, relances et suivi des échéances." },
      ],
    },
    {
      title: "À lire sur", dim: "l'IA en PME.",
      text: "Pour commencer, le <a href=\"/guides/mettre-en-place-ia-entreprise-guide\">guide pour mettre l'IA en place dans votre entreprise</a>, puis <a href=\"/blog/consultant-ia-c-est-quoi\">ce que fait un consultant IA</a>.",
      items: [
        { href: "/blog/automatisation-pme-suisse-guide-complet", k: "Guide", label: "Automatisation PME en Suisse : le guide complet", text: "Par où commencer, combien ça coûte et quelles tâches automatiser en premier." },
        { href: "/blog/hermes-agent-ia-pme", k: "Article", label: "Hermès : un agent IA conçu pour une PME", text: "Le cas concret d'un agent métier, de l'audit à la mise en production." },
        { href: "/blog/workflows-vs-agents-ia-pme", k: "Article", label: "Workflows ou agents IA : que choisir ?", text: "Automatiser un workflow ou déployer un agent autonome : comment ne pas se tromper." },
        { href: "/blog/agent-ia-entreprise-cas-usage", k: "Article", label: "Agent IA en entreprise : 10 cas d'usage qui rapportent", text: "Fiduciaire, régie immobilière, négoce, cabinet, e-commerce : secteur par secteur." },
        { href: "/blog/prix-agent-ia-automatisation-suisse", k: "Article", label: "Prix d'un agent IA et d'une automatisation en Suisse", text: "Les fourchettes réelles en CHF selon la complexité, sans devis flou." },
      ],
    },
  ]}
  faq={{ title: "Questions sur le consultant IA à Genève.", items: faqs }}
  contact="Premier échange gratuit, sans engagement. On identifie la tâche à confier à l'IA, on chiffre en CHF, et si le retour sur investissement n'est pas là, je vous le dis."
/>

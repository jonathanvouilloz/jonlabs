  }
  .cii-keyturn-delai { font-size: 13px; color: rgba(245, 244, 240, 0.60); }
  .cii-keyturn-cta {
    display: inline-flex; align-items: center; gap: 7px; margin-top: 12px;
    font-size: 14px; font-weight: 600;
  }
  .cii-keyturn-cta i { transition: transform .18s ease-out; }
  .cii-keyturn:hover .cii-keyturn-cta i { transform: translateX(3px); }
  .cii-mini-title { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-top: var(--space-subsection); }

  /* ── Services (cartes-liens avec prix) ── */
  .cii-svc {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 24px;
    background: var(--surface); border: 1px solid var(--line-2);
    transition: box-shadow .18s ease-out, transform .18s ease-out;
  }
  .cii-svc:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(20,22,26,.07); }
  .cii-svc-icon { font-size: 24px; color: var(--muted); line-height: 1; transition: color .18s ease-out; }
  .cii-svc:hover .cii-svc-icon, .cii-link:hover .cii-svc-icon { color: var(--accent); }
  .cii-svc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
  .cii-svc-price { font-size: 13px; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; }
  .cii-svc-arrow { font-size: 18px; color: var(--muted); transition: transform .18s ease-out; }
  .cii-svc:hover .cii-svc-arrow { transform: translateX(3px); color: var(--accent); }

  /* ── Encart split (agent vs automatisation) ── */
  .cii-split { position: relative; margin-top: var(--space-block); padding: 32px; background: var(--surface); border: 1px solid var(--line-2); }
  .cii-split-title { font-size: 1.2rem; display: inline-flex; align-items: center; gap: 8px; }
  .cii-split-title i { color: var(--accent); }
  .cii-split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 22px; }
  .cii-split-lead { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px; }

  /* ── Process (étapes numérotées) ── */
  .cii-proc { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 24px; background: var(--surface); border: 1px solid var(--line-2); }
  .cii-proc-num { font-size: 20px; font-weight: 700; }
  .cii-proc-title { font-size: 1.05rem; font-weight: 600; }

  /* ── Cas d'usage : en-tête + étiquette de gain (le reste est porté par
     `.cii-bento-*` depuis la fusion des deux grilles) ── */
  .cii-uc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cii-uc-gain { flex: none; }

  /* ── Stats (preuves) ── */
  .cii-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: var(--space-block); }
  .cii-stat { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 30px 26px; background: var(--surface); border: 1px solid var(--line-2); text-align: center; align-items: center; }
  .cii-stat-value { font-size: 3rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--accent); }
  .cii-stat-label { font-size: 15px; font-weight: 600; color: var(--ink); }
  .cii-proof-cta { margin-top: 28px; display: flex; justify-content: center; }
  .cii-proof-cta .co-btn i:last-child { transition: transform .18s ease-out; }
  .cii-proof-cta .co-btn:hover i:last-child { transform: translateX(3px); }

  /* ── Cartes-liens (géo / métiers / blog) ── */
  .cii-link {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 24px;
    background: var(--surface); border: 1px solid var(--line-2);
    transition: box-shadow .18s ease-out, transform .18s ease-out;

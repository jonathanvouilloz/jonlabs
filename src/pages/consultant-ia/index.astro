    href: "/services/formation-ia-equipe"
  },
  {
    icon: "ri-search-eye-line",
    title: "Audit & conseil IA",
    description: "Où l'IA vous fait gagner du temps, où elle ne sert à rien, et dans quel ordre attaquer. Un état des lieux honnête avant de dépenser le moindre franc.",
    price: "Dès CHF 800",
    href: "/contact"
  },
  {
    icon: "ri-tools-line",
    title: "Outils sur mesure",
    description: "Tableaux de bord, portails clients, applications internes pilotées par IA. Pour automatiser ce qu'Excel ne sait plus faire seul.",
    price: "Sur devis",
    href: "/services/outils-sur-mesure"
  }
];

// ============================================
// OFFRE CLÉ EN MAIN (bloc à part, pas une 7e carte)
// ============================================
const cleEnMain = {
  nom: "Hermès",
  accroche: "L'agent que je déploie chez vous",
  description: "Un agent IA déjà éprouvé sur des tâches concrètes de PME — tri d'e-mails, relances, préparation de documents. On part de cette base, on le branche sur vos outils, on pose les garde-fous. Vous ne payez pas six mois de R&D.",
  price: "Dès CHF 2'500",
  delai: "En production en 2 à 3 semaines",
  href: "/hermes"
};

// ============================================
// AUTOMATISATION & INTÉGRATION
// Contenu repris des ex-pages /consultant-ia#automatisation et
// /consultant-ia#integration-outils, condensé et redirigé ici.
// ============================================
const automatisationCas = [
  {
    icon: "ri-money-euro-circle-line",
    title: "Relances de paiement",

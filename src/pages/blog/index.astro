---
// Index du blog — v2 : à la une en fiche (image bord à bord + texte), barre catégories + recherche,
// grille de 3 cellules à filets (contenu posé en retrait dans chaque cellule), « Afficher plus » par 12.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/v2/Nav.astro';
import Dock from '../../components/v2/Dock.astro';
import Footer from '../../components/v2/Footer.astro';
import PostCells from '../../components/v2/PostCells.astro';
import '../../styles/v2.css';
import { blogSchema } from '../../data/schema';
import { categories, formatDate, getCategoryName, isPublished, type CategoryKey } from '../../lib/blog';

const posts = (await getCollection('blog', ({ data }) => isPublished(data)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [feat, ...rest] = posts;
const cats = (Object.keys(categories) as CategoryKey[])
  .map((k) => ({ k, n: rest.filter((p) => p.data.category === k).length }))
  .filter((c) => c.n > 0)
  .sort((a, b) => b.n - a.n);
const PAGE = 12;
const schemas = [blogSchema];
---

<Layout
  title="Blog | Développement Web & Automatisation"
  description="Articles et réflexions sur le développement web, l'automatisation et l'entrepreneuriat digital. Retours d'expérience concrets par Jonathan Vouilloz."
  schemas={schemas}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/blog" />
    <Dock current="/blog" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <div>
          <p class="v2-meta">{posts.length} articles · {cats.length} thèmes</p>
          <h1 class="v2-h1 v2-port-h1" data-words>Blog.</h1>
        </div>
        <p class="v2-head-p">Agents IA, automatisation et apps pour les PME romandes : ce que j'apprends en le construisant.</p>
      </div></header>

      {feat && (
        <section class="r" aria-label="À la une">
          <a href={`/blog/${feat.slug}`} class="w v2-spec bl-n-feat" data-rise>
            <div class="v2-spec-img"><img src={feat.data.image.url} alt={feat.data.image.alt} width="700" height="420" /></div>
            <div class="v2-spec-body">
              <div class="bl-n-feat-txt">
                <p class="v2-meta"><span class="v2-meta-hl">À la une</span><span>{getCategoryName(feat.data.category)}</span></p>
                <h2>{feat.data.h1 ?? feat.data.title}</h2>
                <p class="v2-mut">{feat.data.description}</p>
              </div>
              <p class="v2-meta"><time datetime={feat.data.pubDate.toISOString()}>{formatDate(feat.data.pubDate)}</time>{feat.data.readingTime && <span>{feat.data.readingTime} min de lecture</span>}</p>
              <span class="v2-btn v2-btn-sm"><span data-roll>Lire l'article</span></span>
            </div>
          </a>
        </section>
      )}

      <section class="r" aria-labelledby="all"><div class="w">
        <h2 class="sr-only" id="all">Tous les articles</h2>
        <div class="bl-n-bar">
          <div class="bl-n-tabs" role="group" aria-label="Filtrer par catégorie">
            <button type="button" data-f="all" aria-pressed="true">Tous</button>
            {cats.map((c) => <button type="button" data-f={c.k} aria-pressed="false">{getCategoryName(c.k)} <span>{c.n}</span></button>)}
          </div>
          <label class="bl-n-search">
            <i class="ri-search-line" aria-hidden="true"></i>
            <input type="search" placeholder="Rechercher" aria-label="Rechercher un article" data-q />
          </label>
        </div>

        <PostCells posts={rest} page={PAGE} />
        <p class="bl-n-empty v2-mut" data-empty hidden>Aucun article ne correspond. Essayez un autre mot.</p>
        <div class="bl-n-more">
          <button type="button" class="v2-btn v2-btn-ghost" data-more><span data-roll>Afficher plus</span></button>
          <span class="v2-meta" data-count></span>
        </div>
      </div></section>

      <section class="r"><div class="w v2-head v2-head-2">
        <h2 class="v2-h2" data-words>Un sujet vous parle ?<br /><span class="v2-dim">Parlons de votre cas.</span></h2>
        <div class="v2-ctas v2-ctas-left">
          <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Réserver un appel</span></a>
          <a href="mailto:contact@jonlabs.ch" class="v2-btn v2-btn-ghost"><span data-roll>contact@jonlabs.ch</span></a>
        </div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .v2 .bl-n-feat .v2-spec-img { min-height: 380px; }
  .v2 .bl-n-feat-txt { display: grid; gap: 14px; }
  .v2 .bl-n-feat h2 { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(1.7rem, 2.8vw, 2.3rem); letter-spacing: -0.045em; line-height: 1.05; }
  .v2 .bl-n-feat:hover h2 { color: var(--accent-strong); }

  .v2 .bl-n-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; padding: 14px var(--pad); border-bottom: 1px solid var(--line); }
  .v2 .bl-n-tabs { display: flex; flex-wrap: wrap; gap: 4px; }
  .v2 .bl-n-tabs button { all: unset; cursor: pointer; padding: 7px 12px; border-radius: var(--r); font-size: .92rem; color: var(--mut); transition: background .2s, color .2s; }
  .v2 .bl-n-tabs button span { font-family: var(--mono); font-size: .7rem; margin-left: 2px; }
  .v2 .bl-n-tabs button:hover { color: var(--ink); }
  .v2 .bl-n-tabs button[aria-pressed="true"] { background: var(--soft); color: var(--ink); }
  .v2 .bl-n-tabs button:focus-visible { outline: 2px solid var(--accent-strong); }
  .v2 .bl-n-search { position: relative; width: min(260px, 100%); }
  .v2 .bl-n-search i { position: absolute; left: 12px; top: 50%; translate: 0 -50%; color: var(--mut); }
  .v2 .bl-n-search input { font: inherit; font-size: .92rem; width: 100%; padding: 9px 12px 9px 36px; border: 1px solid var(--line); border-radius: var(--r); background: #fff; color: var(--ink); transition: border-color .2s, box-shadow .2s; }
  .v2 .bl-n-search input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(0,217,163,.18); }

  .v2 [hidden] { display: none !important; }

  .v2 .bl-n-empty { padding: 48px var(--pad); }
  .v2 .bl-n-more { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 32px var(--pad); border-top: 1px solid var(--line); margin-top: -1px; position: relative; background: #fff; }
  .v2 .bl-n-more button { cursor: pointer; font: inherit; }
  .v2 .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 900px) {
    .v2 .bl-n-feat .v2-spec-img { min-height: 220px; }
  }
  @media (max-width: 600px) {
    .v2 .bl-n-bar { padding: 12px var(--pad); }
    .v2 .bl-n-tabs { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(var(--pad) * -1); padding: 0 var(--pad); scrollbar-width: none; width: calc(100% + var(--pad) * 2); }
    .v2 .bl-n-tabs button { white-space: nowrap; }
    .v2 .bl-n-search { width: 100%; }
  }
</style>

<script>
  import '../../scripts/v2-ui';
  const PAGE = 12;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] > article')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const more = document.querySelector<HTMLElement>('[data-more]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let cat = 'all';
  let shown = PAGE;

  const render = () => {
    const term = q.value.trim().toLowerCase();
    const match = cards.filter((c) => (cat === 'all' || c.dataset.cat === cat) && (!term || c.dataset.text!.includes(term)));
    cards.forEach((c) => (c.hidden = true));
    match.slice(0, shown).forEach((c) => (c.hidden = false));
    empty.hidden = match.length > 0;
    more.hidden = match.length <= shown;
    count.textContent = match.length ? `${Math.min(shown, match.length)} / ${match.length}` : '';
  };
  tabs.forEach((t) => t.addEventListener('click', () => {
    cat = t.dataset.f!; shown = PAGE;
    tabs.forEach((o) => o.setAttribute('aria-pressed', String(o === t)));
    render();
  }));
  q.addEventListener('input', () => { shown = PAGE; render(); });
  more.addEventListener('click', () => { shown += PAGE; render(); });
  render();
</script>

---
// Page tag — v2 : même chrome et même grille que l'index /blog (PostCells). noindex, follow (hors sitemap).
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/v2/Nav.astro';
import Dock from '../../../components/v2/Dock.astro';
import Footer from '../../../components/v2/Footer.astro';
import PostCells from '../../../components/v2/PostCells.astro';
import '../../../styles/v2.css';
import { isPublished } from '../../../lib/blog';
import { tagLabel } from '../../../lib/tags';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => isPublished(data));
  const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const label = tagLabel(tag);
---

<Layout
  title={`Articles sur "${label}"`}
  description={`Tous les articles du blog Jon Labs sur le thème : ${label}`}
  robots="noindex, follow"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </Fragment>

  <div class="v2">
    <Nav current="/blog" />
    <Dock current="/blog" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <div>
          <p class="v2-meta"><a href="/blog" class="tg-n-back"><i class="ri-arrow-left-line" aria-hidden="true"></i> Blog</a><span>{posts.length} article{posts.length > 1 ? 's' : ''}</span></p>
          <h1 class="v2-h1 v2-port-h1" data-words>{label}.</h1>
        </div>
        <p class="v2-head-p">Les articles classés sous <span class="tg-n-slug">#{tag}</span>, du plus récent au plus ancien.</p>
      </div></header>

      <section class="r" aria-label={`Articles : ${label}`}><div class="w">
        <PostCells posts={posts} />
      </div></section>

      <section class="r"><div class="w v2-head v2-head-2">
        <h2 class="v2-h2" data-words>Un sujet vous parle ?<br /><span class="v2-dim">Parlons de votre cas.</span></h2>
        <div class="v2-ctas v2-ctas-left">
          <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Réserver un appel</span></a>
          <a href="/blog" class="v2-btn v2-btn-ghost"><span data-roll>Tous les articles</span></a>
        </div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .v2 .tg-n-back { display: inline-flex; align-items: center; gap: 6px; transition: color .2s; }
  .v2 .tg-n-back:hover { color: var(--ink); }
  .v2 .tg-n-slug { font-family: var(--mono); font-size: .9em; }
</style>

<script>
  import '../../../scripts/v2-ui';
</script>

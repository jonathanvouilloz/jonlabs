---
// Page article v2 (direction B · Magazine centré, validée le 2026-11-17) : titre centré, image 21/9 bord à bord,
// colonne de lecture 680px, sommaire repliable. Le corps garde .co-prose (TL;DR, tableaux, code, widgets MDX).
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Nav from '../../components/v2/Nav.astro';
import Dock from '../../components/v2/Dock.astro';
import Footer from '../../components/v2/Footer.astro';
import imgJonathan from '../../assets/jonathan-vouilloz.webp';
import '../../styles/v2.css';
import VideoEmbed from '../../components/blog/VideoEmbed.astro';
import { formatDate, getRelatedPosts, isPublished } from '../../lib/blog';
import { author } from '../../sample';
import { getBlogPostingSchema, getBreadcrumbSchema, getFAQPageSchema } from '../../lib/seo';
import { SITE_URL, personData, organizationData } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => isPublished(data));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { title, h1, description, image, category, tags, pubDate, readingTime, youtubeId, youtubeTitle } = post.data;
const { Content, headings } = await post.render();
const toc = headings.filter((h) => h.depth === 2);
const updated = post.data.updatedDate && post.data.updatedDate.getTime() !== pubDate.getTime() ? post.data.updatedDate : undefined;
const share = encodeURIComponent(Astro.url.href);

const relatedPosts = getRelatedPosts(post, allPosts, 3);

// Generate schemas
const blogPostingSchema = getBlogPostingSchema({
  title,
  description,
  url: Astro.url.href,
  image: new URL(image.url, Astro.site).toString(),
  datePublished: pubDate,
  dateModified: post.data.updatedDate || pubDate,
  author: author.name,
  category,
  tags,
  readingTime
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Accueil', url: SITE_URL },
  { name: 'Blog', url: `${SITE_URL}/blog` },
  { name: title, url: Astro.url.href },
]);

const schemas = [
  personData,
  organizationData,
  blogPostingSchema,
  breadcrumbSchema,
];
if (post.data.faqs && post.data.faqs.length > 0) {
  schemas.push(getFAQPageSchema(post.data.faqs));
}
---

<Layout
  title={title}
  description={description}
  ogImage={image.url}
  ogType="article"
  schemas={schemas}
  article={{
    publishedTime: pubDate,
    modifiedTime: post.data.updatedDate,
    author: author.name,
    section: category,
    tags
  }}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/blog" />
    <Dock current="/blog" />

    <main>
      <article>
        <header class="r"><div class="w v2-art-head">
          {tags.length > 0 && (
            <p class="v2-tags">{tags.slice(0, 3).map((t, i) => <>{i > 0 && <i></i>}<a href={`/blog/tag/${t}`}>{t}</a></>)}</p>
          )}
          <h1 class="v2-h1">{h1 ?? title}</h1>
          <p class="v2-meta">
            <a href="/about">{author.name}</a>
            <span>{formatDate(pubDate)}</span>
            {updated && <span>Mis à jour le {formatDate(updated)}</span>}
            {readingTime && <span>{readingTime} min de lecture</span>}
          </p>
        </div></header>

        <div class="r"><div class="w v2-art-img"><img src={image.url} alt={image.alt} width="1180" height="506" /></div></div>

        <div class="r"><div class="w v2-art">
          {toc.length > 2 && (
            <details class="v2-art-toc">
              <summary class="v2-meta">Sommaire · {toc.length} parties<i class="ri-add-line" aria-hidden="true"></i></summary>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </details>
          )}
          {youtubeId && <div class="co-root v2-art-video"><VideoEmbed youtubeId={youtubeId} title={youtubeTitle ?? title} /></div>}
          <div class="co-prose v2-art-prose"><Content /></div>

          <div class="v2-art-foot">
            <a href="/blog" class="v2-meta"><i class="ri-arrow-left-line" aria-hidden="true"></i> Tous les articles</a>
            <p class="v2-meta">
              <span>Partager</span>
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur X"><i class="ri-twitter-x-line"></i></a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn"><i class="ri-linkedin-fill"></i></a>
              <button type="button" aria-label="Copier le lien" data-copy><i class="ri-link"></i></button>
            </p>
          </div>

          <a href="/about" class="v2-art-author">
            <Image src={imgJonathan} alt={`Photo de ${author.name}`} width={56} height={56} loading="lazy" />
            <span><span class="v2-meta">Écrit par</span><strong>{author.name}</strong></span>
            <i class="ri-arrow-right-line" aria-hidden="true"></i>
          </a>
        </div></div>
      </article>

      {relatedPosts.length > 0 && (
        <section class="r" aria-labelledby="related"><div class="w">
          <div class="v2-head"><h2 class="v2-h2" id="related" data-words>À lire ensuite</h2></div>
          <div class="v2-art-rel">
            {relatedPosts.map((p) => (
              <a href={`/blog/${p.slug}`}>
                <img src={p.data.image.url} alt="" loading="lazy" width="400" height="225" />
                <span class="v2-meta"><span>{formatDate(p.data.pubDate)}</span>{p.data.readingTime && <span>{p.data.readingTime} min</span>}</span>
                <strong>{p.data.h1 ?? p.data.title}</strong>
              </a>
            ))}
          </div>
        </div></section>
      )}
    </main>

    <Footer />
  </div>
</Layout>

<script>
  import '../../scripts/v2-ui';
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    await navigator.clipboard.writeText(location.href);
    b.innerHTML = '<i class="ri-check-line"></i>';
    setTimeout(() => (b.innerHTML = '<i class="ri-link"></i>'), 2000);
  }));
</script>

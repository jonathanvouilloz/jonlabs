---
// STYLEGUIDE v2 (branche rebrand-v2, noindex) : référence vivante des composants validés le 2026-11-17.
// Les essais écartés (3 par élément) sont dans git : commit c16aaa5. Doc → docs/design-v2.md.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/v2/Nav.astro';
import Dock from '../../components/v2/Dock.astro';
import Hero from '../../components/v2/Hero.astro';
import CaseSpec from '../../components/v2/CaseSpec.astro';
import Proofs from '../../components/v2/Proofs.astro';
import Steps from '../../components/v2/Steps.astro';
import Bento from '../../components/v2/Bento.astro';
import Faq from '../../components/v2/Faq.astro';
import Contact from '../../components/v2/Contact.astro';
import ProjectForm from '../../components/v2/ProjectForm.astro';
import PostFeature from '../../components/v2/PostFeature.astro';
import Pricing from '../../components/v2/Pricing.astro';
import Footer from '../../components/v2/Footer.astro';
import { nav, promises, testimonials } from '../../data/v2';
import '../../styles/v2.css';
import '../../styles/v2-styleguide.css';

const c0 = (await getCollection('portfolio', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .find((c) => c.data.client?.sector)!;

const pad = (n: number) => String(n).padStart(2, '0');
// [id, élément, direction retenue, composant ou classe]
const sections = [
  ['fondations', 'Fondations', 'Couleurs, typo, rayons, mouvement', 'tokens · v2.css'],
  ['grille', 'Cadre de grille', 'B · Repères en croix', '.r > .w'],
  ['boutons', 'Boutons', 'B · Roulement', '.v2-btn + [data-roll]'],
  ['liens', 'Liens texte', 'A · Trait qui se trace', '.v2-a · .v2-prose'],
  ['nav', 'Navigation haute', 'B · Pastille glissante + méga-menu C · Carte flottante (survole Systèmes IA, Blog)', '<Nav />'],
  ['dock', 'Dock bas', 'B · Pastille glissante', '<Dock />'],
  ['hero', 'Hero', 'B · Trame', '<Hero />'],
  ['fonds', 'Fond de section', 'A · Points + projecteur, sur teal', '.w.v2-teal.v2-dots [data-spot]'],
  ['titres', 'Titres animés', 'A · Mots qui montent', '[data-words]'],
  ['tags', 'Tags et métadonnées', 'A · Étoiles', '.v2-tags · .v2-meta'],
  ['cas', 'Étude de cas', 'B · Fiche technique', '<CaseSpec />'],
  ['bento', 'Bento services', 'A · Figures iso', '<Bento />'],
  ['process', 'Process', 'A · Cercles', '<Steps />'],
  ['faq', 'FAQ', 'A · Pilules', '<Faq />'],
  ['preuves', 'Repères chiffrés', 'A · Compteurs', '<Proofs />'],
  ['contact', 'Contact', 'A · Bento', '<Contact />'],
  ['form', 'Formulaire', 'C · Tuiles', '<ProjectForm />'],
  ['blog', 'Liste d\'articles', 'C · À la une', '<PostFeature />'],
  ['tarifs', 'Cartes tarifs', 'C · Bento mis en avant', '<Pricing />'],
  ['footer', 'Footer', 'C · Barre d\'état', '<Footer />'],
] as const;
const S = Object.fromEntries(sections.map(([id, t, d, k], i) => [id, { t, d, k, n: pad(i + 1) }]));
---

<Layout title="Styleguide v2" robots="noindex, nofollow">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2 sg">
    <header class="sg-bar r">
      <div class="w sg-bar-in">
        <a href="/v2" class="v2-logo">jonlabs<span>.</span></a>
        <nav class="sg-toc" aria-label="Sommaire">{sections.map(([id, t], i) => <a href={`#${id}`} data-toc={id} title={t}>{pad(i + 1)}</a>)}</nav>
        <a href="/v2" class="v2-btn v2-btn-sm"><span data-roll>Voir la home</span></a>
      </div>
    </header>

    <section class="r">
      <div class="w v2-head v2-head-2 sg-intro">
        <h1 class="v2-h1">Styleguide v2<br /><span class="v2-dim">les composants validés.</span></h1>
        <div>
          <p class="v2-head-p">Un élément, une direction. Chaque bloc est le vrai composant, celui de la home.</p>
          <p class="v2-meta sg-intro-meta"><span>Validé le 17.11.2026</span><span>Anime.js 4.5</span><span>Paper shaders</span><span>Hairline</span></p>
        </div>
      </div>
    </section>

    <!-- 01 Fondations -->
    <section class="r sg-sec" id="fondations"><div class="w sg-head"><span class="sg-n">{S.fondations.n}</span><h2>{S.fondations.t}</h2><p class="v2-mut">{S.fondations.d} <code>{S.fondations.k}</code></p></div></section>
    <section class="r">
      <div class="w sg-found">
        <div class="sg-cell">
          <p class="sg-k">Couleurs</p>
          <ul class="sg-swatches">
            {[['--bg', '#FFFFFF', 'Fond'], ['--soft', '#F4F4F2', 'Contraste'], ['--ink', '#14161A', 'Texte'], ['--mut', '#686C70', 'Secondaire'], ['--line', '#E3E4E1', 'Filets'], ['--accent', '#00D9A3', 'Signal'], ['--accent-strong', '#00A87D', 'Teal lisible'], ['--dark', '#111214', 'Section sombre']].map(([t, h, l]) => (
              <li><span style={`background:${h}`}></span><b>{l}</b><code>{t} · {h}</code></li>
            ))}
          </ul>
        </div>
        <div class="sg-cell">
          <p class="sg-k">Typographie</p>
          <p class="v2-h1 sg-spec-h1">Funnel Display</p>
          <p class="v2-h2 sg-spec-h2">Titres, -0.055em <span class="v2-dim">et 2e ligne grisée.</span></p>
          <p class="sg-spec-body">Inter Tight pour le texte courant : 16px, interligne 1.55. Lisible, neutre, compacte.</p>
          <p class="v2-meta">Fragment Mono · métadonnées · 0.75rem</p>
        </div>
        <div class="sg-cell">
          <p class="sg-k">Mouvement <span class="v2-mut">survole les pistes</span></p>
          <div class="sg-ease">
            {[['out', 'cubic-bezier(.2,.8,.2,1)', '300ms', 'Entrées, hovers'], ['in-out', 'cubic-bezier(.65,0,.35,1)', '450ms', 'Déplacements à l\'écran'], ['press', 'ease-out', '160ms', 'Pression d\'un bouton']].map(([k, c, d, u]) => (
              <div class="sg-track" style={`--e:${c};--d:${d}`}><i></i><span class="v2-meta">{k} · {d}</span><span class="v2-mut">{u}</span></div>
            ))}
          </div>
          <p class="sg-k sg-k-gap">Rayons</p>
          <div class="sg-radii"><span style="border-radius:0">0 · cadre</span><span style="border-radius:5px">5px · max</span><span style="border-radius:999px">pilule · boutons</span></div>
        </div>
      </div>
    </section>

    <!-- 02 Grille -->
    <section class="r sg-sec" id="grille"><div class="w sg-head"><span class="sg-n">{S.grille.n}</span><h2>{S.grille.t}</h2><p class="v2-mut">{S.grille.d} <code>{S.grille.k}</code></p></div></section>
    <section class="r"><div class="w sg-demo"><p class="v2-mut">Chaque rangée porte une croix aux deux coins bas du container, là où le filet horizontal croise les filets verticaux. Rien à ajouter dans le markup : toute rangée <code>.r &gt; .w</code> l'a.</p></div></section>

    <!-- 03 Boutons -->
    <section class="r sg-sec" id="boutons"><div class="w sg-head"><span class="sg-n">{S.boutons.n}</span><h2>{S.boutons.t}</h2><p class="v2-mut">{S.boutons.d} <code>{S.boutons.k}</code></p></div></section>
    <section class="r">
      <div class="w sg-demo sg-row">
        <a href="#" class="v2-btn"><span data-roll>Réserver un appel</span></a>
        <a href="#" class="v2-btn v2-btn-ghost"><span data-roll>Voir les réalisations</span></a>
        <a href="#" class="v2-btn v2-btn-sm"><span data-roll>Étude de cas</span></a>
        <a href="#" class="v2-btn v2-btn-lg"><i class="ri-lock-line"></i> <span data-roll>Grand bouton</span></a>
        <a href="#" class="v2-btn v2-btn-wa"><i class="ri-whatsapp-line"></i> <span data-roll>WhatsApp</span></a>
        <a href="#" class="v2-wa" aria-label="WhatsApp"><i class="ri-whatsapp-line"></i></a>
      </div>
    </section>

    <!-- 04 Liens -->
    <section class="r sg-sec" id="liens"><div class="w sg-head"><span class="sg-n">{S.liens.n}</span><h2>{S.liens.t}</h2><p class="v2-mut">{S.liens.d} <code>{S.liens.k}</code></p></div></section>
    <section class="r">
      <div class="w sg-demo sg-cols2">
        <p class="v2-prose sg-para">Je construis des <a href="#">agents IA</a> pour des entreprises sans équipe tech. Les détails sont dans <a href="#">mes études de cas</a>.</p>
        <nav class="sg-linklist">{nav.map((n) => <a href="#"><span class="v2-a">{n.label}</span></a>)}</nav>
      </div>
    </section>

    <!-- 05 Nav -->
    <section class="r sg-sec" id="nav"><div class="w sg-head"><span class="sg-n">{S.nav.n}</span><h2>{S.nav.t}</h2><p class="v2-mut">{S.nav.d} <code>{S.nav.k}</code></p></div></section>
    <Nav sticky={false} current="/services" />

    <!-- 06 Dock -->
    <section class="r sg-sec" id="dock"><div class="w sg-head"><span class="sg-n">{S.dock.n}</span><h2>{S.dock.t}</h2><p class="v2-mut">{S.dock.d} <code>{S.dock.k}</code></p></div></section>
    <section class="r"><div class="w sg-demo sg-soft sg-center"><Dock floating={false} /></div></section>

    <!-- 07 Hero -->
    <section class="r sg-sec" id="hero"><div class="w sg-head"><span class="sg-n">{S.hero.n}</span><h2>{S.hero.t}</h2><p class="v2-mut">{S.hero.d} <code>{S.hero.k}</code></p></div></section>
    <div class="sg-hero"><Hero heading="h2" /></div>

    <!-- 08 Fonds -->
    <section class="r sg-sec" id="fonds"><div class="w sg-head"><span class="sg-n">{S.fonds.n}</span><h2>{S.fonds.t}</h2><p class="v2-mut">{S.fonds.d} <code>{S.fonds.k}</code></p></div></section>
    <section class="r"><div class="w v2-head v2-dots v2-teal" data-spot><i class="v2-dots-glow" aria-hidden="true"></i><h2 class="v2-h2">Ce que je construis.</h2></div></section>

    <!-- 09 Titres -->
    <section class="r sg-sec" id="titres"><div class="w sg-head"><span class="sg-n">{S.titres.n}</span><h2>{S.titres.t}</h2><p class="v2-mut">{S.titres.d} <code>{S.titres.k}</code></p></div></section>
    <section class="r"><div class="w v2-head"><h2 class="v2-h2" data-words>Comment je travaille ?<br /><span class="v2-dim">Simple et sans surprise.</span></h2></div></section>

    <!-- 10 Tags -->
    <section class="r sg-sec" id="tags"><div class="w sg-head"><span class="sg-n">{S.tags.n}</span><h2>{S.tags.t}</h2><p class="v2-mut">{S.tags.d} <code>{S.tags.k}</code></p></div></section>
    <section class="r">
      <div class="w sg-demo sg-stack">
        <p class="v2-tags"><span>Freelance</span><i></i><span>IA</span><i></i><span>B2B</span></p>
        <p class="v2-meta"><span>{c0.data.client?.sector}</span><span>{c0.data.project.duration.split('·')[0]}</span>{c0.data.results[0] && <span class="v2-meta-hl">{c0.data.results[0].value} {c0.data.results[0].label}</span>}</p>
        <p class="v2-tools">{promises[1].tools!.map((t) => <span>{t}</span>)}</p>
      </div>
    </section>

    <!-- 11 Cas -->
    <section class="r sg-sec" id="cas"><div class="w sg-head"><span class="sg-n">{S.cas.n}</span><h2>{S.cas.t}</h2><p class="v2-mut">{S.cas.d} <code>{S.cas.k}</code></p></div></section>
    <section class="r"><CaseSpec entry={c0} /></section>

    <!-- 12 Bento -->
    <section class="r sg-sec" id="bento"><div class="w sg-head"><span class="sg-n">{S.bento.n}</span><h2>{S.bento.t}</h2><p class="v2-mut">{S.bento.d} <code>{S.bento.k}</code></p></div></section>
    <section class="r"><Bento /></section>

    <!-- 13 Process -->
    <section class="r sg-sec" id="process"><div class="w sg-head"><span class="sg-n">{S.process.n}</span><h2>{S.process.t}</h2><p class="v2-mut">{S.process.d} <code>{S.process.k}</code></p></div></section>
    <section class="r"><Steps /></section>

    <!-- 14 FAQ -->
    <section class="r sg-sec" id="faq"><div class="w sg-head"><span class="sg-n">{S.faq.n}</span><h2>{S.faq.t}</h2><p class="v2-mut">{S.faq.d} <code>{S.faq.k}</code></p></div></section>
    <section class="r"><Faq /></section>

    <!-- 15 Preuves -->
    <section class="r sg-sec" id="preuves"><div class="w sg-head"><span class="sg-n">{S.preuves.n}</span><h2>{S.preuves.t}</h2><p class="v2-mut">{S.preuves.d} <code>{S.preuves.k}</code></p></div></section>
    <section class="r"><Proofs /></section>

    <!-- 16 Contact -->
    <section class="r sg-sec" id="contact"><div class="w sg-head"><span class="sg-n">{S.contact.n}</span><h2>{S.contact.t}</h2><p class="v2-mut">{S.contact.d} <code>{S.contact.k}</code></p></div></section>
    <section class="r"><Contact /></section>

    <!-- 17 Formulaire -->
    <section class="r sg-sec" id="form"><div class="w sg-head"><span class="sg-n">{S.form.n}</span><h2>{S.form.t}</h2><p class="v2-mut">{S.form.d} <code>{S.form.k}</code></p></div></section>
    <section class="r"><div class="w sg-demo sg-form"><ProjectForm /><p class="v2-mut">Aucun envoi tant que <code>action</code> n'est pas branché.</p></div></section>

    <!-- 18 Blog -->
    <section class="r sg-sec" id="blog"><div class="w sg-head"><span class="sg-n">{S.blog.n}</span><h2>{S.blog.t}</h2><p class="v2-mut">{S.blog.d} <code>{S.blog.k}</code></p></div></section>
    <section class="r"><PostFeature /></section>

    <!-- 19 Tarifs -->
    <section class="r sg-sec" id="tarifs"><div class="w sg-head"><span class="sg-n">{S.tarifs.n}</span><h2>{S.tarifs.t}</h2><p class="v2-mut">{S.tarifs.d} <code>{S.tarifs.k}</code></p></div></section>
    <section class="r"><Pricing /></section>

    <!-- EXPLORATION témoignages (jetable, purgé après choix) — contenu PLACEHOLDER : testimonials (data/v2.ts) -->
    <section class="r sg-sec" id="temoignages"><div class="w sg-head"><span class="sg-n">19b</span><h2>Exploration — Témoignages</h2><p class="v2-mut">3 directions, contenu lorem en attendant les vrais : <code>testimonials</code></p></div></section>

    <!-- A · Grande citation -->
    <section class="r"><div class="w sg-demo mx-label"><span class="sg-n">A</span> <strong>Grande citation</strong></div></section>
    <section class="r"><div class="w txA">
      <div class="txA-main">
        <p class="txA-mark" aria-hidden="true">“</p>
        <blockquote class="v2-head-p txA-q">{testimonials[0].quote}</blockquote>
        <p class="v2-meta"><strong class="txA-name">{testimonials[0].name}</strong><span>{testimonials[0].role}, {testimonials[0].company}</span></p>
      </div>
      <ol class="txA-list">
        {testimonials.map((t, i) => (
          <li class:list={{ 'is-on': i === 0 }}><span class="sg-n">{String(i + 1).padStart(2, '0')}</span><span>{t.company}</span><span class="v2-meta">{t.result}</span></li>
        ))}
      </ol>
    </div></section>

    <!-- B · Mur à filets -->
    <section class="r"><div class="w sg-demo mx-label"><span class="sg-n">B</span> <strong>Mur à filets</strong></div></section>
    <section class="r"><div class="w txB">
      {testimonials.map((t, i) => (
        <figure class:list={['txB-cell', { 'txB-wide': i === 0 }]}>
          <p class="v2-meta txB-res">{t.result}</p>
          <blockquote>{t.quote}</blockquote>
          <figcaption><span class="txB-av" aria-hidden="true">{t.company.slice(-1)}</span><span><strong>{t.name}</strong><span class="v2-meta">{t.role} · {t.company}</span></span></figcaption>
        </figure>
      ))}
    </div></section>

    <!-- C · Bande défilante -->
    <section class="r"><div class="w sg-demo mx-label"><span class="sg-n">C</span> <strong>Bande défilante</strong></div></section>
    <section class="r txC">
      {[0, 1].map((row) => (
        <div class:list={['txC-track', { 'txC-rev': row === 1 }]}>
          {[...testimonials, ...testimonials].map((t) => (
            <figure class="txC-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption class="v2-meta"><span>{t.name}</span><span>{t.company}</span></figcaption>
            </figure>
          ))}
        </div>
      ))}
    </section>

    <style>
      .mx-label { padding-top: 22px; padding-bottom: 22px; display: flex; gap: 12px; align-items: baseline; }
      blockquote { margin: 0; }
      /* A */
      .txA { display: grid; grid-template-columns: 1.7fr 1fr; }
      .txA-main { padding: clamp(40px, 6vw, 72px) var(--pad); border-right: 1px solid var(--line); }
      .txA-mark { font-family: var(--display); font-size: 6rem; line-height: .6; color: var(--accent-strong); margin: 0 0 8px; }
      .txA-q { font-size: clamp(1.5rem, 2.8vw, 2.3rem); margin-bottom: 28px; }
      .txA-name { color: var(--ink); font-weight: 400; }
      .txA-list { list-style: none; margin: 0; padding: 0; display: grid; }
      .txA-list li { display: grid; grid-template-columns: 36px 1fr auto; gap: 12px; align-items: baseline; padding: 22px var(--pad); color: var(--mut); cursor: pointer; transition: background .2s, color .2s; }
      .txA-list li + li { border-top: 1px solid var(--line); }
      .txA-list li.is-on, .txA-list li:hover { background: var(--soft); color: var(--ink); }
      /* B */
      .txB { display: grid; grid-template-columns: repeat(3, 1fr); }
      .txB-cell { margin: 0; padding: 32px var(--pad); display: flex; flex-direction: column; gap: 18px; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .txB-cell:nth-child(1), .txB-cell:nth-child(3) { border-left: 0; }
      .txB-cell:nth-last-child(-n+2) { border-bottom: 0; }
      .txB-wide { grid-column: span 2; background: var(--soft); }
      .txB-wide blockquote { font-family: var(--display); font-size: clamp(1.4rem, 2.4vw, 1.9rem); letter-spacing: -0.04em; line-height: 1.15; }
      .txB-res { color: var(--accent-strong); }
      .txB-cell figcaption { margin-top: auto; display: flex; gap: 12px; align-items: center; }
      .txB-cell figcaption > span:last-child { display: grid; }
      .txB-av { width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-family: var(--display); }
      /* C */
      .txC { overflow: hidden; padding: 16px 0; display: grid; gap: 16px; }
      .txC-track { display: flex; gap: 16px; width: max-content; animation: v2-marquee 60s linear infinite; }
      .txC-rev { animation-direction: reverse; }
      .txC:hover .txC-track { animation-play-state: paused; }
      .txC-card { margin: 0; width: 380px; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--r); display: grid; gap: 16px; background: var(--bg); }
      .txC-card figcaption { gap: 10px; }
      @media (prefers-reduced-motion: reduce) { .txC-track { animation: none; } }
      @media (max-width: 900px) { .txA, .txB { grid-template-columns: 1fr; } .txA-main { border-right: 0; border-bottom: 1px solid var(--line); } .txB-wide { grid-column: auto; } .txB-cell { border-left: 0; border-bottom: 1px solid var(--line); } .txC-card { width: 300px; } }
    </style>

    <!-- 20 Footer -->
    <section class="r sg-sec" id="footer"><div class="w sg-head"><span class="sg-n">{S.footer.n}</span><h2>{S.footer.t}</h2><p class="v2-mut">{S.footer.d} <code>{S.footer.k}</code></p></div></section>
    <Footer />
  </div>
</Layout>

<script>
  import '../../scripts/v2-ui';

  // Sommaire : section courante surlignée.
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => a.classList.toggle('is-on', a.dataset.toc === e.target.id));
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('.sg-sec').forEach((s) => obs.observe(s));
  document.querySelectorAll<HTMLElement>('.sg-track').forEach((t) => t.style.setProperty('--tw', `${t.clientWidth - 52}px`));
  // Démo : les liens « # » et le formulaire ne partent nulle part.
  document.querySelectorAll('.sg a[href="#"]:not([data-top-link])').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
  document.querySelector('.sg-form form')?.addEventListener('submit', (e) => e.preventDefault());
</script>

---
// STYLEGUIDE v2 (branche rebrand-v2, noindex). Exploration : chaque élément du site en 3 essais (A/B/C).
// Jonathan coche un essai par élément ; le récap en bas se copie. Les essais écartés ne survivront que dans git.
// Base commune : src/styles/v2.css (tokens + composants de /v2). Ici : .sg-* (cadre du styleguide) et .x-* (essais).
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DitherBg from '../../components/v2/DitherBg.tsx';
import { author } from '../../sample';
import { WHATSAPP, nav, steps, stepDetails, promises, builds, faqs, socials } from '../../data/v2';
import '../../styles/v2.css';
import '../../styles/v2-styleguide.css';

const allCases = (await getCollection('portfolio', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cases = allCases.filter((p) => p.data.featured).slice(0, 3);
const c0 = cases.find((c) => c.data.client?.sector) ?? cases[0];

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Repères réels tirés des études de cas (1 par cas).
const proofs = allCases
  .filter((c) => c.data.results?.[0])
  .slice(0, 4)
  .map((c) => ({ value: c.data.results[0].value, label: c.data.results[0].label, client: c.data.title }));

const fmt = (d: Date) => d.toLocaleDateString('fr-CH', { day: '2-digit', month: '2-digit', year: 'numeric' });
const built = fmt(new Date());
const pad = (n: number) => String(n).padStart(2, '0');

// Sommaire : id, titre, rôle. L'ordre fait la numérotation.
const sections = [
  ['fondations', 'Fondations', 'Couleurs, typo, rayons, easing. La référence, sans essais.'],
  ['grille', 'Cadre de grille', 'Ce qui fait la signature « tech » de chaque section.'],
  ['boutons', 'Boutons', 'Primaire, secondaire, petit, WhatsApp.'],
  ['liens', 'Liens texte', 'Dans un paragraphe et dans une liste.'],
  ['nav', 'Navigation haute', 'Logo, 4 liens, appel à l\'action.'],
  ['dock', 'Dock bas', 'Remplace la nav haute après 240px de scroll.'],
  ['hero', 'Hero', 'Le premier écran. Une phrase, une preuve d\'ambiance, un bouton.'],
  ['fonds', 'Fonds de section', 'Mouvement discret derrière un en-tête.'],
  ['titres', 'Titres animés', 'Entrée d\'un titre de section.'],
  ['tags', 'Tags et métadonnées', 'Mots du hero, ligne mono des cas.'],
  ['cas', 'Étude de cas', 'Carte de réalisation, home et liste.'],
  ['bento', 'Bento services', 'Ce que je construis, en 4 cases.'],
  ['process', 'Process', 'Comment je travaille, en 6 étapes.'],
  ['faq', 'FAQ', 'Les questions qu\'on me pose.'],
  ['preuves', 'Repères chiffrés', 'Des chiffres réels tirés des études de cas.'],
  ['contact', 'Contact', 'Le dernier écran avant l\'agenda.'],
  ['form', 'Formulaire', 'Demande de projet (devis sur mesure).'],
  ['blog', 'Liste d\'articles', 'Home, hub et page blog.'],
  ['footer', 'Footer', 'Fin de page.'],
] as const;
const S = Object.fromEntries(sections.map(([id, t, d], i) => [id, { id, t, d, n: pad(i + 1) }]));

// Partis pris par essai : [lettre, nom, compromis]. Sert aux en-têtes ET au récap.
const V: Record<string, [string, string, string][]> = {
  grille: [['A', 'Filets seuls', 'Le plus calme. Peu de « tech ».'], ['B', 'Repères en croix', 'Plan d\'architecte. Lisible, signature forte.'], ['C', 'Règle graduée', 'Le plus technique. À doser : un seul endroit.']],
  boutons: [['A', 'Pilule nette', 'L\'actuel, poli : flèche qui glisse, pression à .97.'], ['B', 'Roulement', 'Les lettres roulent au survol. Vivant, reste sobre.'], ['C', 'Signal', 'Le point teal se répand en fond. Le plus marqué.']],
  liens: [['A', 'Trait qui se trace', 'Classique, entre par la gauche, sort par la droite.'], ['B', 'Crochets', 'Mono entre crochets. Très « code ».'], ['C', 'Brouillage', 'Le mot se décode au survol. Pour la nav seulement.']],
  nav: [['A', 'Actuelle', 'Simple, déjà validée.'], ['B', 'Pastille glissante', 'Un fond suit le lien survolé.'], ['C', 'Barre d\'état', 'Heure de Genève et statut en mono.']],
  dock: [['A', 'Actuel', 'Avatar, liens, agenda.'], ['B', 'Pastille glissante', 'Même geste que la nav B.'], ['C', 'Progression', 'Un anneau autour du bouton suit la lecture.']],
  hero: [['A', 'Réseau iso', 'L\'actuel : impulsions sur grille isométrique.'], ['B', 'Trame', 'Shader tramé teal très pâle, titre lettre à lettre.'], ['C', 'Console d\'agent', 'Le titre à gauche, un agent qui travaille à droite.']],
  fonds: [['A', 'Points + projecteur', 'Le pointeur allume la trame.'], ['B', 'Flux', 'Des paquets circulent sur des pistes.'], ['C', 'Balayage', 'Une ligne de scan traverse la grille.']],
  titres: [['A', 'Mots qui montent', 'Entrée classique, la plus lisible.'], ['B', 'Décodage', 'La 2e ligne se décode. Signature IA.'], ['C', 'Gris vers noir', 'Lié au scroll. Pour les paragraphes longs.']],
  tags: [['A', 'Étoiles', 'L\'actuel. Doux.'], ['B', 'Crochets', 'Mono, slash, crochets.'], ['C', 'Puces d\'état', 'Clé : valeur, point qui pulse.']],
  cas: [['A', 'Bord à bord', 'L\'actuel : grande image, ligne mono.'], ['B', 'Fiche technique', 'Image + tableau de spécifications.'], ['C', 'Index', 'Une ligne par projet, l\'image suit le curseur.']],
  bento: [['A', 'Figures iso', 'L\'actuel, figures Hairline animées.'], ['B', 'Projecteur', 'La lumière suit le pointeur de case en case.'], ['C', 'Fiche', 'Numéros, la stack apparaît au survol.']],
  process: [['A', 'Cercles', 'L\'actuel. Graphique, peu d\'info.'], ['B', 'Frise', 'La ligne se trace au scroll.'], ['C', 'Onglets', 'Une étape à la fois, avec son détail (Zag).']],
  faq: [['A', 'Pilules', 'L\'actuel. Fort visuellement.'], ['B', 'Lignes', 'Accordéon pleine largeur (Zag).'], ['C', 'Index + panneau', 'Questions à gauche, réponse à droite.']],
  preuves: [['A', 'Compteurs', 'Les chiffres défilent à l\'entrée.'], ['B', 'Tableau', 'Sobre, se lit comme un relevé.'], ['C', 'Affichage unique', 'Un repère à la fois, qui se décode.']],
  contact: [['A', 'Bento', 'L\'actuel.'], ['B', 'Adresse géante', 'Un clic copie l\'adresse.'], ['C', 'Canaux', 'Trois façons de me parler, en lignes.']],
  form: [['A', 'Champs bordés', 'Le plus clair.'], ['B', 'Soulignés', 'Étiquette flottante, plus éditorial.'], ['C', 'Tuiles', 'On choisit avant d\'écrire.']],
  blog: [['A', 'Lignes', 'Date, titre, durée. Rapide à scanner.'], ['B', 'Cartes', 'Avec image.'], ['C', 'À la une', 'Le dernier en grand, les autres à côté.']],
  footer: [['A', 'Actuel', 'Colonnes.'], ['B', 'Signature géante', 'Le logo occupe toute la largeur.'], ['C', 'Barre d\'état', 'Heure, mise à jour, retour en haut.']],
};
const recap = sections.filter(([id]) => V[id]).map(([id, t]) => ({ id, t, n: S[id].n, opts: V[id] }));
---

<Layout title="Styleguide v2 — essais" robots="noindex, nofollow">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2 sg">
    <!-- Barre du styleguide : sommaire + compteur de choix -->
    <header class="sg-bar r">
      <div class="w sg-bar-in">
        <a href="/v2" class="v2-logo">jonlabs<span>.</span></a>
        <nav class="sg-toc" aria-label="Sommaire">
          {sections.map(([id, t], i) => <a href={`#${id}`} data-toc={id} title={t}>{pad(i + 1)}</a>)}
        </nav>
        <a href="#recap" class="v2-btn v2-btn-sm"><span data-count>0</span>/{recap.length} choisis</a>
      </div>
    </header>

    <!-- Intro -->
    <section class="r">
      <div class="w v2-head v2-head-2 sg-intro">
        <h1 class="v2-h1">Styleguide v2<br /><span class="v2-dim">trois essais par élément.</span></h1>
        <div>
          <p class="v2-head-p">Coche un essai par élément. Le récap en bas se copie et me revient.</p>
          <p class="v2-meta sg-intro-meta"><span>{recap.length} éléments</span><span>{recap.length * 3} essais</span><span>Anime.js 4.5</span><span>Zag 1.48</span><span>Paper shaders</span></p>
        </div>
      </div>
    </section>

    <!-- ============ 01 FONDATIONS ============ -->
    <section class="r sg-sec" id="fondations">
      <div class="w sg-head"><span class="sg-n">{S.fondations.n}</span><h2>{S.fondations.t}</h2><p class="v2-mut">{S.fondations.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-found">
        <div class="sg-cell">
          <p class="sg-k">Couleurs</p>
          <ul class="sg-swatches">
            {[['--bg', '#FFFFFF', 'Fond'], ['--soft', '#F4F4F2', 'Contraste'], ['--ink', '#14161A', 'Texte'], ['--mut', '#686C70', 'Secondaire'], ['--line', '#E3E4E1', 'Filets'], ['--accent', '#00D9A3', 'Signal'], ['--accent-strong', '#00A87D', 'Teal lisible'], ['--dark', '#111214', 'Section sombre']].map(([t, h, l]) => (
              <li><span style={`background:${h}`}></span><b>{l}</b><code>{t} · {h}</code></li>
            ))}
          </ul>
        </div>
        <div class="sg-cell">
          <p class="sg-k">Typographie</p>
          <p class="v2-h1 sg-spec-h1">Funnel Display</p>
          <p class="v2-h2 sg-spec-h2">Titres, -0.055em <span class="v2-dim">et 2e ligne grisée.</span></p>
          <p class="sg-spec-body">Inter Tight pour le texte courant : 16px, interligne 1.55. Lisible, neutre, compacte.</p>
          <p class="v2-meta">Fragment Mono · métadonnées · 0.75rem</p>
        </div>
        <div class="sg-cell">
          <p class="sg-k">Mouvement <span class="v2-mut">survole les pistes</span></p>
          <div class="sg-ease">
            {[['out', 'cubic-bezier(.2,.8,.2,1)', '300ms', 'Entrées, hovers'], ['in-out', 'cubic-bezier(.65,0,.35,1)', '450ms', 'Déplacements à l\'écran'], ['press', 'ease-out', '160ms', 'Pression d\'un bouton']].map(([k, c, d, u]) => (
              <div class="sg-track" style={`--e:${c};--d:${d}`}><i></i><span class="v2-meta">{k} · {d}</span><span class="v2-mut">{u}</span></div>
            ))}
          </div>
          <p class="sg-k" style="margin-top:28px">Rayons</p>
          <div class="sg-radii"><span style="border-radius:0">0 · cadre</span><span style="border-radius:5px">5px · max</span><span style="border-radius:999px">pilule · boutons</span></div>
        </div>
      </div>
    </section>

    <!-- ============ 02 GRILLE ============ -->
    <section class="r sg-sec" id="grille">
      <div class="w sg-head"><span class="sg-n">{S.grille.n}</span><h2>{S.grille.t}</h2><p class="v2-mut">{S.grille.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-3">
        {V.grille.map(([L, name, note], i) => (
          <article class="sg-var">
            <header class="sg-var-h"><span class="sg-letter">{L}</span><div><b>{name}</b><span>{note}</span></div><label class="sg-pick"><input type="radio" name="grille" value={L} /><span>Je prends</span></label></header>
            <div class="sg-stage sg-stage-pad">
              <div class:list={['x-frame', `x-frame-${L.toLowerCase()}`]}>
                {['Agents IA', 'Applications', 'Automatisations', 'Intégrations'].map((t, k) => <div><span class="x-coord">{['A1', 'A2', 'B1', 'B2'][k]}</span>{t}</div>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ 03 BOUTONS ============ -->
    <section class="r sg-sec" id="boutons">
      <div class="w sg-head"><span class="sg-n">{S.boutons.n}</span><h2>{S.boutons.t}</h2><p class="v2-mut">{S.boutons.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-3">
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">A</span><div><b>{V.boutons[0][1]}</b><span>{V.boutons[0][2]}</span></div><label class="sg-pick"><input type="radio" name="boutons" value="A" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-pad sg-btns">
            <a href="#" class="v2-btn xa-btn">Réserver un appel <i class="ri-arrow-right-line"></i></a>
            <a href="#" class="v2-btn v2-btn-ghost xa-btn">Voir les réalisations <i class="ri-arrow-right-line"></i></a>
            <div class="v2-ctas"><a href="#" class="v2-btn v2-btn-sm xa-btn">Étude de cas <i class="ri-arrow-right-line"></i></a><a href="#" class="v2-wa xa-btn" aria-label="WhatsApp"><i class="ri-whatsapp-line"></i></a></div>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">B</span><div><b>{V.boutons[1][1]}</b><span>{V.boutons[1][2]}</span></div><label class="sg-pick"><input type="radio" name="boutons" value="B" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-pad sg-btns">
            <a href="#" class="v2-btn xb-btn"><span data-roll>Réserver un appel</span></a>
            <a href="#" class="v2-btn v2-btn-ghost xb-btn"><span data-roll>Voir les réalisations</span></a>
            <div class="v2-ctas"><a href="#" class="v2-btn v2-btn-sm xb-btn"><span data-roll>Étude de cas</span></a><a href="#" class="v2-wa xb-wa" aria-label="WhatsApp"><i class="ri-whatsapp-line"></i></a></div>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">C</span><div><b>{V.boutons[2][1]}</b><span>{V.boutons[2][2]}</span></div><label class="sg-pick"><input type="radio" name="boutons" value="C" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-pad sg-btns">
            <a href="#" class="xc-btn is-solid"><i class="xc-dot"></i><span>Réserver un appel</span></a>
            <a href="#" class="xc-btn"><i class="xc-dot"></i><span>Voir les réalisations</span></a>
            <div class="v2-ctas"><a href="#" class="xc-btn xc-sm"><i class="xc-dot"></i><span>Étude de cas</span></a><a href="#" class="v2-wa xc-wa" aria-label="WhatsApp"><i class="ri-whatsapp-line"></i></a></div>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ 04 LIENS ============ -->
    <section class="r sg-sec" id="liens">
      <div class="w sg-head"><span class="sg-n">{S.liens.n}</span><h2>{S.liens.t}</h2><p class="v2-mut">{S.liens.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-3">
        {V.liens.map(([L, name, note]) => (
          <article class="sg-var">
            <header class="sg-var-h"><span class="sg-letter">{L}</span><div><b>{name}</b><span>{note}</span></div><label class="sg-pick"><input type="radio" name="liens" value={L} /><span>Je prends</span></label></header>
            <div class:list={['sg-stage sg-stage-pad', `xl-${L.toLowerCase()}`]}>
              <p class="sg-para">Je construis des <a href="#">agents IA</a> pour des entreprises sans équipe tech. Les détails sont dans <a href="#">mes études de cas</a>.</p>
              <nav class="sg-linklist">{nav.map((n) => <a href="#" data-scramble={L === 'C' ? '' : undefined}>{n.label}</a>)}</nav>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ 05 NAV ============ -->
    <section class="r sg-sec" id="nav">
      <div class="w sg-head"><span class="sg-n">{S.nav.n}</span><h2>{S.nav.t}</h2><p class="v2-mut">{S.nav.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-1">
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">A</span><div><b>{V.nav[0][1]}</b><span>{V.nav[0][2]}</span></div><label class="sg-pick"><input type="radio" name="nav" value="A" /><span>Je prends</span></label></header>
          <div class="sg-stage">
            <div class="v2-top-in xn-bar"><a href="#" class="v2-logo">jonlabs<span>.</span></a><nav class="v2-top-links">{nav.map((n) => <a href="#">{n.label}</a>)}</nav><a href="#" class="v2-btn v2-btn-sm">Réserver un appel <i class="ri-arrow-right-line"></i></a></div>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">B</span><div><b>{V.nav[1][1]}</b><span>{V.nav[1][2]}</span></div><label class="sg-pick"><input type="radio" name="nav" value="B" /><span>Je prends</span></label></header>
          <div class="sg-stage">
            <div class="v2-top-in xn-bar"><a href="#" class="v2-logo">jonlabs<span>.</span></a><nav class="xn-pill" data-pill>{nav.map((n, i) => <a href="#" aria-current={i === 0 ? 'page' : undefined}>{n.label}</a>)}<i data-pill-bg></i></nav><a href="#" class="v2-btn v2-btn-sm">Réserver un appel <i class="ri-arrow-right-line"></i></a></div>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">C</span><div><b>{V.nav[2][1]}</b><span>{V.nav[2][2]}</span></div><label class="sg-pick"><input type="radio" name="nav" value="C" /><span>Je prends</span></label></header>
          <div class="sg-stage">
            <div class="xn-status v2-meta"><span><i class="xn-live"></i> Genève · <time data-clock>--:--</time></span><span>Agents · Apps · Automatisations</span><span>Ouvert aux projets</span></div>
            <div class="v2-top-in xn-bar"><a href="#" class="v2-logo">jonlabs<span>.</span></a><nav class="v2-top-links xn-idx">{nav.map((n, i) => <a href="#"><sup>{pad(i + 1)}</sup>{n.label}</a>)}</nav><a href="#" class="v2-btn v2-btn-sm">Réserver un appel <i class="ri-arrow-right-line"></i></a></div>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ 06 DOCK ============ -->
    <section class="r sg-sec" id="dock">
      <div class="w sg-head"><span class="sg-n">{S.dock.n}</span><h2>{S.dock.t}</h2><p class="v2-mut">{S.dock.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-1">
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">A</span><div><b>{V.dock[0][1]}</b><span>{V.dock[0][2]}</span></div><label class="sg-pick"><input type="radio" name="dock" value="A" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-soft xd-stage">
            <nav class="v2-dock xd-static"><img src="/images/jonathan-vouilloz.webp" alt="" class="v2-dock-avatar" width="36" height="36" />{nav.map((n) => <a href="#">{n.label}</a>)}<a href="#" class="v2-dock-cta" aria-label="Réserver un appel"><i class="ri-calendar-line"></i></a></nav>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">B</span><div><b>{V.dock[1][1]}</b><span>{V.dock[1][2]}</span></div><label class="sg-pick"><input type="radio" name="dock" value="B" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-soft xd-stage">
            <nav class="v2-dock xd-static xd-b" data-pill><img src="/images/jonathan-vouilloz.webp" alt="" class="v2-dock-avatar" width="36" height="36" />{nav.map((n) => <a href="#">{n.label}</a>)}<i data-pill-bg></i><a href="#" class="v2-dock-cta" aria-label="Réserver un appel"><i class="ri-calendar-line"></i></a></nav>
          </div>
        </article>
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">C</span><div><b>{V.dock[2][1]}</b><span>{V.dock[2][2]}</span></div><label class="sg-pick"><input type="radio" name="dock" value="C" /><span>Je prends</span></label></header>
          <div class="sg-stage sg-stage-soft xd-stage">
            <nav class="v2-dock xd-static"><img src="/images/jonathan-vouilloz.webp" alt="" class="v2-dock-avatar" width="36" height="36" />{nav.map((n) => <a href="#">{n.label}</a>)}<a href="#" class="xd-ring" aria-label="Réserver un appel" data-progress><i class="ri-calendar-line"></i></a></nav>
            <p class="v2-meta xd-hint">L'anneau suit ta lecture de cette page</p>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ 07 HERO ============ -->
    <section class="r sg-sec" id="hero">
      <div class="w sg-head"><span class="sg-n">{S.hero.n}</span><h2>{S.hero.t}</h2><p class="v2-mut">{S.hero.d}</p></div>
    </section>
    <section class="r">
      <div class="w sg-vars sg-vars-1">
        <article class="sg-var">
          <header class="sg-var-h"><span class="sg-letter">A</span><div><b>{V.hero[0][1]}</b><span>{V.hero[0][2]}</span></div><label class="sg-pick"><input type="radio" name="hero" value="A" /><span>Je prends</span></label></header>
          <div class="sg-stage">
            <div class="v2-hero xh">
              <canvas class="v2-hero-canvas" data-iso-bg aria-hidden="true"></canvas>
              <div class="v2-hero-in">
                <p class="v2-tags"><span>Freelance</span><i></i><span>IA</span><i></i><span>B2B</span></p>

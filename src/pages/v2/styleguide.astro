            <div class="v2-foot xo-a"><div><a href="#" class="v2-logo">jonlabs<span>.</span></a><p class="v2-mut">Systèmes IA sur mesure · Genève, Suisse romande</p></div><nav>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav><nav><a href={author.youtube}>YouTube</a><a href="https://x.com/jonvolio">X</a><a href={author.linkedin}>LinkedIn</a></nav><nav><a href="/services/creation-site-web" class="v2-mut">Sites & SEO</a><a href="/mentions-legales" class="v2-mut">Mentions légales</a></nav></div>

---
// Home du site (design v2, basculée le 2026-11-17). Copy validée par Jonathan en interview le même jour.
// Grille « à la Sakib » : filets horizontaux pleine largeur (.r), container bordé (.w), cellules qui le remplissent.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { videos, tweets, linkedinPost } from '../data/hub';
import { WHATSAPP, promises } from '../data/v2';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import Hero from '../components/v2/Hero.astro';
import CaseSpec from '../components/v2/CaseSpec.astro';
import Proofs from '../components/v2/Proofs.astro';
import Steps from '../components/v2/Steps.astro';
import Bento from '../components/v2/Bento.astro';
import Faq from '../components/v2/Faq.astro';
import Contact from '../components/v2/Contact.astro';
import Footer from '../components/v2/Footer.astro';
import '../styles/v2.css';
import { organizationData, localBusinessData, websiteData, SITE_URL } from '../data/schema';
import { getWebPageSchema } from '../lib/seo';

const cases = (await getCollection('portfolio', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, linkedinPost ? 1 : 2);

// Chiffres déclarés par Jonathan le 2026-11-17 (interview home).
const proofs = [
  { value: '1000+', label: 'avis Google traités et répondus automatiquement', client: 'Barber Concept' },
  { value: '200+', label: 'mails traités : candidatures, demandes de stage…', client: 'Barber Concept' },
  { value: '100+', label: 'demandes de réservation de séances traitées', client: 'Wildcat Muay Thai' },
  { value: '4 h', label: 'gagnées par semaine sur la gestion admin', client: 'Barber Concept' },
];

const strip = [
  ...(await getCollection('portfolio')).map((p) => p.data.heroImage.url),
  ...videos.map((v) => `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`),
];


const pageTitle = "Développement IA sur mesure à Genève";
const pageDescription = "Des applications où vos équipes et vos agents IA collaborent. Développement IA sur mesure pour PME romandes, livré en 2 à 4 semaines, dès CHF 1'500.";
const schemas = [organizationData, localBusinessData, websiteData, getWebPageSchema({ url: SITE_URL, name: pageTitle, description: pageDescription })];
---

<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav />
    <Dock />

    <!-- 1. HERO -->
    <Hero />

    <!-- 2. BANDE -->
    <div class="r v2-strip" aria-hidden="true">
      <div class="v2-strip-track">{[...strip, ...strip].map((src) => <img src={src} alt="" loading="lazy" />)}</div>
    </div>

    <!-- 3. RÉALISATIONS -->
    <section class="r" id="realisations">
      <div class="w v2-head v2-head-c"><h2 class="v2-h2" data-words>Des solutions qui résolvent<br />de vrais problèmes.</h2></div>
    </section>
    {cases.map((c) => <section class="r"><CaseSpec entry={c} /></section>)}
    <section class="r"><Proofs items={proofs} /></section>
    <section class="r">
      <div class="w v2-more"><a href="/portfolio" class="v2-btn"><span data-roll>Toutes les réalisations</span></a></div>
    </section>

    <!-- 4. COMMENT JE TRAVAILLE -->
    <section class="r">
      <div class="w v2-head v2-head-2">
        <h2 class="v2-h2" data-words>Comment je travaille ?</h2>
        <p class="v2-head-p">Une méthode courte qui part de vos tâches réelles et finit avec un système en production.</p>
      </div>
    </section>
    <section class="r"><Steps /></section>
    <section class="r">
      <div class="w v2-cols3">
        {promises.map((p) => (
          <div class="v2-col">
            <div class="v2-iso v2-iso-sm" data-iso={p.iso} data-theme="light"></div>
            <h3>{p.title}</h3>
            <ul>{p.items.map((i) => <li><i class="ri-arrow-right-s-line"></i>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. CE QUE JE CONSTRUIS (titre en couleur primaire, dans le container) -->
    <section class="r">
      <div class="w v2-head v2-dots v2-teal" data-spot><i class="v2-dots-glow" aria-hidden="true"></i><h2 class="v2-h2" data-words>Ce que je construis.</h2></div>
    </section>
    <section class="r"><Bento /></section>

    <!-- 6. HUB (sombre) -->
    <div class="v2-dark">
      <section class="r">
        <div class="w v2-head"><h2 class="v2-h2" data-words>Ce sur quoi<br /><span class="v2-dim">je travaille en ce moment.</span></h2></div>
      </section>
      <section class="r">
        <div class="w v2-hub">
          <a href={`https://www.youtube.com/watch?v=${videos[0].id}`} class="v2-hub-video" target="_blank" rel="noopener">
            <img src={`https://i.ytimg.com/vi/${videos[0].id}/maxresdefault.jpg`} alt="" loading="lazy" />
            <span class="v2-play"><i class="ri-play-fill"></i></span>
            <span class="v2-hub-cap"><i class="ri-youtube-fill"></i> {videos[0].title}</span>
          </a>
          {tweets.map((t) => (
            <a href={t.url} class="v2-hub-card" target="_blank" rel="noopener">
              <span class="v2-meta"><i class="ri-twitter-x-line"></i> @jonvolio</span>
              <p>{t.text}</p>
            </a>
          ))}
          {posts.map((p) => (
            <a href={`/blog/${p.slug}`} class="v2-hub-card">
              <span class="v2-meta"><i class="ri-article-line"></i> Article · {p.data.readingTime ?? 8} min</span>
              <p>{p.data.h1 ?? p.data.title}</p>
            </a>
          ))}
          {linkedinPost && (
            <a href={linkedinPost.url} class="v2-hub-card" target="_blank" rel="noopener">
              <span class="v2-meta"><i class="ri-linkedin-box-line"></i> LinkedIn</span>
              <p>{linkedinPost.text}</p>
            </a>
          )}
        </div>
      </section>
    </div>

    <!-- 7. À PROPOS -->
    <section class="r">
      <div class="w v2-head v2-about">
        <h2 class="v2-h2" data-words>C'est moi.</h2>
        <p class="v2-reveal" data-reveal>
          Je m'appelle Jonathan. Je construis des systèmes IA pour des entreprises qui n'ont pas d'équipe tech :
          les agents prennent le répétitif, vos équipes gardent ce qui compte. Je préfère un outil simple qui tourne tous les jours à une démo impressionnante qui casse.
        </p>
      </div>
    </section>
    <section class="r">
      <div class="w v2-photos">
        <img src="/images/jonathan-vouilloz.webp" alt="Jonathan Vouilloz" loading="lazy" />
        <img src="/images/jonathan-vouilloz-event.webp" alt="Jonathan Vouilloz lors d'un événement" loading="lazy" width="600" height="750" />
      </div>
    </section>

    <!-- 8. UNE QUESTION AVANT DE VOUS LANCER (section contrastée) -->
    <section class="r">
      <div class="w v2-private">
        <div>
          <h2 class="v2-h2" data-words>Une question avant<br />de vous lancer ?</h2>
          <p class="v2-mut">Pas besoin d'un projet ficelé. Décrivez-moi votre situation en deux lignes, je vous dis si l'IA peut aider.</p>
        </div>
        <div class="v2-private-ctas">
          <a href="/contact#agenda" class="v2-btn v2-btn-lg" data-cal-popup><i class="ri-calendar-line"></i> <span data-roll>Discuter de mon projet</span></a>
          <a href={`https://wa.me/${WHATSAPP}`} class="v2-btn v2-btn-lg v2-btn-wa" target="_blank" rel="noopener"><i class="ri-whatsapp-line"></i> <span data-roll>Écrire sur WhatsApp</span></a>
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="r"><Faq /></section>

    <!-- 10. CONTACT -->
    <section class="r" id="appel"><Contact /></section>

    <!-- 11. AGENDA -->
    <section class="r" id="agenda">
      <div class="w v2-agenda"><div class="v2-cal" id="cal-inline" data-cal></div></div>
    </section>

    <Footer />
  </div>
</Layout>

<script>
  import '../scripts/v2-ui';

</script>

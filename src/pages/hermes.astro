---
// Hermès — offre agent IA (v2, gabarit ServicePage). Prix lus dans src/data/pricing.ts.
import ServicePage from "../components/v2/ServicePage.astro";
import { getWebPageSchema, getBreadcrumbSchema, getFAQPageSchema, getServiceItemSchema } from "../lib/seo";
import { SITE_URL, localBusinessData } from "../data/schema";
import { pricing, chf } from "../data/pricing";

const pageUrl = `${SITE_URL}/hermes`;
const pageTitle = "Agent IA sur mesure pour PME romandes";
const metaDescription = "Conception et déploiement d'agents IA sur mesure pour PME romandes : tri d'e-mails, relances, documents. Prix CHF affichés, validation humaine, conformité nLPD.";

const faqs = [
  { question: "Hermès, c'est un produit fini ou un développement sur mesure ?", answer: "Les deux à la fois. Hermès est un agent IA que j'ai déjà éprouvé sur des tâches concrètes de PME (tri d'e-mails, relances, préparation de documents). On part de cette base éprouvée, puis on le branche sur vos outils et vos process. Vous ne payez pas six mois de R&D : vous récupérez un agent qui tourne, adapté à votre contexte." },
  { question: "Combien ça coûte, concrètement ?", answer: `La mise en place démarre à CHF ${chf(pricing.agentIA.from)} pour un agent sur une tâche précise. Si l'agent doit gérer plusieurs tâches et plusieurs outils, c'est sur devis. Ensuite, l'agent tourne chez Infomaniak, en Suisse, pour environ ${pricing.agentIA.runningCost.replace(' / mois', '')} par mois, que vous payez directement à l'hébergeur.` },
  { question: "Combien de temps avant que l'agent tourne ?", answer: "Comptez deux à trois semaines entre le cadrage et un premier agent en production sur une tâche précise. Pas un chantier de six mois : on vise un résultat mesurable rapidement, puis on élargit le périmètre si ça vaut le coup." },
  { question: "Est-ce que l'agent va envoyer des choses tout seul à mes clients ?", answer: "Seulement si vous le décidez. Par défaut, sur tout ce qui a un enjeu (e-mails clients, devis, relances), l'agent prépare et vous validez avant l'envoi. La validation humaine est un garde-fou câblé dès la configuration, pas une option qu'on ajoute après coup." },
  { question: "Mes données restent-elles en Suisse et conformes nLPD ?", answer: "On cadre dès le départ ce qui sort de chez vous et ce qui reste. Hébergement conforme, minimisation des données envoyées au modèle, et documentation de ce qui transite. Je travaille depuis Genève et je connais les contraintes des PME romandes sur ce point." },
  { question: "Quelle différence avec le guide gratuit sur Hermès ?", answer: "Le guide explique ce qu'est l'agent, ce qu'il fait et ce qu'il coûte si vous l'installez vous-même. Cette page-ci, c'est l'offre : je m'occupe du cadrage, de l'intégration, des garde-fous et de la prise en main pour que vous n'ayez pas à devenir technique. Le guide informe, l'offre livre." },
];

const serviceSchema = getServiceItemSchema("hermes");
const schemas = [
  getWebPageSchema({ url: pageUrl, name: pageTitle, description: metaDescription }),
  getBreadcrumbSchema([
    { name: "Accueil", url: SITE_URL },
    { name: "Consultant IA", url: `${SITE_URL}/consultant-ia` },
    { name: "Hermès", url: pageUrl },
  ]),
  getFAQPageSchema(faqs),
  ...(serviceSchema ? [serviceSchema] : []),
  localBusinessData,
];

const cta = { href: "/contact", label: "Cadrer mon déploiement" };
---

<ServicePage
  title={pageTitle}
  description={metaDescription}
  schemas={schemas}
  head={{
    kicker: "Hermès · l'agent que je déploie chez vous",
    h1: "Un agent IA sur mesure",
    dim: "pour votre PME.",
    lead: "Hermès prend en charge vos tâches répétitives (tri d'e-mails, relances, préparation de documents) et vous rend le temps que vous passez à les faire à la main.",
    cta,
    cta2: { href: "/blog/hermes-agent-ia-pme", label: "Ce qu'est Hermes Agent" },
  }}
  proofs={{ items: [
    { value: chf(pricing.agentIA.from), label: "CHF, mise en place", client: "Agent simple" },
    { value: "2 à 3", label: "semaines jusqu'à la production", client: "Une tâche précise" },
    { value: pricing.agentIA.runningCost.replace('CHF ', '').replace(' / mois', ''), label: "CHF par mois de fonctionnement", client: "Hébergé en Suisse" },
  ] }}
  sections={[
    {
      id: "capacites", kicker: "01 · Capacités", title: "Ce que fait", dim: "Hermès.",
      text: "Pas une démo de labo. Des tâches réelles de PME, avec la validation humaine là où elle compte.",
      subs: [
        { title: "Tri et priorisation des e-mails", text: "Il lit votre boîte de réception, repère ce qui est prioritaire et prépare des réponses contextualisées en tenant compte de l'historique. Vous gardez la main sur l'envoi." },
        { title: "Relances clients autonomes", text: "Il suit l'état de vos devis ouverts et génère des relances personnalisées selon le contexte (date de l'offre, montant, historique). Zéro devis oublié." },
        { title: "Préparation de documents", text: "À partir du contexte d'un prospect et de vos offres, il structure une proposition commerciale en quelques minutes. Un premier jet au lieu d'une page blanche." },
        { title: "Réponses de premier niveau", text: "Il traite les demandes récurrentes et les questions simples, et vous fait remonter ce qui demande un vrai jugement. Votre temps va où il compte." },
        { title: "Veille continue", text: "Il surveille l'activité de vos concurrents ou de votre marché et vous envoie un résumé prêt à lire chaque semaine. 2 à 3 heures récupérées sur la veille manuelle." },
        { title: "Intégration à vos outils", text: "On le branche sur ce que vous utilisez déjà (boîte mail, CRM, facturation) plutôt que de tout remplacer. La mémoire persistante lui évite de repartir de zéro à chaque fois." },
      ],
    },
    {
      id: "terrain", kicker: "02 · Sur le terrain", title: "Des exemples", dim: "de PME romandes.",
      text: "Voici à quoi ressemble Hermès une fois branché sur un vrai métier.",
      subs: [
        { meta: "Fiduciaire à Lausanne", title: "Pièces manquantes relancées", text: "Relances automatiques des pièces manquantes avant les décomptes, avec un résumé hebdomadaire des dossiers en retard. Le collaborateur valide, l'agent rédige." },
        { meta: "Agence de communication à Genève", title: "Veille et propositions", text: "Veille concurrentielle sur cinq comptes clients et pré-rédaction des propositions commerciales. Le premier jet passe d'une heure à dix minutes." },
        { meta: "Régie immobilière", title: "E-mails des locataires triés", text: "Tri des e-mails entrants par urgence et préparation des réponses de premier niveau aux locataires. Les cas sensibles remontent directement au gestionnaire." },
        { meta: "PME de services (5-15 personnes)", title: "Devis suivis", text: "Suivi des devis ouverts et relances contextualisées selon l'historique client. Le dirigeant approuve avant chaque envoi, rien ne part sans son feu vert." },
      ],
    },
    {
      id: "offre", kicker: "03 · L'offre", title: "Des prix affichés,", dim: "en CHF.",
      text: "Vous voyez le prix de départ et le coût mensuel avant de me contacter.",
      price: { value: pricing.agentIA.display, note: `Puis ${pricing.agentIA.runningCost} de fonctionnement` },
      cta,
      subs: [
        { meta: `Pour démarrer · ${pricing.agentIA.display}`, title: "Agent simple", text: "Une tâche précise qui vous prend du temps chaque semaine.", features: ["Audit de vos process et choix de la tâche à automatiser", "Un agent branché sur un outil (boîte mail ou CRM)", "Garde-fous, validation humaine et prise en main"] },
        { meta: "Le plus demandé · Sur devis", title: "Agent métier intégré", text: "Plusieurs tâches et plusieurs outils à connecter.", features: ["Agent multi-tâches connecté à vos outils (CRM, mail, facturation)", "Cadrage nLPD et tests en conditions réelles avant production", "Formation et documentation pour piloter en autonomie"] },
        { title: `Fonctionnement : ${pricing.agentIA.runningCost}`, text: "Hébergement en Suisse chez Infomaniak, payé directement à l'hébergeur. Sans engagement de durée." },
        { title: "Délai de déploiement : 2 à 3 semaines", text: "Entre le cadrage et un premier agent en production sur une tâche précise. On élargit ensuite le périmètre seulement si le gain le justifie." },
      ],
    },
  ]}
  method={{
    title: "Comment", dim: "ça se passe.",
    text: "Une méthode qui part de vos process réels et garde l'humain aux commandes.",
    steps: [
      { title: "Cadrage", text: "On regarde vos process réels et on repère les 2-3 tâches qui pèsent le plus. Je vous dis franchement où Hermès aide et où il n'apporte rien. Pas de promesse en l'air." },
      { title: "Intégration", text: "Je branche l'agent sur vos outils et je le configure sur la première tâche. Un résultat en production en deux à trois semaines, pas un chantier interminable." },
      { title: "Garde-fous", text: "Validation humaine sur ce qui l'exige, cadrage des données (ce qui sort, ce qui reste chez vous), hébergement conforme nLPD. L'agent ne décide pas à votre place." },
      { title: "Prise en main", text: "Je forme votre équipe à l'usage quotidien. L'objectif n'est jamais de vous rendre dépendant : c'est de vous donner un outil qui tourne et que vous pilotez." },
    ],
  }}
  links={[{
    title: "Pour creuser", dim: "le sujet.",
    items: [
      { href: "/consultant-ia", k: "Systèmes IA", label: "Consultant IA à Genève", text: "La page de référence sur les systèmes IA pour PME romandes : méthode, types d'agents, conformité et tarifs." },
      { href: "/blog/hermes-agent-ia-pme", k: "Guide", label: "Hermes Agent, c'est quoi", text: "Le projet open source dont part Hermès : ce qu'il fait, ses limites et ce qu'il coûte si vous l'installez vous-même." },
      { href: "/blog/openclaw-pme-suisse", k: "Article", label: "OpenClaw pour PME", text: "L'autre agent IA open source, orienté usage individuel et mobile. Comparaison honnête avec Hermès." },
      { href: "/blog/workflows-vs-agents-ia-pme", k: "Article", label: "Workflows vs agents IA", text: "Quand un simple automatisme suffit, et quand il faut vraiment un agent qui raisonne." },
    ],
  }]}
  faq={faqs}
  contact="Premier échange gratuit, sans engagement. On identifie les 2-3 tâches qui vous prennent le plus de temps, et je vous dis franchement si Hermès y répond."
/>

---
// Étude de cas / side-project v2 · « dossier technique » (proto créatif validé le 2026-11-17).
// En-tête en bento (titre + chiffre clé en cellule teal + bandeau de fiche), tableau des résultats en chiffres
// géants, défi révélé au scroll, approche en chapitres, captures en pellicule horizontale + lightbox,
// choix en section sombre. Les sections sans données (side-projects : ni client ni résultats) sont omises.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/v2/Nav.astro';
import Dock from '../../components/v2/Dock.astro';
import Footer from '../../components/v2/Footer.astro';
import DitherBg from '../../components/v2/DitherBg.tsx';
import '../../styles/v2.css';
import { SITE_URL, organizationData } from '../../data/schema';
import { getBreadcrumbSchema, type JSONLDSchema } from '../../lib/seo';
import { inlineLinks } from '../../lib/markdown';
import { portfolioServiceLinks } from '../../data/portfolio-relations';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio', ({ data }) => !data.draft);
  // Tri par date décroissante : fallback des « autres dossiers » (même catégorie d'abord).
  const sorted = [...entries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry) => {
    const others = sorted.filter((e) => e.slug !== entry.slug);
    const same = others.filter((e) => e.data.project.category === entry.data.project.category);
    return {
      params: { slug: entry.slug },
      props: { entry, related: [...same, ...others.filter((e) => !same.includes(e))].slice(0, 3) },
    };
  });
}

const { entry, related } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const service = portfolioServiceLinks[entry.slug];
const isSide = d.entryType === 'side-project';
const statusLabels = { live: 'En ligne', 'en-cours': 'Accompagnement en cours', archive: 'Archivé' };
const categoryLabels = { 'site-vitrine': 'Site vitrine', 'e-commerce': 'E-commerce', seo: 'SEO', automatisation: 'Automatisation', application: 'Application', 'side-project': 'Side-project' };
const date = d.date.toLocaleDateString('fr-CH', { year: 'numeric', month: 'long' });
const [key] = d.results;
const band = [
  ['Client', d.client?.name ?? 'Projet personnel'],
  ['Secteur', d.client?.sector],
  ['Durée', d.project.duration],
  ['Période', d.project.period],
  ['Mesure', d.project.measurementPeriod],
  ['Plateforme', d.project.platform],
].filter(([, v]) => v);
const side = [
  ['Le client', d.context?.clientDescription],
  ['Pourquoi ce projet', d.context?.whyThisProject],
].filter(([, v]) => v) as [string, string][];
const insights = d.learnings?.insights ?? [];
const limits = d.learnings?.limitations ?? [];
const factors = d.successFactors ?? [];
const shots = d.resultImages ?? [];
const hasBody = entry.body.trim().length > 0;
const pad = (i: number) => String(i).padStart(2, '0');
// Le compteur de v2-ui lit « préfixe + nombre + suffixe » et réécrit la virgule en point :
// on ne l'active que si la valeur finale reste identique (pas « 1,74 M », « 15'400 », « 6,6 »).
const countable = (v: string) => {
  const m = v.match(/^(\D*)(\d+(?:[.,]\d+)?)(.*)$/);
  return !!m && !/^['’]\d/.test(m[3]) && !/,|\.\d{2}/.test(m[2]);
};

const toc = [
  d.results.length > 1 && ['resultats', d.resultsTitle],
  d.context && ['contexte', 'Contexte'],
  d.approach.length > 0 && ['approche', 'Approche'],
  shots.length > 0 && ['captures', d.galleryTitle],
  factors.length > 0 && ['facteurs-succes', d.successFactorsTitle],
  (insights.length > 0 || limits.length > 0) && ['apprentissages', 'Apprentissages'],
  d.testimonial && ['temoignage', 'Témoignage'],
  hasBody && ['recit', 'Le récit'],
].filter(Boolean) as [string, string][];

// Schema.org : étude de cas en Article, client en « about ».
const caseStudySchema: JSONLDSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  image: d.heroImage.url.startsWith('http') ? d.heroImage.url : `${SITE_URL}${d.heroImage.url}`,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Jonathan Vouilloz', url: SITE_URL },
  publisher: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'Jon Labs', url: SITE_URL, logo: organizationData.logo },
  mainEntityOfPage: `${SITE_URL}/portfolio/${entry.slug}`,
};
if (d.client) caseStudySchema.about = { '@type': 'Organization', name: d.client.name, url: d.client.website };
const schemas = [caseStudySchema, getBreadcrumbSchema([
  { name: 'Accueil', url: SITE_URL },
  { name: 'Réalisations', url: `${SITE_URL}/portfolio` },
  { name: d.title, url: `${SITE_URL}/portfolio/${entry.slug}` },
])];
---

<Layout title={d.title} description={d.description} ogImage={d.heroImage.url} ogType="article" article={{ publishedTime: d.date, author: 'Jonathan Vouilloz', tags: d.tags }} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </Fragment>

  <div class="v2">
    <Nav current="/portfolio" />
    <Dock current="/portfolio" />

    <main>
      <article>
        <header class="r" id="fiche-projet"><div class="w cas-c-hero">
          <div class="cas-c-title">
            <p class="v2-meta">
              <a href="/portfolio" class="cas-c-back"><i class="ri-arrow-left-line" aria-hidden="true"></i> Réalisations</a>
              <span>{isSide ? 'Side-project' : categoryLabels[d.project.category]}</span><span>{date}</span>
            </p>
            <h1 class="v2-h1" data-chars>{d.title}</h1>
            <div class="cas-c-sub">
              <div>
                <p class="cas-c-lead">{d.description}</p>
                {service && <p class="cas-c-offer"><a href={service.href} class="v2-a">Découvrir l'offre {service.label[0].toLowerCase() + service.label.slice(1)}</a> <i class="ri-arrow-right-line" aria-hidden="true"></i></p>}
              </div>
              {d.tags.length > 0 && <p class="v2-meta cas-c-tags">{d.tags.map((t) => <span>{t}</span>)}</p>}
            </div>
          </div>
          <div class="cas-c-key v2-teal">
            <div class="cas-c-shader" aria-hidden="true"><DitherBg client:visible back="#00D9A3" front="#7FF0CF" /></div>
            {key ? (
              <div class="cas-c-stat">
                <b data-count-to={countable(key.value) ? key.value : undefined}>{key.value}</b>
                <p>{key.label}</p>
              </div>
            ) : (
              <div class="cas-c-stat"><b>{d.project.duration}</b><p>Durée du projet</p></div>
            )}
            <div class="cas-c-aside">
              {d.status && <p class="v2-meta"><span><i class="v2-live"></i>{statusLabels[d.status]}</span></p>}
              {(d.liveUrl || d.client?.website) && (
                <div class="cas-c-links">
                  {d.liveUrl && <a href={d.liveUrl} target="_blank" rel="noopener noreferrer" class="v2-btn v2-btn-sm"><span data-roll>Voir le projet en ligne</span> <i class="ri-arrow-right-up-line" aria-hidden="true"></i></a>}
                  {d.client?.website && d.client.website !== d.liveUrl && <a href={d.client.website} target="_blank" rel="noopener noreferrer" class="v2-btn v2-btn-sm v2-btn-ghost"><span data-roll>Site client</span> <i class="ri-arrow-right-up-line" aria-hidden="true"></i></a>}
                </div>
              )}
            </div>
          </div>
          <dl class="cas-c-band">
            {band.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          {toc.length > 1 && (
            <nav class="cas-c-toc" aria-label="Sommaire">
              <ol class="v2-meta">{toc.map(([id, label], i) => <li><a href={`#${id}`}><span>{pad(i + 1)}</span> {label}</a></li>)}</ol>
            </nav>
          )}
        </div></header>

        <div class="r"><div class="w cas-c-img"><img src={d.heroImage.url} alt={d.heroImage.alt} width="1180" height="664" fetchpriority="high" decoding="async" /></div></div>

        {d.results.length > 1 && (
          <section class="r" id="resultats" aria-labelledby="t-res"><div class="w">
            <div class="cas-c-label"><h2 id="t-res" class="v2-meta">{d.resultsTitle}</h2><span class="v2-meta">{pad(d.results.length)} repères</span></div>
            <ol class="cas-c-board">
              {d.results.map((r, i) => (
                <li>
                  <span class="v2-meta">{pad(i + 1)}</span>
                  <b data-count-to={countable(r.value) ? r.value : undefined}>{r.value}</b>
                  <span class="cas-c-board-txt"><strong>{r.label}</strong>{r.detail && <span class="v2-mut">{r.detail}</span>}</span>
                </li>
              ))}
            </ol>
          </div></section>
        )}

        {d.context && (
          <section class="r" id="contexte" aria-labelledby="t-ctx"><div class="w">
            <div class="cas-c-label"><h2 id="t-ctx" class="v2-meta">{d.context.challenge ? 'Contexte · le défi' : 'Contexte'}</h2></div>
            {d.context.challenge && <p class="v2-reveal cas-c-reveal" data-reveal>{d.context.challenge}</p>}
            {side.length > 0 && (
              <div class="cas-c-side" style={`--cols:${side.length}`}>
                {side.map(([k, v]) => <div><p class="v2-meta">{k}</p><p class="v2-prose" set:html={inlineLinks(v)} /></div>)}
              </div>
            )}
          </div></section>
        )}

        {d.approach.length > 0 && <>
          <div class="r" id="approche"><div class="w cas-c-label cas-c-label-solo"><h2 class="v2-meta">Approche</h2><span class="v2-meta">{pad(d.approach.length)} chapitres</span></div></div>
          {d.approach.map((p) => (
            <section class="r"><div class="w cas-c-ch">
              <div class="cas-c-ch-num"><span aria-hidden="true">{pad(p.phase)}</span></div>
              <div class="cas-c-ch-body">
                <p class="v2-meta">Chapitre {pad(p.phase)}</p>
                <h3 data-words>{p.title}</h3>
                <p class="v2-prose" set:html={inlineLinks(p.description)} />
                {p.tasks && p.tasks.length > 0 && <ul>{p.tasks.map((t) => <li set:html={inlineLinks(t)} />)}</ul>}
                {p.image && (
                  <figure>
                    <button type="button" class="cas-c-zoom" data-lb aria-label={`Agrandir : ${p.image.alt}`}>
                      <img src={p.image.url} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" decoding="async" />
                    </button>
                    {p.image.caption && <figcaption class="v2-mut">{p.image.caption}</figcaption>}
                  </figure>
                )}
              </div>
            </div></section>
          ))}
        </>}

        {shots.length > 0 && (
          <section class="r" id="captures" aria-labelledby="t-gal"><div class="w">
            <div class="cas-c-label">
              <h2 id="t-gal" class="v2-meta">{d.galleryTitle}</h2>
              {shots.length > 1 && (
                <span class="cas-c-film-nav">
                  <button type="button" data-film="-1" aria-label="Capture précédente"><i class="ri-arrow-left-line" aria-hidden="true"></i></button>
                  <button type="button" data-film="1" aria-label="Capture suivante"><i class="ri-arrow-right-line" aria-hidden="true"></i></button>
                </span>
              )}
            </div>
            <div class={`cas-c-film${shots.length === 1 ? ' cas-c-film-1' : ''}`} data-film-track tabindex="0" aria-label="Captures, défilement horizontal">
              {shots.map((img, i) => (
                <figure>
                  <button type="button" class="cas-c-zoom" data-lb aria-label={`Agrandir : ${img.alt}`}>
                    <img src={img.url} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
                  </button>
                  <figcaption><span class="v2-meta">Fig. {pad(i + 1)} / {pad(shots.length)}</span><span>{img.caption ?? img.alt}</span></figcaption>
                </figure>
              ))}
            </div>
          </div></section>
        )}

        {factors.length > 0 && (
          <div class="v2-dark">
            <section class="r" id="facteurs-succes" aria-labelledby="t-fac"><div class="w">
              <div class="v2-head"><h2 class="v2-h2" id="t-fac" data-words>{d.successFactorsTitle}</h2></div>
              <div class="cas-c-fac" style={`--cols:${Math.min(factors.length, 4)}`} data-rise>
                {factors.map((f) => (
                  <div>
                    {f.icon && <i class={f.icon} aria-hidden="true"></i>}
                    <h3>{f.title}</h3>
                    <p class="v2-prose" set:html={inlineLinks(f.description)} />
                  </div>
                ))}
              </div>
            </div></section>
          </div>
        )}

        {(insights.length > 0 || limits.length > 0) && (
          <section class="r" id="apprentissages" aria-labelledby="t-learn"><div class="w">
            <div class="cas-c-label"><h2 id="t-learn" class="v2-meta">Apprentissages</h2></div>
            <div class="cas-c-learn">
              {insights.length > 0 && (
                <div><span class="cas-c-sign" aria-hidden="true">+</span><p class="v2-meta">Ce que j'ai appris</p>
                  <ul>{insights.map((t) => <li class="v2-prose" set:html={inlineLinks(t)} />)}</ul></div>
              )}
              {limits.length > 0 && (
                <div><span class="cas-c-sign" aria-hidden="true">−</span><p class="v2-meta">Limites &amp; améliorations</p>
                  <ul>{limits.map((t) => <li class="v2-prose" set:html={inlineLinks(t)} />)}</ul></div>
              )}
            </div>
          </div></section>
        )}

        {d.testimonial && (
          <section class="r" id="temoignage" aria-label="Témoignage"><div class="w v2-testi-main cas-c-testi">
            <p class="v2-testi-mark" aria-hidden="true">“</p>
            <figure class="v2-testi-fig"><blockquote class="v2-h2">{d.testimonial.quote}</blockquote>
              <figcaption class="v2-meta"><strong>{d.testimonial.author}</strong>{d.testimonial.role && <span>{d.testimonial.role}</span>}</figcaption></figure>
          </div></section>
        )}

        {hasBody && (
          <section class="r" id="recit" aria-labelledby="t-recit"><div class="w">
            <div class="cas-c-label"><p id="t-recit" class="v2-meta">Le récit</p></div>
            <div class="cas-c-recit"><div class="co-prose v2-art-prose cas-c-prose"><Content /></div></div>
          </div></section>
        )}
      </article>

      <section class="r" aria-labelledby="t-next"><div class="w">
        <div class="cas-c-label">
          <h2 id="t-next" class="v2-meta">Autres dossiers</h2>
          <span class="cas-c-label-links">
            {service && <a href={service.href} class="v2-meta cas-c-service"><span class="v2-a">Service lié : {service.label}</span><i class="ri-arrow-right-line" aria-hidden="true"></i></a>}
            <a href="/portfolio" class="v2-meta cas-c-service"><span class="v2-a">Tous les projets</span><i class="ri-arrow-right-line" aria-hidden="true"></i></a>
          </span>
        </div>
        {related.length > 0 && (
          <ul class="cas-c-next">
            {related.map((p) => (
              <li><a href={`/portfolio/${p.slug}`}>
                <img src={p.data.heroImage.url} alt="" width={p.data.heroImage.width} height={p.data.heroImage.height} loading="lazy" decoding="async" />
                <strong>{p.data.title}</strong>
                <span class="v2-meta"><span>{p.data.client?.sector ?? 'Projet personnel'}</span><span>{p.data.date.getFullYear()}</span></span>
                <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
              </a></li>
            ))}
          </ul>
        )}
      </div></section>

      <section class="r"><div class="w v2-head v2-head-2">
        <p class="v2-h2" data-words>Votre projet,<br /><span class="v2-dim">la prochaine étude de cas.</span></p>
        <div class="v2-ctas v2-ctas-left">
          <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Parlons de votre projet</span></a>
          <a href="mailto:contact@jonlabs.ch" class="v2-btn v2-btn-ghost"><span data-roll>contact@jonlabs.ch</span></a>
        </div>
      </div></section>
    </main>

    <Footer />

    <dialog class="cas-c-lb" aria-label="Capture agrandie">
      <button type="button" class="cas-c-lb-close" data-lb-close aria-label="Fermer"><i class="ri-close-line" aria-hidden="true"></i></button>
      <button type="button" class="cas-c-lb-prev" data-lb-step="-1" aria-label="Image précédente"><i class="ri-arrow-left-s-line" aria-hidden="true"></i></button>
      <button type="button" class="cas-c-lb-next" data-lb-step="1" aria-label="Image suivante"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
      <figure>
        <img alt="" />
        <figcaption><span class="v2-meta" data-lb-count></span><span data-lb-cap></span></figcaption>
      </figure>
    </dialog>
  </div>
</Layout>

<script>
  import '../../scripts/v2-ui';

  // Pellicule : les flèches avancent d'une capture.
  const track = document.querySelector<HTMLElement>('[data-film-track]');
  const filmTo = (fig: HTMLElement) => track?.scrollTo({ left: fig.offsetLeft - track.offsetLeft, behavior: 'smooth' });
  document.querySelectorAll<HTMLButtonElement>('[data-film]').forEach((b) => b.addEventListener('click', () => {
    const fig = track?.querySelector('figure');
    if (track && fig) track.scrollBy({ left: Number(b.dataset.film) * (fig.clientWidth + 1), behavior: 'smooth' });
  }));

  // Lightbox : chapitres + pellicule. À la fermeture, la pellicule se cale sur la dernière capture vue.
  const lb = document.querySelector<HTMLDialogElement>('.cas-c-lb')!;
  const lbImg = lb.querySelector('img')!;
  const zooms = [...document.querySelectorAll<HTMLButtonElement>('[data-lb]')];
  let current = 0;
  const show = (i: number) => {
    current = (i + zooms.length) % zooms.length;
    const img = zooms[current].querySelector('img')!;
    const cap = zooms[current].closest('figure')?.querySelector('figcaption span:last-child, figcaption:not(:has(span))');
    lbImg.src = img.currentSrc || img.src;
    lbImg.alt = img.alt;
    lb.querySelector('[data-lb-cap]')!.textContent = cap?.textContent ?? img.alt;
    lb.querySelector('[data-lb-count]')!.textContent = `${current + 1} / ${zooms.length}`;
  };
  zooms.forEach((z, i) => z.addEventListener('click', () => { show(i); lb.showModal(); document.documentElement.style.overflow = 'hidden'; }));
  lb.classList.toggle('cas-c-lb-1', zooms.length < 2);
  lb.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.lbStep))));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
  lb.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    const fig = zooms[current]?.closest<HTMLElement>('[data-film-track] figure');
    if (fig) filmTo(fig);
  });
</script>

<style is:global>
  /* En-tête : titre pleine largeur, puis bandeau teal animé (chiffre clé + liens), fiche et sommaire. */
  .cas-c-hero { display: grid; grid-template-columns: minmax(0, 1fr); }
  .cas-c-title { padding: clamp(44px, 6vw, 80px) var(--pad) clamp(32px, 4vw, 48px); display: grid; gap: 24px; min-width: 0; }
  .v2 .cas-c-title .v2-h1 { font-size: clamp(2.4rem, 5.4vw, 4.6rem); line-height: .94; max-width: 22ch; overflow-wrap: break-word; }
  .cas-c-sub { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px 48px; align-items: end; }
  .v2 .cas-c-back:hover { color: var(--ink); }
  .v2 .cas-c-back { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; }
  .v2 .cas-c-lead { max-width: 36rem; color: var(--mut); font-size: 1.1rem; }
  .v2 .cas-c-offer { margin-top: 12px; display: inline-flex; align-items: center; gap: 6px; }
  .v2 .cas-c-tags { gap: 6px; justify-content: flex-end; }
  .cas-c-tags span { border: 1px solid var(--line); border-radius: var(--r); padding: 3px 8px; }
  .cas-c-key { position: relative; isolation: isolate; overflow: hidden; padding: clamp(28px, 4vw, 44px) var(--pad); display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; flex-wrap: wrap; min-height: 230px; border-top: 1px solid var(--line); }
  .cas-c-shader { position: absolute; inset: 0; z-index: -1;
    -webkit-mask: linear-gradient(100deg, rgba(0,0,0,.2) 15%, #000 70%); mask: linear-gradient(100deg, rgba(0,0,0,.2) 15%, #000 70%); }
  .cas-c-key b { display: block; font-family: var(--display); font-weight: 500; font-size: clamp(3rem, 7vw, 6.4rem); letter-spacing: -0.06em; line-height: .9; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .v2 .cas-c-key b + p { margin-top: 10px; font-size: 1.05rem; max-width: 28rem; }
  .v2 .cas-c-key .v2-meta { color: var(--ink); }
  .cas-c-aside { display: grid; gap: 16px; justify-items: end; }
  .cas-c-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .cas-c-band { grid-column: 1 / -1; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); border-top: 1px solid var(--line); }
  .cas-c-band > div { padding: 16px var(--pad) 18px; display: grid; gap: 6px; align-content: start; font-size: .88rem; line-height: 1.4; }
  .cas-c-band > div + div { border-left: 1px solid var(--line); }
  .cas-c-band dt { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; color: var(--mut); }
  .cas-c-band dd { margin: 0; }
  .cas-c-toc { grid-column: 1 / -1; border-top: 1px solid var(--line); padding: 14px var(--pad); }
  .v2 .cas-c-toc ol { list-style: none; padding: 0; gap: 8px 22px; }
  .cas-c-toc a span { color: var(--accent-strong); }
  .v2 .cas-c-toc a:hover { color: var(--ink); }
  .cas-c-img img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }

  /* Étiquette de section : barre mono pleine largeur */

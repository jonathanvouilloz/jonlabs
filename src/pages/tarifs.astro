---
// Page Tarifs - Jon Labs (v2)
// Grille des offres — prix lus dans src/data/pricing.ts

import Layout from "../layouts/Layout.astro";
import Nav from "../components/v2/Nav.astro";
import Dock from "../components/v2/Dock.astro";
import Pricing from "../components/v2/Pricing.astro";
import Faq from "../components/v2/Faq.astro";
import Footer from "../components/v2/Footer.astro";
import "../styles/v2.css";

import { SITE_URL } from '../data/schema';
import { getWebPageSchema, getBreadcrumbSchema } from '../lib/seo';
import { pricing } from '../data/pricing';

const pageTitle = "Tarifs freelance Genève : site web, app, SEO local, IA";
const pageDescription = "Tarifs clairs en CHF : site web dès 850, référencement local 390 puis 199/mois, agent IA dès 1'500, application mobile sur devis. Freelance à Genève, sans contrat de durée.";

const webPageSchema = getWebPageSchema({
  url: `${SITE_URL}/tarifs`,
  name: pageTitle,
  description: pageDescription
});

// Breadcrumb schema
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Accueil", url: SITE_URL },
  { name: "Tarifs", url: `${SITE_URL}/tarifs` }
]);

// Offres chiffrées (prix = src/data/pricing.ts)
const offerCatalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "@id": `${SITE_URL}/tarifs#catalog`,
  "name": "Tarifs Jon Labs",
  "url": `${SITE_URL}/tarifs`,
  "itemListElement": [
    {
      "@type": "Offer",
      "name": pricing.siteWeb.label,
      "priceSpecification": { "@type": "PriceSpecification", "minPrice": String(pricing.siteWeb.from), "priceCurrency": "CHF" },
      "url": `${SITE_URL}/services/creation-site-web`
    },
    {
      "@type": "Offer",
      "name": pricing.agentIA.label,
      "priceSpecification": { "@type": "PriceSpecification", "minPrice": String(pricing.agentIA.from), "priceCurrency": "CHF" },
      "url": `${SITE_URL}/hermes`
    }
  ]
};

// FAQ — une seule source pour l'affichage et le schema
const faqs = [
  {
    question: "Pourquoi « dès CHF 850 » et pas un prix fixe ?",
    answer: "Un site d'une page et un site de vingt pages avec réservation en ligne n'ont pas le même coût. CHF 850 correspond à un site vitrine simple, sur mesure (site statique rapide). Un site Webflow, que vous gérez vous-même dans l'éditeur, démarre à CHF 950. Le prix annoncé dans le devis est le prix payé.",
  },
  {
    question: "Que comprend le référencement local à CHF 390 + 199/mois ?",
    answer: "Les CHF 390 couvrent la mise en place : audit, corrections du site et optimisation complète de votre fiche Google. Les CHF 199/mois couvrent le suivi : suivi des positions SEO, publication automatisée de posts sur la fiche, réponses aux avis, ajustements du site et un rapport mensuel des évolutions. Aucun contrat de durée : vous arrêtez quand vous voulez, d'un mois à l'autre.",
  },
  {
    question: "Combien coûte un agent IA une fois en place ?",
    answer: "La mise en place démarre à CHF 1'500. Ensuite, l'agent tourne sur un hébergement suisse (Infomaniak) pour environ CHF 10 à 40 par mois, facturés directement par l'hébergeur, sans marge de ma part.",
  },
  {
    question: "Qu'est-ce qui n'est pas inclus ?",
    answer: "Le nom de domaine et l'hébergement du site (quelques dizaines de francs par an), ainsi que les abonnements à des outils tiers. Je vous aide à choisir.",
  },
  {
    question: "Comment se passe le paiement ?",
    answer: "20 % à la signature du devis, 80 % à la livraison. Le suivi mensuel est facturé chaque mois. Tous les prix sont en CHF, hors TVA (exonéré).",
  },
  {
    question: "Est-ce que je m'engage sur une durée ?",
    answer: "Non, aucun contrat de durée minimale. Un projet (site, app, agent IA) est payé une fois. Le suivi mensuel du référencement se résilie d'un mois à l'autre, sans frais ni préavis long. Si le travail est bon, vous n'aurez pas envie de partir.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const schemas = [webPageSchema, breadcrumbSchema, offerCatalog, faqSchema];

const resources = [
  { href: "/blog/prix-site-web-suisse-2026", title: "Combien coûte vraiment un site web en Suisse en 2026 ?", teaser: "Un guide transparent des fourchettes en CHF, par type de projet et par profil de prestataire." },
  { href: "/blog/specialiste-developpement-web-suisse", title: "Spécialiste développement web Suisse : comment bien choisir", teaser: "Freelance vs agence, 5 critères concrets pour choisir le bon prestataire en Suisse romande." },
  { href: "/blog/prix-agent-ia-automatisation-suisse", title: "Combien coûte un agent IA en Suisse ?", teaser: "Les fourchettes en CHF d'un agent IA ou d'une automatisation : mise en place et fonctionnement." },
];
---

<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/tarifs" />
    <Dock current="/tarifs" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <h1 class="v2-h1" data-words>Tarifs clairs.</h1>
        <p class="v2-head-p">Des prix en CHF, aucun contrat de durée. L'appel découverte est gratuit.</p>
      </div></header>

      <section class="r" id="packages" aria-label="Offres"><Pricing /></section>

      <section class="r"><Faq items={faqs.map((f) => ({ q: f.question, a: f.answer }))} /></section>

      <section class="r" aria-labelledby="ressources"><div class="w">
        <div class="v2-head v2-head-2">
          <h2 class="v2-h2" id="ressources" data-words>Aller plus loin.</h2>
          <p class="v2-head-p">Quelques articles pour creuser le sujet avant de vous décider.</p>
        </div>
        <div class="v2-art-rel v2-art-rel-txt">
          {resources.map((r) => (
            <a href={r.href}>
              <strong>{r.title}</strong>
              <span class="v2-mut">{r.teaser}</span>
            </a>
          ))}
        </div>
      </div></section>

      <section class="r"><div class="w v2-head v2-head-2">
        <h2 class="v2-h2" data-words>Prêt à lancer<br /><span class="v2-dim">votre projet ?</span></h2>
        <div class="v2-ctas v2-ctas-left">
          <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Prendre rendez-vous</span></a>
        </div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  import '../scripts/v2-ui';
</script>

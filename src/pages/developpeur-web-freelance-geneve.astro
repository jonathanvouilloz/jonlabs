---
// Développeur freelance à Genève — page identité locale (v2, gabarit ServicePage).
// Arbitrage Q4 (17.11) : URL et « développeur web freelance à Genève » gardés dans le title et le H1,
// corps réécrit en page « freelance à Genève » qui présente les 3 offres, IA d'abord.
// Preuve Lécureux : uniquement via data/proof-lecureux (aucun chiffre en dur). Prix : src/data/pricing.ts.
import ServicePage from "../components/v2/ServicePage.astro";
import { getWebPageSchema, getBreadcrumbSchema, getFAQPageSchema } from "../lib/seo";
import { SITE_URL, localBusinessData } from "../data/schema";
import { proofLecureux } from "../data/proof-lecureux";
import { pricing, terms, chf } from "../data/pricing";

const pageTitle = "Développeur web freelance à Genève : IA, sites et apps";
const pageDescription = "Développeur freelance à Genève : systèmes IA sur mesure, sites web et applications mobiles pour les PME romandes. 8 ans d'expérience, devis transparent en CHF.";
const pageUrl = `${SITE_URL}/developpeur-web-freelance-geneve`;

const faqs = [
  { question: "Pourquoi choisir un freelance plutôt qu'une agence à Genève ?", answer: "Avec un freelance, vous parlez directement à la personne qui code, sans chef de projet intermédiaire. Le tarif est en général 30 à 50% inférieur à une agence pour un travail équivalent, parce qu'il n'y a pas de locaux, de commerciaux ni de fonctions support à financer. L'agilité est aussi supérieure : décisions rapides, ajustements en cours de route, première version livrée en 2-3 semaines. L'agence reste pertinente pour des projets très volumineux qui demandent plusieurs profils en parallèle (design, dev, marketing, ops)." },
  { question: "Quel est le tarif d'un développeur freelance à Genève ?", answer: `Chez Jon Labs, un agent IA démarre à CHF ${chf(pricing.agentIA.from)}, un site web à CHF ${chf(pricing.siteWeb.from)} (CHF ${chf(pricing.webflow.from)} sur Webflow). Les applications mobiles et les formations IA sont chiffrées sur devis. Le devis est forfaitaire : vous connaissez le coût total avant de signer.` },
  { question: "Combien de temps pour créer un site web ?", answer: "Un site vitrine est livré en 3 à 4 semaines, un site sur-mesure avec blog et intégrations en 6 à 8 semaines, une application web en 2 à 3 mois selon la complexité. Le délai dépend surtout de la rapidité avec laquelle vous pouvez fournir vos contenus (textes, photos, accès) et valider les étapes intermédiaires." },
  { question: "Travaillez-vous avec des clients hors Genève ?", answer: "Oui. Je travaille régulièrement avec des clients de Lausanne, Vevey, Montreux, Sion, Sierre, Nyon et Morges, ainsi qu'avec des entreprises basées en zone frontalière française (Annemasse, Gaillard, Saint-Julien). La plupart des échanges se font en visio, avec des rendez-vous en personne quand vous êtes de passage à Genève ou quand le projet le justifie." },
  { question: "Faut-il être à Genève pour vous engager ?", answer: "Non. Toute la collaboration peut se faire à distance : visio, partage d'écran, accès staging, démos vidéo. Être basé à Genève apporte simplement deux avantages aux clients romands : possibilité de se voir en personne pour le brief ou les ateliers, et bonne connaissance du marché local (LPD, facturation CHF, attentes des clients suisses)." },
  { question: "Quelles technologies utilisez-vous ?", answer: "Stack moderne : Astro et Next.js pour les sites web, Svelte ou React pour les applications, TypeScript et Tailwind CSS partout, Supabase pour la base de données, Vercel et Cloudflare pour l'hébergement. Pour les sites vitrines avec CMS visuel, j'utilise aussi Webflow et Framer selon le profil du client. Le choix se fait toujours en fonction du projet, pas d'un dogme technique." },
  { question: "Vous faites du WordPress ?", answer: "Pas par défaut. WordPress reste pertinent pour certains cas (gros blog éditorial, équipe habituée), mais sur la plupart des projets de PME romandes, c'est une mauvaise réponse en 2026 : performance Google médiocre, mises à jour permanentes, vulnérabilités, plugins qui se cassent. Je propose des stacks plus rapides et plus sûres dès que c'est possible. Si vous avez un site WordPress existant, je peux faire la migration." },
  { question: "Comment se passe le paiement ?", answer: `Facturation en CHF, par virement bancaire ou TWINT. ${terms.payment.charAt(0).toUpperCase() + terms.payment.slice(1)}. Aucun contrat de durée.` },
];

const schemas = [
  getWebPageSchema({ url: pageUrl, name: pageTitle, description: pageDescription }),
  getBreadcrumbSchema([
    { name: "Accueil", url: SITE_URL },
    { name: "Développeur web freelance Genève", url: pageUrl },
  ]),
  getFAQPageSchema(faqs),
  localBusinessData,
];

const stat = (label: string) => proofLecureux.stats.find((s) => s.label === label)!;
---

<ServicePage
  title={pageTitle}
  description={pageDescription}
  schemas={schemas}
  head={{
    kicker: "Freelance · Genève et Suisse romande",
    h1: "Développeur web freelance",
    dim: "à Genève.",
    lead: "Systèmes IA sur mesure, sites web et applications mobiles pour les PME et indépendants romands. Un seul interlocuteur, un devis transparent, du code propre.",
    cta: { href: "/contact", label: "Demander un devis" },
    cta2: { href: "/portfolio", label: "Voir mes réalisations" },
  }}
  proofs={{ items: [
    { value: "8", label: "ans d'expérience", client: "Développeur freelance" },
    { value: "50+", label: "sites et projets livrés", client: "Clients romands" },
    { value: stat("Sur sa niche").value, label: "sur sa niche", client: proofLecureux.company },
    { value: stat("Leads qualifiés").value, label: "leads qualifiés", client: proofLecureux.company },
  ] }}
  sections={[
    {
      id: "services", kicker: "01 · Services", title: "Trois offres,", dim: "l'IA d'abord.",
      text: "De l'agent IA à l'app mobile, en passant par le site web : un spécialiste du développement web en Suisse qui couvre toute la chaîne.",
      cta: { href: "/services", label: "Voir tous les services" },
      subs: [
        { meta: pricing.agentIA.display, title: "IA en entreprise", text: "Des agents IA et des automatisations qui prennent en charge les tâches répétitives : e-mails, relances, documents. Branchés sur vos outils, avec validation humaine.", link: { href: "/consultant-ia", label: "Systèmes IA sur mesure" } },
        { meta: pricing.siteWeb.display, title: "Création de site web", text: "Site vitrine sur mesure pour indépendants et PME, ou site Webflow que vous gérez vous-même. Rapide, clair, trouvable sur Google.", link: { href: "/services/creation-site-web", label: "Création de site web" } },
        { meta: pricing.appMobile.display, title: "Application mobile", text: "Une app iPhone et Android pour vos clients ou votre équipe, de l'idée aux stores.", link: { href: "/services/developpement-application-mobile", label: "Développement d'application mobile" } },
      ],
    },
    {
      id: "comparaison", kicker: "02 · Freelance ou agence", title: "Pourquoi un freelance", dim: "plutôt qu'une agence ?",
      text: "Les deux options sont valides selon le contexte. Voilà ce qui change concrètement quand vous choisissez un freelance à Genève.",
      subs: [
        { title: "Interlocuteur unique", text: "Vous parlez à la personne qui code. Pas de chef de projet entre vous et le clavier, pas de téléphone arabe." },
        { title: "Prix transparent", text: "Devis détaillé, zéro marge cachée. Vous savez exactement ce que vous payez." },
        { title: "Agilité", text: "Décisions rapides, adaptations en cours de route. Pas de comité à convaincre." },
        { title: "Code propre, pas de WordPress par défaut", text: "Astro, Next.js, Tailwind. Stack moderne, performance Google native, zéro plugin qui rame." },
        { meta: "Côté agence", title: "Plus de structure, plus de couches", features: ["Équipe dédiée (mais cloisonnée) : account manager, chef de projet, designer, dev, QA. Pratique sur de gros projets, lourd sur des sites de PME.", "Process en plusieurs strates : plus de structure, mais plus de délais (3 à 6 mois en moyenne).", "Marge cachée 30-50 % : le tarif finance les locaux, le commercial et les fonctions support.", "Stack souvent verrouillée : beaucoup d'agences romandes restent sur WordPress par habitude."] },
      ],
    },
    {
      id: "stack", kicker: "03 · Stack", title: "Stack", dim: "technique.",
      text: "Outils modernes, performants et durables. Pas de WordPress par défaut, sauf si votre projet le justifie vraiment.",
      subs: [
        { title: "Les outils", tools: ["Claude", "OpenAI", "Python", "Astro", "Next.js", "React", "Svelte", "TypeScript", "Tailwind CSS", "Supabase", "Vercel", "Cloudflare", "Stripe", "TWINT", "Webflow", "Framer"] },
        { title: "Pourquoi pas WordPress par défaut ?", text: "WordPress reste pertinent pour certains cas (gros blog éditorial, équipe déjà formée) : je le propose en <a href=\"/services/creation-site-web#refonte\">refonte ou migration</a> quand c'est justifié. Mais sur la plupart des projets de PME romandes, une stack moderne (Astro, Next.js, Svelte) donne un site plus rapide, plus sûr et moins cher à maintenir sur 3 ans. Pour un CMS visuel, je propose aussi <a href=\"/services/creation-site-web#webflow\">Webflow</a>." },
      ],
    },
    {
      id: "zones", kicker: "04 · Zones", title: "Où", dim: "j'interviens.",
      text: "Basé à Genève, je travaille avec des clients de toute la Suisse romande (Vaud, Valais, Neuchâtel, Fribourg) et de la zone frontalière française.",
      subs: [
        { title: "Suisse romande", features: ["Genève (base)", "Lausanne", "Vevey", "Montreux", "Sion", "Sierre", "Nyon", "Morges"], text: "Échanges en visio ou en personne selon votre préférence. Facturation en CHF.", link: { href: "/consultant-ia/lausanne", label: "Consultant IA à Lausanne" } },
      ],
    },
    {
      id: "tarifs", kicker: "05 · Tarifs", title: "Combien ça", dim: "coûte ?",
      text: "Des prix en CHF pour situer votre projet. Devis ferme après un premier échange gratuit.",
      cta: { href: "/tarifs", label: "Voir tous les tarifs" },
      subs: [
        { meta: pricing.agentIA.display, title: "Agent IA", text: `Puis ${pricing.agentIA.runningCost} de fonctionnement, hébergé en Suisse.` },
        { meta: pricing.siteWeb.display, title: "Site web", text: `Site Webflow : ${pricing.webflow.display.replace('Dès', 'dès')}.`, features: ["Design sur mesure", "Adapté au mobile", "Optimisé pour Google"] },
        { meta: pricing.appMobile.display, title: "Application mobile", text: "Chiffrée selon votre projet." },
        { meta: pricing.formationIA.display, title: "Formation IA", text: "Pour une équipe ou en individuel.", link: { href: "/services/formation-ia-equipe", label: "Formation IA équipe" } },
      ],
    },
  ]}
  method={{
    title: "Comment on travaille", dim: "ensemble.",
    text: "Quatre étapes claires, des validations à chaque jalon, aucune zone de flou.",
    steps: [
      { title: "Brief", text: "Échange gratuit de 30-45 minutes. Vous m'expliquez votre activité, vos objectifs, ce que vous attendez concrètement.", meta: "Sous 48h" },
      { title: "Devis", text: "Proposition écrite : périmètre, livrables, planning, montant en CHF. Pas de surprise, pas d'option cachée.", meta: "3-5 jours" },
      { title: "Sprint", text: "Maquette validée puis développement. Démos régulières, accès staging, ajustements en continu.", meta: "2-4 semaines" },
      { title: "Livraison", text: "Mise en ligne, transfert des accès, formation rapide. Votre projet vous appartient : code, hébergement, domaine.", meta: "1 jour" },
    ],
  }}
  cases={{
    title: "Réalisations", dim: "récentes.",
    text: "Quelques projets livrés pour des clients romands. Tout le <a href=\"/portfolio\">portfolio</a>.",
    slugs: ["leo-lecureux-seo", "barber-concept"],
  }}
  links={[{
    title: "À lire avant", dim: "de vous décider.",
    items: [
      { href: "/blog/prix-site-web-suisse-2026", k: "Article", label: "Combien coûte vraiment un site web en Suisse en 2026 ?", text: "Fourchettes en CHF par profil de prestataire (freelance, agence, no-code) et par type de projet." },
      { href: "/blog/specialiste-developpement-web-suisse", k: "Article", label: "Spécialiste dev web Suisse : comment bien choisir", text: "Les 7 critères pour différencier un bon développeur d'un copieur de templates." },
      { href: "/portfolio/ugo-mighali-coutelier", k: "Réalisation", label: "Ugo Mighali, coutelier d'art", text: "Portfolio minimaliste pour un jeune artisan formé à Genève." },
      { href: "/about", k: "À propos", label: "Qui est derrière Jon Labs", text: "Mon parcours, ma façon de travailler." },
    ],
  }]}
  testimonials={[
    { quote: proofLecureux.testimonial!.quote.split("\n")[0], name: proofLecureux.testimonial!.author, role: proofLecureux.metierShort, company: proofLecureux.company, result: proofLecureux.businessResult },
  ]}
  faq={faqs}
  contact="Premier échange gratuit, sans engagement. Je vous dis franchement si je suis le bon profil pour vous, et sinon, je vous oriente vers quelqu'un de mieux placé."
/>

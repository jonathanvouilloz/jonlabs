---
// Page Services — Jon Labs (v2)
// Aperçu (Bento), un bloc par service (titre collant | sous-services), process, zone, ressources, CTA. Classes sv-n-*.
// Prix lus dans src/data/pricing.ts.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import Bento from '../components/v2/Bento.astro';
import Steps from '../components/v2/Steps.astro';
import Footer from '../components/v2/Footer.astro';
import '../styles/v2.css';
import { serviceSections } from '../data/scenarios';
import { pricing } from '../data/pricing';
import { mainNav } from '../data/navigation';
import { villesFrontalieres } from '../data/villes-frontalieres';
import { servicesListData, SITE_URL } from '../data/schema';
import { getWebPageSchema, getBreadcrumbSchema } from '../lib/seo';

const pageTitle = "Services de développement web à Genève — Jon Labs";
const pageDescription = "Développeur web freelance à Genève : sites web, applications mobiles, référencement local et IA pour entrepreneurs et PME en Suisse romande. Devis gratuit, réponse sous 24h.";

const webPageSchema = getWebPageSchema({
  url: `${SITE_URL}/services`,
  name: pageTitle,
  description: pageDescription
});
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Accueil", url: SITE_URL },
  { name: "Services", url: `${SITE_URL}/services` }
]);
const schemas = [servicesListData, webPageSchema, breadcrumbSchema];

const order = ['ia', 'site-web', 'app-mobile'];
const sections = order.map((id) => serviceSections.find((s) => s.id === id)!);
const price: Record<string, string> = { ia: pricing.agentIA.display, 'site-web': pricing.siteWeb.display, 'app-mobile': pricing.appMobile.display };
const label: Record<string, string> = { ia: 'Systèmes IA', 'site-web': 'Sites web', 'app-mobile': 'Apps mobiles' };
// Liens « Par métier » du méga-menu Systèmes IA (data/navigation.ts).
const metiers = mainNav.find((s) => s.label === 'IA & Automatisation')?.columns?.find((c) => c.title === 'Par métier')?.items ?? [];
const villes = ['Genève', 'Lausanne', 'Vevey', 'Montreux', 'Sion', 'Nyon', 'Morges', 'Annemasse', 'Saint-Julien'];
const resources = [
  { href: '/guides/mettre-en-place-ia-entreprise-guide', k: 'Guide', title: "Mettre en place l'IA en entreprise", teaser: 'Par où commencer, quoi automatiser, comment garder la main : le guide complet pour une PME.' },
  { href: '/blog/logiciel-sur-mesure-vs-saas', k: 'Article', title: 'Logiciel sur mesure ou SaaS ?', teaser: 'Quand un outil du marché suffit, et quand développer le tien devient rentable.' },
  { href: '/blog/geo-seo-ia', k: 'Guide', title: 'Apparaître dans les IA en 2026', teaser: 'Le guide complet pour exister dans ChatGPT, Claude, Perplexity, Gemini, Copilot et Grok.' },
  { href: '/blog/prix-site-web-suisse-2026', k: 'Article', title: 'Combien coûte un site web en Suisse ?', teaser: 'Un guide transparent des fourchettes en CHF, sans bullshit ni clauses cachées.' },
];
---

<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/services" />
    <Dock current="/services" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <div>
          <p class="v2-meta">Services · Genève et Suisse romande</p>
          <h1 class="v2-h1 sv-n-h1" data-words>Systèmes IA,<br /><span class="v2-dim">sites et apps.</span></h1>
        </div>
        <div class="sv-n-intro">
          <p class="v2-head-p">Un premier appel gratuit pour cadrer, un devis clair, une réponse sous 24&nbsp;h.</p>
          <nav class="v2-meta sv-n-jump" aria-label="Sur cette page">
            {sections.map((s, i) => <a href={`#${s.id}`} class="v2-a">0{i + 1} {label[s.id]}</a>)}
          </nav>
        </div>
      </div></header>

      <section class="r" aria-label="Ce que je construis"><Bento /></section>

      {sections.map((s, i) => (
        <section class="r" id={s.id} aria-labelledby={`sv-n-${s.id}`}><div class="w sv-n-svc">
          <div class="sv-n-side">
            <div class="sv-n-sticky">
              <p class="v2-meta">0{i + 1} · {label[s.id]}</p>
              <h2 class="v2-h2" id={`sv-n-${s.id}`} data-words>{s.title}</h2>
              <p class="v2-mut sv-n-acc">{s.accroche.split('. ')[0].replace(/\.?$/, '.')}</p>
              <p class="sv-n-price"><small class="v2-meta">Tarif</small>{price[s.id]}</p>
              <a href="/contact" class="v2-btn v2-btn-sm"><span data-roll>{s.ctaText}</span></a>
            </div>
          </div>
          <div class="sv-n-subs" data-rise>
            {s.subServices.map((sub) => (
              <article class="sv-n-sub" id={sub.id}>
                <h3>{sub.title}</h3>
                <p class="v2-mut">{sub.description}</p>
                <ul class="v2-price-list">{sub.features.map((f) => <li>{f}</li>)}</ul>
                <a href={sub.link ?? '/contact'} class="v2-a sv-n-more">{sub.ctaText} <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
              </article>
            ))}
            {s.id === 'ia' && metiers.length > 0 && (
              <div class="sv-n-sub sv-n-metiers">
                <p class="v2-meta">Par métier</p>
                {metiers.map((m) => <a href={m.href} class="v2-a">{m.label}</a>)}
              </div>
            )}
          </div>
        </div></section>
      ))}

      <section class="r" aria-labelledby="sv-n-process"><div class="w">
        <div class="v2-head v2-head-2">
          <h2 class="v2-h2" id="sv-n-process" data-words>Comment<br /><span class="v2-dim">ça se passe.</span></h2>
          <p class="v2-head-p">De l'appel découverte au suivi, un seul interlocuteur.</p>
        </div>
      </div></section>
      <section class="r" aria-label="Étapes"><Steps /></section>

      <section class="r" aria-labelledby="sv-n-zone"><div class="w sv-n-zone">
        <div>
          <h2 class="v2-h2" id="sv-n-zone" data-words>Genève,<br /><span class="v2-dim">Suisse romande et zone frontalière.</span></h2>
        </div>
        <div class="sv-n-zone-body">
          <p class="v2-mut">Basé à Genève, je travaille avec des clients de toute la Suisse romande (Vaud, Valais, Fribourg, Neuchâtel, Jura) et de la zone frontalière française (Haute-Savoie, Pays de Gex). Échanges en visio, déplacements ponctuels possibles à Genève et Lausanne.</p>
          <p class="v2-meta">{villes.map((v) => <span>{v}</span>)}</p>
          <div class="sv-n-geo">
            <p class="v2-meta">Pages dédiées · zone frontalière</p>
            <div>{villesFrontalieres.map((v) => <a href={`/developpement-web/${v.slug}`} class="v2-a">{v.nom}</a>)}</div>
          </div>
          <a href="/developpeur-web-freelance-geneve" class="v2-btn v2-btn-ghost v2-btn-sm"><span data-roll>Développeur web freelance à Genève</span></a>
        </div>
      </div></section>

      <section class="r" aria-labelledby="sv-n-res"><div class="w">
        <div class="v2-head v2-head-2">
          <h2 class="v2-h2" id="sv-n-res" data-words>Aller plus loin.</h2>
          <p class="v2-head-p v2-prose">Articles et guides pour cadrer votre projet, et <a href="/blog/specialiste-developpement-web-suisse">choisir un spécialiste web en Suisse</a>.</p>
        </div>
        <div class="sv-n-res">
          {resources.map((r) => (
            <a href={r.href}>
              <span class="v2-meta">{r.k}</span>
              <strong>{r.title}</strong>
              <span class="v2-mut">{r.teaser}</span>
            </a>
          ))}
        </div>
      </div></section>

      <section class="r"><div class="w v2-head v2-head-2 v2-teal v2-dots" data-spot>
        <i class="v2-dots-glow" aria-hidden="true"></i>
        <h2 class="v2-h2" data-words>Votre projet mérite mieux<br /><span class="v2-dim">qu'un devis à rallonge.</span></h2>
        <div class="sv-n-cta">
          <div class="v2-ctas v2-ctas-left">
            <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Prendre rendez-vous</span></a>
            <a href="mailto:contact@jonlabs.ch" class="v2-btn v2-btn-ghost"><span data-roll>contact@jonlabs.ch</span></a>
          </div>
          <p class="v2-meta">Réponse sous 24 h · Premier appel gratuit · Devis clair et détaillé</p>
        </div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .v2 .sv-n-h1 { margin-top: 18px; }
  .v2 .sv-n-intro { display: grid; gap: 24px; }
  .v2 .sv-n-jump { gap: 6px 20px; }
  .v2 .sv-n-svc { display: grid; grid-template-columns: 1fr 1.25fr; }
  .v2 .sv-n-side { border-right: 1px solid var(--line); }
  .v2 .sv-n-sticky { position: sticky; top: 24px; padding: 40px var(--pad) 48px; display: grid; gap: 18px; justify-items: start; }
  .v2 .sv-n-acc { max-width: 28rem; }
  .v2 .sv-n-price { display: grid; gap: 4px; font-family: var(--display); font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: -0.05em; line-height: 1; margin: 8px 0; }
  .v2 .sv-n-sub { padding: 36px var(--pad); display: grid; gap: 14px; justify-items: start; }
  .v2 .sv-n-sub + .sv-n-sub { border-top: 1px solid var(--line); }
  .v2 .sv-n-sub h3 { margin: 0; }
  .v2 .sv-n-sub .v2-price-list { margin-top: 4px; }
  .v2 .sv-n-more { display: inline-flex; gap: 6px; align-items: center; margin-top: 6px; font-weight: 500; }
  .v2 .sv-n-metiers { background: var(--soft); gap: 8px; }
  .v2 .sv-n-zone { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: clamp(48px, 7vw, 88px) var(--pad); }
  .v2 .sv-n-zone-body { display: grid; gap: 22px; justify-items: start; align-content: start; }
  .v2 .sv-n-geo { display: grid; gap: 8px; }
  .v2 .sv-n-geo > div { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .v2 .sv-n-res { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .v2 .sv-n-res > a { display: grid; gap: 10px; align-content: start; padding: 28px var(--pad) 36px; transition: background .2s; }
  .v2 .sv-n-res > a + a { border-left: 1px solid var(--line); }
  .v2 .sv-n-res > a:hover { background: var(--soft); }
  .v2 .sv-n-res strong { font-family: var(--display); font-weight: 500; font-size: 1.25rem; letter-spacing: -0.03em; line-height: 1.15; }
  .v2 .sv-n-res .v2-mut { font-size: .95rem; }
  .v2 .sv-n-nb { white-space: nowrap; }
  .v2 .sv-n-cta { display: grid; gap: 18px; }
  .v2 .v2-teal .v2-btn-ghost { border-color: var(--ink); }
  @media (max-width: 900px) {
    .v2 .sv-n-svc, .v2 .sv-n-zone { grid-template-columns: 1fr; }
    .v2 .sv-n-side { border-right: 0; border-bottom: 1px solid var(--line); }
    .v2 .sv-n-sticky { position: static; }
    .v2 .sv-n-res { grid-template-columns: 1fr 1fr; }
    .v2 .sv-n-res > a:nth-child(3) { border-left: 0; }
    .v2 .sv-n-res > a:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 520px) {
    .v2 .sv-n-res { grid-template-columns: 1fr; }
    .v2 .sv-n-res > a + a { border-left: 0; border-top: 1px solid var(--line); }
    .v2 .sv-n-cta .v2-ctas { flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  import '../scripts/v2-ui';
</script>

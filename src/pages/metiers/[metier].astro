---
// Métiers IA — page déclinée v2 (gabarit src/components/v2/declinee/). Données : src/data/metiers-ia.ts.
// SEO conservé : title / meta / H1 du métier, WebPage + BreadcrumbList + FAQPage + Service + LocalBusiness,
// maillage pilier IA, autre métier, villes IA, articles connexes.
import DeclineePage from '../../components/v2/declinee/DeclineePage.astro';
import { methodeIA, piliersIA, metiersLinks } from '../../components/v2/declinee/shared';
import type { DcPage } from '../../components/v2/declinee/types';
import { localBusinessData } from '../../data/schema';
import { getServiceItemSchema } from '../../lib/seo';
import { pricing } from '../../data/pricing';
import { metiersIA, type MetierIAData } from '../../data/metiers-ia';
import { villesSuisseIA } from '../../data/villes-suisse-ia';

export async function getStaticPaths() {
  return metiersIA.map((metier) => ({ params: { metier: metier.slug }, props: { metier } }));
}

interface Props { metier: MetierIAData }
const { metier } = Astro.props;

const path = `/metiers/${metier.slug}`;
const cut = metier.h1.lastIndexOf(' en ');
const serviceSchema = getServiceItemSchema(`metiers/${metier.slug}`);

const page: DcPage = {
  path, title: metier.title, description: metier.metaDescription,
  crumbs: [{ name: 'Accueil', path: '/' }, { name: 'Consultant IA', path: '/consultant-ia' }, { name: metier.metier, path }],
  meta: metier.heroBadge,
  h1: cut > 0 ? metier.h1.slice(0, cut) : metier.h1,
  h1Dim: cut > 0 ? metier.h1.slice(cut + 1) : undefined,
  lead: metier.accroche,
  trust: metier.preuveLocale.split('·').map((p) => p.trim()).filter(Boolean),
  price: { label: 'Premier agent', value: pricing.agentIA.display },
  ctaLabel: 'Cadrer mon projet IA',
  sections: [
    {
      kind: 'prose', id: 'principe', meta: 'Le principe', title: 'Ce qui devrait', dim: 'remonter tout seul.',
      paras: ["L'idée n'est pas de tout automatiser, mais de faire en sorte que l'essentiel arrive à vous prêt à décider, au lieu d'aller le chercher."],
      list: metier.fluxRemontent,
    },
    {
      kind: 'cells', id: 'blocages', title: 'Les blocages', dim: 'du métier.',
      intro: "Si vous vous reconnaissez dans l'un de ces points, il y a probablement du temps à récupérer.",
      items: metier.pains.map((p, i) => ({ k: String(i + 1).padStart(2, '0'), d: p })),
    },
    {
      kind: 'cells', id: 'cas-usage', title: `${metier.casUsage.length} façons dont l'IA`, dim: 'change le quotidien.',
      intro: 'Pas de démo de labo. Des agents branchés sur des tâches réelles du métier, avec la validation humaine là où elle compte.',
      items: metier.casUsage.map((c) => ({ t: c.titre, d: c.description })), cols: 4,
    },
    {
      kind: 'cells', id: 'parcours', title: metier.parcoursLabel,
      intro: "À chaque étape, l'IA enlève du travail répétitif, pas la décision, qui reste la vôtre.",
      items: metier.parcours.map((e, i) => ({ k: String(i + 1).padStart(2, '0'), t: e.etape, d: e.description })),
    },
    {
      kind: 'cells', id: 'outils', title: 'On se branche', dim: 'sur vos outils.',
      intro: "L'idée n'est pas de tout remplacer, mais de brancher l'IA sur les logiciels que vous utilisez déjà.",
      items: metier.outils.map((o) => ({ t: o.nom, d: o.usage })),
    },
    {
      kind: 'cells', id: 'methode', title: 'Comment on', dim: 'travaille ensemble.',
      intro: "Une méthode qui part de vos process réels et garde l'humain aux commandes.",
      items: methodeIA, cols: 4,
    },
    {
      kind: 'cells', id: 'pour-qui', title: 'Pour qui,', dim: 'et pas pour qui.',
      intro: "Autant le dire tout de suite : l'IA n'est pas la réponse à tout. Voici où elle aide, et où elle n'a rien à faire.",
      items: [{ k: 'Pour vous si…', list: metier.pourQui }, { k: 'Pas pour vous si…', list: metier.pasPourQui }], cols: 2,
    },
    {
      kind: 'cells', id: 'preuves', title: 'Pourquoi', dim: 'me faire confiance.',
      intro: 'Pas de storytelling : des faits vérifiables et un ancrage suisse réel.',
      items: metier.preuves.map((p) => ({ d: p })), cols: 2,
    },
  ],
  faqs: metier.faqs,
  links: [
    ...piliersIA,
    ...metiersLinks(metier.slug),
    ...villesSuisseIA.map((v) => ({ href: `/consultant-ia/${v.slug}`, k: 'Ville', t: `Consultant IA à ${v.nom}` })),
    ...metier.articlesConnexes.map((a) => ({ href: a.href, k: 'Article', t: a.title, d: a.description })),
    { href: '/portfolio', k: 'Réalisations', t: 'Voir mes réalisations' },
  ],
  cta: {
    title: "On regarde ensemble ce que l'IA", dim: 'peut vous enlever.',
    text: "Premier échange gratuit, sans engagement. On identifie les 2-3 tâches qui vous mangent le plus de temps, et je vous dis franchement si l'IA y répond.",
  },
  schemas: [...(serviceSchema ? [serviceSchema] : []), localBusinessData],
};
---

<DeclineePage page={page} />

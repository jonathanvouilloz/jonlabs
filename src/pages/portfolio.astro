---
// Page Portfolio — Jon Labs (v2)
// Études de cas clients en rangées <CaseSpec /> (image bord à bord + fiche), projets perso en grille de 3.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/v2/Nav.astro';
import Dock from '../components/v2/Dock.astro';
import CaseSpec from '../components/v2/CaseSpec.astro';
import Footer from '../components/v2/Footer.astro';
import '../styles/v2.css';

import { SITE_URL } from '../data/schema';
import { getCollectionPageSchema } from '../lib/seo';

const pageTitle = "Réalisations Web & Études de Cas";
const pageDescription = "Sites web, SEO local et automatisations : découvrez mes réalisations détaillées pour des clients suisses. Résultats mesurables à l'appui.";

const schemas = [getCollectionPageSchema({ url: `${SITE_URL}/portfolio`, name: pageTitle, description: pageDescription })];

const entries = (await getCollection('portfolio', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cases = entries.filter((p) => p.data.entryType === 'case-study');
const sides = entries.filter((p) => p.data.entryType === 'side-project');
const year = (d: Date) => d.getFullYear();
---

<Layout title={pageTitle} description={pageDescription} schemas={schemas}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&display=swap" />
  </Fragment>

  <div class="v2">
    <Nav current="/portfolio" />
    <Dock current="/portfolio" />

    <main>
      <header class="r"><div class="w v2-head v2-head-2">
        <div>
          <p class="v2-meta">{cases.length} études de cas · {sides.length} projets perso</p>
          <h1 class="v2-h1 v2-port-h1" data-words>Réalisations.</h1>
        </div>
        <p class="v2-head-p">Des projets livrés pour de vrais clients, avec le contexte, l'approche et les résultats mesurés.</p>
      </div></header>

      {cases.map((c, i) => <>
        {i > 0 && <div class="r" aria-hidden="true"><div class="w v2-gap"></div></div>}
        <section class="r"><CaseSpec entry={c} /></section>
      </>)}

      {sides.length > 0 && (
        <section class="r" aria-labelledby="perso"><div class="w">
          <div class="v2-head v2-head-2">
            <h2 class="v2-h2" id="perso" data-words>Projets perso.<br /><span class="v2-dim">Là où j'essaie avant vous.</span></h2>
            <p class="v2-head-p">Des outils que je construis pour moi, souvent le terrain d'essai de ce que je livre ensuite.</p>
          </div>
          <div class="v2-art-rel" data-rise>
            {sides.map((p) => (
              <a href={`/portfolio/${p.slug}`}>
                <img src={p.data.heroImage.url} alt={p.data.heroImage.alt} loading="lazy" width="400" height="225" />
                <span class="v2-meta"><span>{year(p.data.date)}</span>{p.data.project.platform && <span>{p.data.project.platform}</span>}</span>
                <strong>{p.data.title}</strong>
              </a>
            ))}
          </div>
        </div></section>
      )}

      <section class="r"><div class="w v2-head v2-head-2">
        <h2 class="v2-h2" data-words>Votre projet,<br /><span class="v2-dim">la prochaine étude de cas.</span></h2>
        <div class="v2-ctas v2-ctas-left">
          <a href="/contact" class="v2-btn"><i class="ri-calendar-line"></i> <span data-roll>Parlons de votre projet</span></a>
          <a href="mailto:contact@jonlabs.ch" class="v2-btn v2-btn-ghost"><span data-roll>contact@jonlabs.ch</span></a>
        </div>
      </div></section>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  import '../scripts/v2-ui';
</script>

---
// Guide pilier (collection `pages`) sur le gabarit article v2 partagé avec /blog/[slug].
import { getCollection } from 'astro:content';
import V2Page from '../../layouts/V2Page.astro';
import Article from '../../components/v2/Article.astro';
import { isPublished } from '../../lib/blog';
import { getWebPageSchema, getBreadcrumbSchema, getFAQPageSchema, getBlogPostingSchema } from '../../lib/seo';
import { author } from '../../sample';
import { SITE_URL, personData, organizationData } from '../../data/schema';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => isPublished(data));
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, h1, description, image, pubDate, readingTime, tags = [] } = page.data;
const { Content, headings } = await page.render();

// Schemas : WebPage (le pillar est un hub) + BlogPosting (contenu éditorial daté, auteur, image).
const webPageSchema = getWebPageSchema({
  url: Astro.url.href,
  name: title,
  description,
});
const articleSchema = getBlogPostingSchema({
  title: h1 ?? title,
  description,
  url: Astro.url.href,
  image: new URL(image.url, SITE_URL).toString(),
  datePublished: pubDate,
  dateModified: page.data.updatedDate || pubDate,
  author: author.name,
  category: 'Guide',
  tags,
  readingTime,
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Accueil', url: `${SITE_URL}/` },
  // /guides redirige vers /blog (301) : le fil d'Ariane suit la cible finale.
  { name: 'Blog', url: `${SITE_URL}/blog` },
  { name: title, url: Astro.url.href },
]);

const schemas = [
  webPageSchema,
  articleSchema,
  breadcrumbSchema,
];
if (page.data.faqs && page.data.faqs.length > 0) {
  schemas.push(getFAQPageSchema(page.data.faqs));
}
---

<V2Page
  title={title}
  description={description}
  ogImage={image.url}
  ogType="article"
  schemas={schemas}
  article={{ publishedTime: pubDate, modifiedTime: page.data.updatedDate, author: author.name, section: 'Guide', tags }}
>
  <Article title={title} h1={h1} image={image} pubDate={pubDate} updatedDate={page.data.updatedDate} readingTime={readingTime} headings={headings} back={{ href: '/consultant-ia', label: 'Consultant IA' }}>
    <Content />
  </Article>
</V2Page>

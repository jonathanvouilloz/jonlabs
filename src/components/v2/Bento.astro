---
// Bento services v2 (direction A) : figures isométriques Hairline (initialisées par v2-ui).
// `items` remplace le contenu de la home ; la grille est pensée pour 4 cases (la 1re, `big`, sur 2 rangées).
import { builds } from '../../data/v2';
interface Props { items?: { iso: string; title: string; text: string; big?: boolean }[] }
const { items = builds } = Astro.props;
---
<div class="w v2-bento">
  {items.map((b) => (
    <div class:list={['v2-cell', { 'v2-cell-big': b.big }]}>
      <div class="v2-iso" data-iso={b.iso} data-theme="light"></div>
      <h3>{b.title}</h3>
      <p class="v2-mut">{b.text}</p>
    </div>
  ))}
</div>

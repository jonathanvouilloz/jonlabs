---
// Dock bas v2 (direction B) : même pastille que la nav. Apparaît quand la nav haute sort (script v2-ui).
import { nav } from '../../data/v2';
interface Props { current?: string; floating?: boolean }
const { current, floating = true } = Astro.props;
---
<nav class:list={['v2-dock', { 'v2-dock-static': !floating }]} data-dock={floating ? '' : undefined} data-pill aria-label="Navigation">
  <img src="/images/jonathan-vouilloz.webp" alt="Jonathan Vouilloz" class="v2-dock-avatar" width="36" height="36" />
  {nav.map((n) => <a href={n.href} aria-current={n.href === current ? 'page' : undefined}>{n.label}</a>)}
  <i data-pill-bg aria-hidden="true"></i>
  <a href="#agenda" class="v2-dock-cta" aria-label="Réserver un appel"><i class="ri-calendar-line"></i></a>
</nav>

---
// Article v2 (direction B · Magazine centré) partagé par /blog/[slug] et /guides/[slug] :
// titre centré, image 21/9 bord à bord, colonne 680px, sommaire repliable, pied partage + auteur.
// Slots : `tags` (au-dessus du H1), `media` (avant le corps), défaut = corps .co-prose.
import { Image } from 'astro:assets';
import imgJonathan from '../../assets/jonathan-vouilloz.webp';
import { formatDate } from '../../lib/blog';
import { author } from '../../sample';

interface Props {
  title: string;
  h1?: string;
  image: { url: string; alt: string };
  pubDate: Date;
  updatedDate?: Date;
  readingTime?: number;
  headings: { depth: number; slug: string; text: string }[];
  back: { href: string; label: string };
}
const { title, h1, image, pubDate, updatedDate, readingTime, headings, back } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const updated = updatedDate && updatedDate.getTime() !== pubDate.getTime() ? updatedDate : undefined;
const share = encodeURIComponent(Astro.url.href);
---

<article>
  <header class="r"><div class="w v2-art-head">
    <slot name="tags" />
    <h1 class="v2-h1">{h1 ?? title}</h1>
    <p class="v2-meta">
      <a href="/about">{author.name}</a>
      <span>{formatDate(pubDate)}</span>
      {updated && <span>Mis à jour le {formatDate(updated)}</span>}
      {readingTime && <span>{readingTime} min de lecture</span>}
    </p>
  </div></header>

  <div class="r"><div class="w v2-art-img"><img src={image.url} alt={image.alt} width="1180" height="506" /></div></div>

  <div class="r"><div class="w v2-art">
    {toc.length > 2 && (
      <details class="v2-art-toc">
        <summary class="v2-meta">Sommaire · {toc.length} parties<i class="ri-add-line" aria-hidden="true"></i></summary>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <slot name="media" />
    <div class="co-prose v2-art-prose"><slot /></div>

    <div class="v2-art-foot">
      <a href={back.href} class="v2-meta"><i class="ri-arrow-left-line" aria-hidden="true"></i> {back.label}</a>
      <p class="v2-meta">
        <span>Partager</span>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur X"><i class="ri-twitter-x-line"></i></a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn"><i class="ri-linkedin-fill"></i></a>
        <button type="button" aria-label="Copier le lien" data-copy><i class="ri-link"></i></button>
      </p>
    </div>

    <a href="/about" class="v2-art-author">
      <Image src={imgJonathan} alt={`Photo de ${author.name}`} width={56} height={56} loading="lazy" />
      <span><span class="v2-meta">Écrit par</span><strong>{author.name}</strong></span>
      <i class="ri-arrow-right-line" aria-hidden="true"></i>
    </a>
  </div></div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    await navigator.clipboard.writeText(location.href);
    b.innerHTML = '<i class="ri-check-line"></i>';
    setTimeout(() => (b.innerHTML = '<i class="ri-link"></i>'), 2000);
  }));
</script>

---
// Hero v2 (direction B) : trame animée (shader Paper) très pâle, titre qui monte lettre à lettre.
// Seule section en pleine largeur (hors container .w) : le fond couvre tout le viewport.
import DitherBg from './DitherBg.tsx';
interface Props { heading?: 'h1' | 'h2' }
const { heading: H = 'h1' } = Astro.props;
---
<section class="r">
  <div class="v2-hero">
    <div class="v2-hero-shader" aria-hidden="true"><DitherBg client:visible /></div>
    <div class="v2-hero-in">
      <p class="v2-hi"><img src="/images/jonathan-vouilloz-72.webp" alt="" width="72" height="72" />Salut, c'est Jon. Freelance à Genève.</p>
      <H class="v2-h1" data-chars>Des <span class="v2-hl" style="white-space:nowrap">systèmes IA</span><br />pour vos équipes.</H>
      <p class="v2-lead">Je conçois et je mets en production les systèmes IA qui prennent le répétitif, pour que vos équipes gardent l'essentiel.</p>
      <div class="v2-ctas">
        <a href="/contact#agenda" class="v2-btn" data-cal-popup><i class="ri-calendar-line"></i> <span data-roll>Discuter de mon projet</span></a>
        <a href="#realisations" class="v2-btn v2-btn-ghost"><span data-roll>Découvrir mon travail</span></a>
      </div>
      <p class="v2-trust"><b>20+ projets livrés</b> pour des PME et des indépendants</p>
    </div>
    <a href="#realisations" class="v2-scroll" aria-label="Défiler vers les réalisations"><span></span></a>
  </div>
</section>

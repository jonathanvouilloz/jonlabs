---
// Témoignages v2 (direction A · Grande citation, validée le 2026-11-17) : une citation en grand, la liste des clients à droite.
// Choisir un client affiche sa citation (script v2-ui, [data-testi]). Défaut : testimonials (data/v2.ts) — encore du lorem.
// `items` : vrais témoignages seulement ; `company` et `result` sont facultatifs.
import { testimonials } from '../../data/v2';
type Testi = { quote: string; name: string; role: string; company?: string; result?: string };
interface Props { items?: Testi[] }
const { items = testimonials as Testi[] } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<div class="w v2-testi" data-testi>
  <div class="v2-testi-main" aria-live="polite">
    <p class="v2-testi-mark" aria-hidden="true">“</p>
    {items.map((t, i) => (
      <figure class="v2-testi-fig" id={`testi-${i}`} hidden={i > 0}>
        <blockquote class="v2-head-p">{t.quote}</blockquote>
        <figcaption class="v2-meta"><strong>{t.name}</strong><span>{t.company ? `${t.role}, ${t.company}` : t.role}</span></figcaption>
      </figure>
    ))}
  </div>
  <div class="v2-testi-list" role="group" aria-label="Choisir un témoignage">
    {items.map((t, i) => (
      <button type="button" aria-controls={`testi-${i}`} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="v2-testi-n">{pad(i)}</span><span>{t.company ?? t.name}</span><span class="v2-meta">{t.result}</span>
      </button>
    ))}
  </div>
</div>

---
// Étude de cas v2 (direction B) : image bord à bord + fiche de résultats. Les lignes vides sont omises.
import type { CollectionEntry } from 'astro:content';
// eager : seulement pour la première carte au-dessus de la ligne de flottaison (/portfolio).
interface Props { entry: CollectionEntry<'portfolio'>; eager?: boolean }
const { entry: { data, slug }, eager = false } = Astro.props;
// Le résultat client d'abord. Secteur/durée seulement pour les cas sans chiffre ; jamais la stack.
const rows = data.results.length ? [] : [
  ['Secteur', data.client?.sector],
  ['Durée', data.project.duration?.split('·')[0].trim()],
].filter(([, v]) => v);
---
<a href={`/portfolio/${slug}`} class="w v2-spec" data-rise>
  <div class="v2-spec-img"><img src={data.heroImage.url} alt={data.heroImage.alt} width={data.heroImage.width} height={data.heroImage.height} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
  <div class="v2-spec-body">
    <div><h3>{data.title}</h3><p class="v2-mut">{data.description}</p></div>
    <dl class={`v2-kv${data.results.length ? " v2-kv-roi" : ""}`}>
      {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      {data.results.slice(0, 3).map((r) => <div><dt>{r.value}</dt><dd>{r.label}</dd></div>)}
    </dl>
    <span class="v2-btn v2-btn-sm"><span data-roll>Voir l'étude de cas</span></span>
  </div>
</a>

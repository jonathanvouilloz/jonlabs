---
// Process v2 (direction A) : cercles pointillés qui se chevauchent. `items` remplace les étapes de la home.
import { steps } from '../../data/v2';
interface Props { items?: string[] }
const { items = steps } = Astro.props;
---
<ol class="w v2-steps" style={`--n:${items.length}`}>{items.map((s) => <li><span>{s}</span></li>)}</ol>

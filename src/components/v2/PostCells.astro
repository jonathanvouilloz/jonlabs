---
// Grille d'articles v2 (3 cellules à filets, contenu en retrait) partagée par /blog et /blog/tag/[tag].
// `page` : au-delà, cellules rendues `hidden` (l'index les révèle par « Afficher plus »).
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryName } from '../../lib/blog';

interface Props { posts: CollectionEntry<'blog'>[]; page?: number }
const { posts, page = Infinity } = Astro.props;
---
<div class="bl-n-grid" data-grid>
  {posts.map((p, i) => (
    <article data-cat={p.data.category} data-text={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')}`.toLowerCase()} hidden={i >= page}>
      <img src={p.data.image.url} alt="" loading="lazy" width="400" height="225" />
      <span class="v2-meta"><span>{getCategoryName(p.data.category)}</span><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time></span>
      <a href={`/blog/${p.slug}`} class="bl-n-link"><strong>{p.data.h1 ?? p.data.title}</strong></a>
      <span class="v2-mut">{p.data.description}</span>
      {p.data.tags.length > 0 && (
        <span class="bl-n-tags">{p.data.tags.slice(0, 3).map((tg) => <a href={`/blog/tag/${tg}`}>#{tg}</a>)}</span>
      )}
    </article>
  ))}
</div>

<style is:global>
  /* Filets dessinés par chaque cellule (::after à droite + en bas, débordant d'1px, rogné par la grille) : restent justes quand le filtre retire des cellules.
     Air entre articles : padding de cellule (pas de gap, cf. design-v2 §4), image posée dedans avec le rayon 5px. */
  .v2 .bl-n-grid { display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; }
  .v2 .bl-n-grid > article { display: grid; gap: 12px; align-content: start; padding: clamp(16px, 2vw, 24px) clamp(16px, 2vw, 24px) 36px; min-width: 0; position: relative; }
  .v2 .bl-n-grid > article::after { content: ''; position: absolute; inset: 0 -1px -1px 0; border: solid var(--line); border-width: 0 1px 1px 0; pointer-events: none; z-index: 1; }
  .v2 .bl-n-grid img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--soft); border-radius: var(--r); margin-bottom: 6px; }
  .v2 .bl-n-link::before { content: ''; position: absolute; inset: 0; z-index: 1; }
  .v2 .bl-n-link:focus-visible { outline: none; }
  .v2 .bl-n-link:focus-visible::before { outline: 2px solid var(--accent-strong); outline-offset: -4px; }
  .v2 .bl-n-grid strong { display: block; font-family: var(--display); font-weight: 500; font-size: 1.25rem; letter-spacing: -0.03em; line-height: 1.15; transition: color .2s; }
  .v2 .bl-n-grid .v2-mut { font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .v2 .bl-n-grid > article:hover strong { color: var(--accent-strong); }
  .v2 .bl-n-tags { display: flex; flex-wrap: wrap; gap: 4px 12px; font-family: var(--mono); font-size: .72rem; color: var(--mut); }
  .v2 .bl-n-tags a { position: relative; z-index: 2; transition: color .2s; }
  .v2 .bl-n-tags a:hover { color: var(--ink); }
  .v2 .bl-n-grid > article[hidden] { display: none !important; }

  @media (max-width: 900px) { .v2 .bl-n-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .v2 .bl-n-grid { grid-template-columns: 1fr; } }
</style>

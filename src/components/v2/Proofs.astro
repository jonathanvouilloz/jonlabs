---
// Repères chiffrés v2 (direction A) : compteurs. Chiffres réels = 1er résultat des 4 études de cas les plus récentes.
import { getCollection } from 'astro:content';
const proofs = (await getCollection('portfolio', (p) => !p.data.draft && !!p.data.results?.[0]))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)
  .map((c) => ({ ...c.data.results[0], client: c.data.title }));
---
<div class="w v2-proofs">
  {proofs.map((p) => <div><b data-count-to={p.value}>{p.value}</b><span>{p.label}</span><span class="v2-meta">{p.client}</span></div>)}
</div>

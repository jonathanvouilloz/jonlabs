---
// FAQ v2 (direction A) : questions en pilules, titre à droite. Une seule réponse ouverte à la fois (name partagé).
// `items` remplace la FAQ de la home (ex. /tarifs, qui garde sa propre FAQ pour le schéma FAQPage).
// `title` remplace le titre (HTML maison accepté, ex. un <br />). Le titre précède la liste dans le DOM, affiché à droite en desktop.
import { faqs } from '../../data/v2';
interface Props { items?: { q: string; a: string }[]; title?: string }
const { items = faqs, title = "Les questions<br />qu'on me pose." } = Astro.props;
---
<div class="w v2-faq">
  <h2 class="v2-h2 v2-faq-title" set:html={title} />
  <div class="v2-faq-list">
    {items.map((f) => (
      <details name="v2-faq">
        <summary><span>{f.q.replace(/ ([?!:;])/g, ' $1')}</span><i class="ri-add-line"></i></summary>
        <p class="v2-mut">{f.a}</p>
      </details>
    ))}
  </div>
</div>

<style>
  @media (min-width: 901px) { .v2-faq-title { order: 1; } }
</style>
